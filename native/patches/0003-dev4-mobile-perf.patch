+//! my-veloren dev.4 (4.3): classify a phone GPU by its driver name. Pure code,
+//! host-tested by `native/touch-tests` in the my-veloren repo.
+
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum GpuClass {
+    /// Snapdragon 865-class and older/unknown: mobile-low.
+    Baseline,
+    /// Adreno 730+ (Snapdragon 8 Gen 1+), Mali-G710+, Immortalis, Xclipse: mobile-medium.
+    Strong,
+}
+
+fn number_after(n: &str, prefix: &str) -> Option<u32> {
+    let i = n.find(prefix)? + prefix.len();
+    let digits: String = n[i..]
+        .chars()
+        .skip_while(|c| !c.is_ascii_digit())
+        .take_while(|c| c.is_ascii_digit())
+        .collect();
+    digits.parse().ok()
+}
+
+pub fn class(name: &str) -> GpuClass {
+    let n = name.to_ascii_lowercase();
+    let strong = if let Some(a) = number_after(&n, "adreno") {
+        a >= 730
+    } else if n.contains("immortalis") || n.contains("xclipse") {
+        true
+    } else if let Some(m) = number_after(&n, "mali-g") {
+        m >= 710
+    } else {
+        false
+    };
+    if strong { GpuClass::Strong } else { GpuClass::Baseline }
+}
