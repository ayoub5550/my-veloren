+//! my-veloren dev.4: phone performance.
+//!
+//! * mobile graphics tiers (4.2) and an automatic choice by GPU on first launch (4.3),
+//! * a persistent Vulkan pipeline cache (4.5),
+//! * frame-time / per-thread CPU / memory / temperature measurement (4.1), logged as
+//!   `VEL-PERF` every 5 s and `VEL-BENCH` per benchmark window (Test Lab scenario 3).
+//!
+//! Everything here is pure data or Android-only; desktop builds only see
+//! `pipeline_cache()` returning `None`.
+
+use crate::settings::{Fps, GraphicsSettings};
+use std::sync::{Mutex, OnceLock};
+
+// ------------------------------------------------------------------ tiers ---
+
+#[derive(Copy, Clone, Debug, PartialEq, Eq)]
+pub enum Tier {
+    /// Upstream desktop defaults (the dev.2/dev.3 baseline).
+    Desktop,
+    Low,
+    Medium,
+    High,
+}
+
+impl Tier {
+    pub fn name(self) -> &'static str {
+        match self {
+            Tier::Desktop => "desktop",
+            Tier::Low => "mobile-low",
+            Tier::Medium => "mobile-medium",
+            Tier::High => "mobile-high",
+        }
+    }
+
+    pub fn parse(s: &str) -> Option<Self> {
+        Some(match s.trim() {
+            "desktop" => Tier::Desktop,
+            "mobile-low" | "low" => Tier::Low,
+            "mobile-medium" | "medium" => Tier::Medium,
+            "mobile-high" | "high" => Tier::High,
+            _ => return None,
+        })
+    }
+
+    /// Graphics settings for this tier. Window/fullscreen/gamma etc. are kept.
+    pub fn apply(self, g: GraphicsSettings) -> GraphicsSettings {
+        use crate::render::*;
+        let keep = |d: GraphicsSettings, g: &GraphicsSettings| GraphicsSettings {
+            window: g.window.clone(),
+            fullscreen: g.fullscreen.clone(),
+            gamma: g.gamma,
+            exposure: g.exposure,
+            ambiance: g.ambiance,
+            fov: g.fov,
+            ..d
+        };
+        match self {
+            Tier::Desktop => keep(GraphicsSettings::default(), &g),
+            Tier::Low => {
+                let base = g.into_minimal();
+                GraphicsSettings {
+                    terrain_view_distance: 6,
+                    entity_view_distance: 6,
+                    lod_distance: 60,
+                    lod_detail: 100,
+                    sprite_render_distance: 60,
+                    figure_lod_render_distance: 120,
+                    particles_chance: 0.15,
+                    max_fps: Fps::Max(60),
+                    max_background_fps: Fps::Max(10),
+                    render_mode: RenderMode {
+                        aa: AaMode::FxUpscale,
+                        cloud: CloudMode::Minimal,
+                        reflection: ReflectionMode::Low,
+                        fluid: FluidMode::Low,
+                        lighting: LightingMode::Lambertian,
+                        shadow: ShadowMode::None,
+                        rain_occlusion: ShadowMapMode { resolution: 0.25 },
+                        bloom: BloomMode::Off,
+                        point_glow: 0.0,
+                        upscale_mode: UpscaleMode { factor: 0.6 },
+                        present_mode: PresentMode::Fifo,
+                        ..base.render_mode
+                    },
+                    ..base
+                }
+            },
+            Tier::Medium => {
+                let base = g.into_low();
+                GraphicsSettings {
+                    terrain_view_distance: 8,
+                    entity_view_distance: 8,
+                    sprite_render_distance: 100,
+                    max_fps: Fps::Max(60),
+                    max_background_fps: Fps::Max(10),
+                    render_mode: RenderMode {
+                        cloud: CloudMode::Minimal,
+                        reflection: ReflectionMode::Low,
+                        upscale_mode: UpscaleMode { factor: 0.75 },
+                        present_mode: PresentMode::Fifo,
+                        ..base.render_mode
+                    },
+                    ..base
+                }
+            },
+            Tier::High => {
+                let base = g.into_low();
+                GraphicsSettings {
+                    terrain_view_distance: 10,
+                    entity_view_distance: 10,
+                    lod_distance: 120,
+                    lod_detail: 200,
+                    sprite_render_distance: 150,
+                    max_fps: Fps::Max(60),
+                    max_background_fps: Fps::Max(10),
+                    render_mode: RenderMode {
+                        cloud: CloudMode::Low,
+                        reflection: ReflectionMode::Medium,
+                        fluid: FluidMode::Medium,
+                        lighting: LightingMode::BlinnPhong,
+                        shadow: ShadowMode::Map(ShadowMapMode { resolution: 0.5 }),
+                        upscale_mode: UpscaleMode { factor: 0.85 },
+                        present_mode: PresentMode::Fifo,
+                        ..base.render_mode
+                    },
+                    ..base
+                }
+            },
+        }
+    }
+}
+
+/// Plain fns for the settings window preset buttons (Low / Medium / High on Android).
+pub fn into_mobile_low(g: GraphicsSettings) -> GraphicsSettings { Tier::Low.apply(g) }
+pub fn into_mobile_medium(g: GraphicsSettings) -> GraphicsSettings { Tier::Medium.apply(g) }
+pub fn into_mobile_high(g: GraphicsSettings) -> GraphicsSettings { Tier::High.apply(g) }
+
+/// First-launch tier for a GPU (4.3), see `mobile_gpu.rs`.
+pub fn tier_for_gpu(name: &str) -> Tier {
+    match crate::mobile_gpu::class(name) {
+        crate::mobile_gpu::GpuClass::Strong => Tier::Medium,
+        crate::mobile_gpu::GpuClass::Baseline => Tier::Low,
+    }
+}
+
+static GPU_NAME: OnceLock<String> = OnceLock::new();
+
+pub fn set_gpu_name(name: &str) { let _ = GPU_NAME.set(name.to_owned()); }
+
+pub fn gpu_name() -> &'static str { GPU_NAME.get().map(|s| s.as_str()).unwrap_or("?") }
+
+// --------------------------------------------------------- pipeline cache ---
+
+static PIPELINE_CACHE: OnceLock<(wgpu::PipelineCache, std::path::PathBuf)> = OnceLock::new();
+
+/// The shared pipeline cache, if the device supports it (Vulkan on Android).
+pub fn pipeline_cache() -> Option<&'static wgpu::PipelineCache> {
+    PIPELINE_CACHE.get().map(|(c, _)| c)
+}
+
+/// Feature to request on the device when available.
+pub fn wanted_features(adapter: &wgpu::Adapter) -> wgpu::Features {
+    if cfg!(target_os = "android") {
+        adapter.features() & wgpu::Features::PIPELINE_CACHE
+    } else {
+        wgpu::Features::empty()
+    }
+}
+
+/// Create the cache from the file saved by a previous launch (4.5).
+#[allow(unsafe_code)]
+pub fn init_pipeline_cache(device: &wgpu::Device, info: &wgpu::AdapterInfo) {
+    if !cfg!(target_os = "android") || !device.features().contains(wgpu::Features::PIPELINE_CACHE) {
+        tracing::info!("pipeline cache: not supported on this device");
+        return;
+    }
+    let Some(dir) = std::env::var_os("XDG_CACHE_HOME").map(std::path::PathBuf::from) else {
+        return;
+    };
+    let key = wgpu::util::pipeline_cache_key(info).unwrap_or_else(|| "pipeline_cache".into());
+    let path = dir.join(format!("{key}.bin"));
+    let data = std::fs::read(&path).ok();
+    let loaded = data.as_ref().map(|d| d.len()).unwrap_or(0);
+    // SAFETY: the data was produced by `PipelineCache::get_data` for the same
+    // adapter (the file name is the wgpu adapter key); `fallback: true` makes
+    // wgpu start empty if the driver rejects it.
+    let cache = unsafe {
+        device.create_pipeline_cache(&wgpu::PipelineCacheDescriptor {
+            label: Some("my-veloren pipeline cache"),
+            data: data.as_deref(),
+            fallback: true,
+        })
+    };
+    tracing::info!("pipeline cache: {} loaded={loaded} bytes", path.display());
+    let _ = PIPELINE_CACHE.set((cache, path));
+}
+
+/// Write the cache to disk (called once all pipelines exist).
+pub fn save_pipeline_cache() {
+    let Some((cache, path)) = PIPELINE_CACHE.get() else { return };
+    if let Some(data) = cache.get_data() {
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        let tmp = path.with_extension("tmp");
+        match std::fs::write(&tmp, &data).and_then(|_| std::fs::rename(&tmp, path)) {
+            Ok(()) => tracing::info!("pipeline cache: saved {} bytes", data.len()),
+            Err(e) => tracing::warn!("pipeline cache: save failed: {e}"),
+        }
+    }
+}
+
+// ------------------------------------------------------------ frame times ---
+
+#[derive(Default, Clone)]
+struct Acc {
+    frames: u32,
+    /// wall-clock seconds between consecutive `frame_done` calls (the real
+    /// frame time; the parts below do not cover everything the loop does)
+    wall: f64,
+    tick: f64,
+    acquire: f64,
+    record: f64,
+    sleep: f64,
+    /// `GlobalState::maintain` (audio + renderer maintenance)
+    maintain: f64,
+    /// Android touch/autopilot hook (`android::frame`)
+    hook: f64,
+    /// time spent inside the winit event-loop callback (all events)
+    in_cb: f64,
+    /// per-frame wall time (ms), only for benchmark windows
+    times: Vec<f32>,
+}
+
+impl Acc {
+    fn add(&mut self, wall: f64, f: [f64; 4], x: [f64; 3], keep: bool) {
+        self.frames += 1;
+        self.wall += wall;
+        self.tick += f[0];
+        self.acquire += f[1];
+        self.record += f[2];
+        self.sleep += f[3];
+        self.maintain += x[0];
+        self.hook += x[1];
+        self.in_cb += x[2];
+        if keep {
+            self.times.push((wall * 1000.0) as f32);
+        }
+    }
+
+    fn ms(&self, v: f64) -> f64 { if self.frames == 0 { 0.0 } else { v * 1000.0 / self.frames as f64 } }
+
+    fn summary(&self) -> String {
+        let parts = self.tick + self.acquire + self.record + self.sleep + self.maintain + self.hook;
+        format!(
+            "fps={:.1} frame={:.1}ms tick={:.1}ms acquire={:.1}ms record={:.1}ms sleep={:.1}ms \
+             maintain={:.1}ms hook={:.1}ms cb_other={:.1}ms winit={:.1}ms",
+            if self.wall > 0.0 { self.frames as f64 / self.wall } else { 0.0 },
+            self.ms(self.wall),
+            self.ms(self.tick),
+            self.ms(self.acquire),
+            self.ms(self.record),
+            self.ms(self.sleep),
+            self.ms(self.maintain),
+            self.ms(self.hook),
+            self.ms((self.in_cb - parts).max(0.0)),
+            self.ms((self.wall - self.in_cb).max(0.0)),
+        )
+    }
+}
+
+static WINDOW: Mutex<Option<Acc>> = Mutex::new(None);
+static BENCH: Mutex<Option<Acc>> = Mutex::new(None);
+
+/// Main-thread timing state between two `frame_done` calls.
+struct Clock {
+    last: Option<std::time::Instant>,
+    /// maintain, hook, in-callback
+    extra: [f64; 3],
+}
+static CLOCK: Mutex<Clock> = Mutex::new(Clock { last: None, extra: [0.0; 3] });
+
+/// Seconds spent in `GlobalState::maintain` (called from the main loop).
+pub fn add_maintain(s: f64) { CLOCK.lock().unwrap().extra[0] += s; }
+/// Seconds spent in the Android touch/autopilot hook.
+pub fn add_hook(s: f64) { CLOCK.lock().unwrap().extra[1] += s; }
+/// Seconds spent inside one winit event-loop callback invocation.
+pub fn add_callback(s: f64) { CLOCK.lock().unwrap().extra[2] += s; }
+
+/// Called by the main loop once per rendered frame with the seconds spent in
+/// state tick, swapchain acquire (blocks when GPU bound), command recording +
+/// submit/present, and the FPS-cap sleep. FPS is computed from the wall clock
+/// between calls, so time spent anywhere else is still counted.
+pub fn frame_done(tick: f64, acquire: f64, record: f64, sleep: f64) {
+    let now = std::time::Instant::now();
+    let (wall, extra) = {
+        let mut c = CLOCK.lock().unwrap();
+        let wall = c.last.map(|l| now.duration_since(l).as_secs_f64());
+        c.last = Some(now);
+        (wall, std::mem::take(&mut c.extra))
+    };
+    // first frame (or after a long gap such as a pause): no meaningful wall time
+    let Some(wall) = wall.filter(|w| *w < 10.0) else { return };
+    let f = [tick, acquire, record, sleep];
+    WINDOW.lock().unwrap().get_or_insert_with(Acc::default).add(wall, f, extra, false);
+    if let Some(b) = BENCH.lock().unwrap().as_mut() {
+        b.add(wall, f, extra, true);
+    }
+}
+
+/// Take the 5 s window summary (for `VEL-PERF`).
+pub fn take_window() -> String {
+    let a = WINDOW.lock().unwrap().take().unwrap_or_default();
+    a.summary()
+}
+
+pub fn bench_begin() { *BENCH.lock().unwrap() = Some(Acc::default()); }
+
+/// End a benchmark window: summary + frame-time percentiles (wall clock).
+pub fn bench_end() -> String {
+    let Some(mut a) = BENCH.lock().unwrap().take() else { return "no data".into() };
+    a.times.sort_by(|x, y| x.partial_cmp(y).unwrap_or(std::cmp::Ordering::Equal));
+    let pct = |p: f32| -> f32 {
+        if a.times.is_empty() {
+            0.0
+        } else {
+            a.times[((a.times.len() - 1) as f32 * p) as usize]
+        }
+    };
+    format!(
+        "{} frames={} secs={:.1} p50={:.1}ms p95={:.1}ms p99={:.1}ms",
+        a.summary(),
+        a.frames,
+        a.wall,
+        pct(0.5),
+        pct(0.95),
+        pct(0.99)
+    )
+}
+
+// ------------------------------------------------- pending graphics change ---
+
+/// Graphics settings the autopilot wants the session to apply (benchmark).
+static PENDING: Mutex<Option<GraphicsSettings>> = Mutex::new(None);
+
+pub fn request_graphics(g: GraphicsSettings) { *PENDING.lock().unwrap() = Some(g); }
+
+pub fn take_pending_graphics() -> Option<GraphicsSettings> { PENDING.lock().unwrap().take() }
+
+// ------------------------------------------------ system stats (Android) ---
+
+#[cfg(target_os = "android")]
+pub mod sys {
+    use std::collections::HashMap;
+    use std::sync::Mutex;
+
+    static LAST: Mutex<Option<(std::time::Instant, HashMap<u32, (String, u64)>)>> =
+        Mutex::new(None);
+
+    fn read_threads() -> HashMap<u32, (String, u64)> {
+        let mut m = HashMap::new();
+        let Ok(rd) = std::fs::read_dir("/proc/self/task") else { return m };
+        for e in rd.flatten() {
+            let Ok(tid) = e.file_name().to_string_lossy().parse::<u32>() else { continue };
+            let Ok(s) = std::fs::read_to_string(e.path().join("stat")) else { continue };
+            let (Some(a), Some(b)) = (s.find('('), s.rfind(')')) else { continue };
+            let comm = s[a + 1..b].to_owned();
+            let f: Vec<&str> = s[b + 1..].split_whitespace().collect();
+            // fields after ')' start at #3 (state); utime #14, stime #15
+            let (Some(u), Some(st)) = (f.get(11), f.get(12)) else { continue };
+            let ticks = u.parse::<u64>().unwrap_or(0) + st.parse::<u64>().unwrap_or(0);
+            m.insert(tid, (comm, ticks));
+        }
+        m
+    }
+
+    fn group(comm: &str) -> String {
+        let t = comm.trim_end_matches(|c: char| c.is_ascii_digit() || c == '-' || c == '_');
+        if t.is_empty() { comm.to_owned() } else { t.to_owned() }
+    }
+
+    /// CPU use per thread group since the last call, in % of one core, top 8,
+    /// plus the total over all threads.
+    pub fn cpu_by_thread() -> String {
+        let now = std::time::Instant::now();
+        let cur = read_threads();
+        let mut last = LAST.lock().unwrap();
+        let out = if let Some((t0, prev)) = last.as_ref() {
+            let secs = now.duration_since(*t0).as_secs_f64().max(0.001);
+            let mut by: HashMap<String, f64> = HashMap::new();
+            let mut total = 0.0;
+            for (tid, (comm, ticks)) in &cur {
+                let before = prev.get(tid).map(|p| p.1).unwrap_or(0);
+                // CLK_TCK is 100 on Android
+                let pct = ticks.saturating_sub(before) as f64 / 100.0 / secs * 100.0;
+                total += pct;
+                *by.entry(group(comm)).or_default() += pct;
+            }
+            let mut v: Vec<_> = by.into_iter().filter(|(_, p)| *p >= 1.0).collect();
+            v.sort_by(|a, b| b.1.partial_cmp(&a.1).unwrap_or(std::cmp::Ordering::Equal));
+            let top: Vec<String> = v.iter().take(8).map(|(n, p)| format!("{n}:{p:.0}")).collect();
+            format!("cpu_total={total:.0}% threads={} cpu=[{}]", cur.len(), top.join(","))
+        } else {
+            format!("cpu_total=? threads={}", cur.len())
+        };
+        *last = Some((now, cur));
+        out
+    }
+
+    pub fn rss_mb() -> f64 {
+        std::fs::read_to_string("/proc/self/status")
+            .ok()
+            .and_then(|s| {
+                s.lines()
+                    .find(|l| l.starts_with("VmRSS:"))
+                    .and_then(|l| l.split_whitespace().nth(1))
+                    .and_then(|kb| kb.parse::<f64>().ok())
+            })
+            .map(|kb| kb / 1024.0)
+            .unwrap_or(0.0)
+    }
+
+    /// Hottest readable thermal zone (°C); apps can often read these on Samsung.
+    pub fn max_temp() -> String {
+        let mut best: Option<(f64, String)> = None;
+        for i in 0..80 {
+            let base = format!("/sys/class/thermal/thermal_zone{i}");
+            let Ok(t) = std::fs::read_to_string(format!("{base}/temp")) else { continue };
+            let Ok(v) = t.trim().parse::<f64>() else { continue };
+            let c = if v > 1000.0 { v / 1000.0 } else { v };
+            if !(5.0..130.0).contains(&c) {
+                continue;
+            }
+            let ty = std::fs::read_to_string(format!("{base}/type")).unwrap_or_default();
+            if best.as_ref().is_none_or(|b| c > b.0) {
+                best = Some((c, ty.trim().to_owned()));
+            }
+        }
+        match best {
+            Some((c, ty)) => format!("{c:.1}C({ty})"),
+            None => "n/a".into(),
+        }
+    }
+}
+
+// ------------------------------------------------------ first launch (4.3) ---
+
+/// Marker in the config dir: `<version> <tier> <gpu>`. Bumping the version
+/// re-applies the automatic tier once (e.g. after better presets ship).
+pub const PRESET_VERSION: &str = "dev4-v1";
+
+/// Before the window exists: apply Low so the very first frames are cheap.
+/// Returns true if the automatic choice is still pending (needs the GPU name).
+pub fn first_launch(g: &mut GraphicsSettings, config_dir: &std::path::Path) -> bool {
+    let marker = std::fs::read_to_string(config_dir.join("mobile_preset")).unwrap_or_default();
+    if marker.split_whitespace().next() == Some(PRESET_VERSION) {
+        tracing::info!("mobile preset: keeping user settings ({})", marker.trim());
+        return false;
+    }
+    *g = Tier::Low.apply(g.clone());
+    true
+}
+
+/// After the renderer picked a GPU: choose the tier, return it if it differs from Low.
+pub fn choose_tier(config_dir: &std::path::Path) -> Tier {
+    let forced = std::fs::read_to_string(config_dir.join("force_tier"))
+        .ok()
+        .and_then(|s| Tier::parse(&s));
+    let tier = forced.unwrap_or_else(|| tier_for_gpu(gpu_name()));
+    let line = format!("{PRESET_VERSION} {} {}\n", tier.name(), gpu_name());
+    let _ = std::fs::write(config_dir.join("mobile_preset"), &line);
+    tracing::info!(
+        "mobile preset: gpu='{}' -> {}{}",
+        gpu_name(),
+        tier.name(),
+        if forced.is_some() { " (forced)" } else { "" }
+    );
+    tier
+}
