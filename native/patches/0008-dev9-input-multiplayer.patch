+
+static MP_HAS_ACCOUNT: AtomicBool = AtomicBool::new(false);
+
+/// dev.9 scenario 13: the test account comes from `mp_account.txt` (username,
+/// password, optional server; one per line), pushed by the test into the app's
+/// external files folder. Without it a non-existent account is used, which
+/// still proves the server and its auth server answer the phone build.
+pub fn mp_test_account() -> (String, String, String) {
+    let mut paths = Vec::new();
+    if let Some(p) = app().external_data_path() {
+        paths.push(p.join("mp_account.txt"));
+    }
+    paths.push(PathBuf::from("/sdcard/Android/data/com.ayoub.myveloren/files/mp_account.txt"));
+    paths.push(PathBuf::from("/data/local/tmp/mp_account.txt"));
+    for p in paths {
+        if let Ok(t) = std::fs::read_to_string(&p) {
+            let mut l = t.lines().map(str::trim);
+            if let (Some(u), Some(pw)) = (l.next(), l.next())
+                && !u.is_empty()
+                && !pw.is_empty()
+            {
+                let server = l.next().filter(|s| !s.is_empty()).unwrap_or("server.veloren.net");
+                ainfo!("mp: test account from {}", p.display());
+                MP_HAS_ACCOUNT.store(true, Ordering::SeqCst);
+                return (u.to_owned(), pw.to_owned(), server.to_owned());
+            }
+        }
+    }
+    ainfo!("mp: no test account file, using a non-existent account");
+    ("myveloren_no_account".into(), "not-a-password".into(), "server.veloren.net".into())
+}
+
+/// Scenario 12 fallback: a MotionEvent action + values -> the hook's mouse handler.
+fn synthetic_mouse(action: i32, x: f32, y: f32, buttons: i32, vscroll: f32) {
+    use crate::android_input::MouseAct as M;
+    let act = match action {
+        0 => M::Down,
+        1 | 11 | 12 => M::Buttons,
+        2 | 7 | 9 => M::Move,
+        3 => M::Cancel,
+        8 => M::Scroll,
+        _ => M::Other,
+    };
+    crate::android_input::mouse_values(act, x, y, buttons as u32, vscroll, 0.0, false);
+}
+
+/// dev.9 scenario 13: the login failed. Without an account the expected answer
+/// is the auth server rejecting the credentials (server + auth reached).
+pub fn mp_login_failed(err: &str) {
+    if !autostart_enabled() || scenario() != 13 {
+        return;
+    }
+    let has = MP_HAS_ACCOUNT.load(Ordering::SeqCst);
+    // PASS only when auth.veloren.net itself rejected the fake account (TLS and
+    // the auth round trip worked); a local error (e.g. no CA store) is a FAIL.
+    let rejected = !err.contains("CertificateLoad")
+        && (err.contains("AuthErr")
+            || err.contains("incorrect")
+            || err.contains("does not exist")
+            || err.contains("InvalidLogin")
+            || err.contains("ServerError(400")
+            || err.contains("ServerError(401")
+            || err.contains("ServerError(403"));
+    let detail: String = err.chars().take(300).collect();
+    if has {
+        alog_check("mp_login", false, &format!("login failed: {detail}"));
+    } else {
+        alog_check(
+            "mp_server_reachable",
+            rejected,
+            &format!("no test account; server + auth.veloren.net answered: {detail}"),
+        );
+    }
+    let ok = !has && rejected;
+    ainfo!(
+        "VEL-SCENARIO 13 DONE pass={} fail={} failed={:?} haptics=0",
+        ok as u32,
+        (!ok) as u32,
+        if ok { vec![] } else if has { vec!["mp_login"] } else { vec!["mp_server_reachable"] }
+    );
+    jni_send(JniCall::FinishLoop);
+    let _ = std::thread::Builder::new().spawn(|| {
+        std::thread::sleep(Duration::from_secs(3));
+        ainfo!("android: game loop scenario finished, exiting process");
+        unsafe { libc::_exit(0) };
+    });
+}
