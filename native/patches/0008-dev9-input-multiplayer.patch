+//! my-veloren dev.9: physical input on Android - gamepads, Bluetooth keyboards
+//! and mice.
+//!
+//! winit 0.30 maps every Android `MotionEvent` to a touch (so a mouse or a
+//! gamepad stick would press on-screen buttons) and has no gamepad support
+//! (gilrs has no Android backend). The vendored winit (`third_party/winit-0.30.13`,
+//! see my-veloren `native/tools/vendor_winit.sh`) calls [`hook`] for every
+//! input event first:
+//!
+//! * gamepad buttons (key events from a gamepad source) and joystick motion
+//!   become [`PadEvent`]s that `Window::fetch_events` feeds through the upstream
+//!   controller mapping (`ControllerSettings`, the same defaults as desktop);
+//! * mouse motion / buttons / wheel become winit cursor, button, wheel and
+//!   `DeviceEvent::MouseMotion` events (camera look while the game holds the
+//!   cursor; Android pointer capture keeps the pointer from hitting the edges);
+//! * keyboard keys are left to winit (upstream keyboard bindings), only the
+//!   letters of non-Latin layouts are mapped back to the physical key.
+//!
+//! While a physical device is in use the touch overlay is hidden; the next
+//! touch shows it again.
+
+use crate::{
+    settings::controller::{Axis, Button},
+    window::PadEvent,
+};
+use gilrs::{Axis as GilAxis, Button as GilButton};
+use std::sync::{
+    Mutex,
+    atomic::{AtomicBool, AtomicU64, Ordering},
+};
+use winit::{
+    event::{DeviceEvent, DeviceId, ElementState, Event, MouseButton, MouseScrollDelta, TouchPhase,
+        WindowEvent},
+    platform::android::activity::input::{Axis as AAxis, InputEvent, KeyAction, MotionAction},
+};
+
+/// Which kind of physical device was used last.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Kind {
+    Gamepad,
+    Keyboard,
+    Mouse,
+}
+
+#[derive(Clone, Copy, Debug)]
+enum MouseIn {
+    Abs(f32, f32),
+    Rel(f32, f32),
+    Button(MouseButton, bool, f32, f32),
+    Wheel(f32, f32, f32, f32),
+}
+
+#[derive(Default)]
+struct PadState {
+    /// pressed state per gamepad button (keys, hat and trigger axes combined)
+    pressed: Vec<GilButton>,
+    axes: [f32; 4],
+    hat: (i8, i8),
+    triggers: (bool, bool),
+    mouse_buttons: u32,
+}
+
+static PAD_Q: Mutex<Vec<PadEvent>> = Mutex::new(Vec::new());
+static MOUSE_Q: Mutex<Vec<MouseIn>> = Mutex::new(Vec::new());
+static STATE: Mutex<Option<PadState>> = Mutex::new(None);
+static LAST_KIND: Mutex<Option<Kind>> = Mutex::new(None);
+/// The game holds the cursor (no window open), updated every frame.
+static GRABBED: AtomicBool = AtomicBool::new(false);
+/// Back requested by the gamepad (B / Start while a menu or window is open).
+static BACK_REQ: AtomicBool = AtomicBool::new(false);
+static OVERLAY_HIDDEN: AtomicBool = AtomicBool::new(false);
+static CAPTURE: AtomicBool = AtomicBool::new(false);
+/// A mouse was used since the last touch.
+static MOUSE_ACTIVE: AtomicBool = AtomicBool::new(false);
+static MOUSE_LAST: Mutex<Option<(f32, f32)>> = Mutex::new(None);
+
+/// Counters for the Test Lab checks (scenario 12) and the logcat summary.
+pub static PAD_BUTTONS: AtomicU64 = AtomicU64::new(0);
+pub static PAD_AXES: AtomicU64 = AtomicU64::new(0);
+pub static MOUSE_EVENTS: AtomicU64 = AtomicU64::new(0);
+pub static KEYS: AtomicU64 = AtomicU64::new(0);
+pub static REMAPPED: AtomicU64 = AtomicU64::new(0);
+
+/// Install the winit input hook (once, before the event loop runs).
+pub fn install() {
+    if winit::platform::android::set_input_hook(hook) {
+        crate::android::alog(4, "input: gamepad/mouse hook installed");
+    }
+}
+
+/// The touch overlay is hidden because a gamepad, keyboard or mouse is in use.
+pub fn overlay_hidden() -> bool { OVERLAY_HIDDEN.load(Ordering::Relaxed) }
+
+pub fn last_kind() -> Option<Kind> { *LAST_KIND.lock().unwrap() }
+
+pub fn pointer_captured() -> bool { CAPTURE.load(Ordering::Relaxed) }
+
+fn note(kind: Kind) {
+    let mut k = LAST_KIND.lock().unwrap();
+    if *k != Some(kind) {
+        crate::android::alog(4, &format!("input: physical {kind:?} in use, touch overlay hidden"));
+    }
+    *k = Some(kind);
+    OVERLAY_HIDDEN.store(true, Ordering::Relaxed);
+}
+
+/// A finger touched the screen: show the touch overlay again.
+pub fn on_touch() {
+    MOUSE_ACTIVE.store(false, Ordering::Relaxed);
+    if OVERLAY_HIDDEN.swap(false, Ordering::Relaxed) {
+        crate::android::alog(4, "input: touch -> touch overlay shown");
+    }
+}
+
+/// A key event from a physical keyboard reached the game (called from
+/// `android::translate_touch`).
+pub fn on_keyboard() {
+    KEYS.fetch_add(1, Ordering::Relaxed);
+    note(Kind::Keyboard);
+}
+
+pub fn take_pad_events() -> Vec<PadEvent> { std::mem::take(&mut *PAD_Q.lock().unwrap()) }
+
+const SRC_GAMEPAD: u32 = 0x0000_0400;
+const SRC_JOYSTICK: u32 = 0x0100_0010;
+const SRC_MOUSE: u32 = 0x0000_2002;
+const SRC_MOUSE_RELATIVE: u32 = 0x0002_0004;
+const SRC_TOUCHPAD: u32 = 0x0010_0008;
+
+fn has(src: u32, bits: u32) -> bool { src & bits == bits }
+
+/// Android `KEYCODE_*` of a gamepad button -> gilrs button (Xbox layout names:
+/// A = South, B = East, X = West, Y = North).
+fn pad_button(code: u32) -> Option<GilButton> {
+    Some(match code {
+        96 => GilButton::South,
+        97 => GilButton::East,
+        98 => GilButton::C,
+        99 => GilButton::West,
+        100 => GilButton::North,
+        101 => GilButton::Z,
+        102 => GilButton::LeftTrigger,
+        103 => GilButton::RightTrigger,
+        104 => GilButton::LeftTrigger2,
+        105 => GilButton::RightTrigger2,
+        106 => GilButton::LeftThumb,
+        107 => GilButton::RightThumb,
+        108 => GilButton::Start,
+        109 => GilButton::Select,
+        110 => GilButton::Mode,
+        19 => GilButton::DPadUp,
+        20 => GilButton::DPadDown,
+        21 => GilButton::DPadLeft,
+        22 => GilButton::DPadRight,
+        _ => return None,
+    })
+}
+
+fn with_state<R>(f: impl FnOnce(&mut PadState) -> R) -> R {
+    let mut g = STATE.lock().unwrap();
+    f(g.get_or_insert_with(PadState::default))
+}
+
+/// Press / release a gamepad button once (keys, hat and trigger axes can
+/// report the same button).
+fn set_button(st: &mut PadState, b: GilButton, down: bool) {
+    let was = st.pressed.contains(&b);
+    if was == down {
+        return;
+    }
+    if down {
+        st.pressed.push(b);
+    } else {
+        st.pressed.retain(|x| *x != b);
+    }
+    PAD_BUTTONS.fetch_add(1, Ordering::Relaxed);
+    // Outside the game (menus, open windows) B and Start act as Back, like the
+    // phone's Back button (Escape: close the window / menu).
+    if down
+        && matches!(b, GilButton::East | GilButton::Start)
+        && !GRABBED.load(Ordering::Relaxed)
+    {
+        BACK_REQ.store(true, Ordering::SeqCst);
+        return;
+    }
+    PAD_Q.lock().unwrap().push(PadEvent::Button(Button::Simple(b), down));
+}
+
+fn hook(ev: &InputEvent<'_>) -> bool {
+    match ev {
+        InputEvent::KeyEvent(k) => {
+            let src: u32 = k.source().into();
+            let code: u32 = k.key_code().into();
+            let from_pad = has(src, SRC_GAMEPAD) || has(src, SRC_JOYSTICK);
+            let Some(b) = pad_button(code) else { return false };
+            // D-pad keys of a keyboard stay arrow keys.
+            if !from_pad && !(96..=110).contains(&code) {
+                return false;
+            }
+            let down = match k.action() {
+                KeyAction::Down => true,
+                KeyAction::Up => false,
+                _ => return true,
+            };
+            if down && k.repeat_count() > 0 {
+                return true;
+            }
+            note(Kind::Gamepad);
+            with_state(|st| set_button(st, b, down));
+            true
+        },
+        InputEvent::MotionEvent(m) => {
+            let src: u32 = m.source().into();
+            if has(src, SRC_JOYSTICK) {
+                joystick(m);
+                true
+            } else if has(src, SRC_MOUSE_RELATIVE) {
+                mouse(m, true);
+                true
+            } else if has(src, SRC_MOUSE) || has(src, SRC_TOUCHPAD) {
+                mouse(m, false);
+                true
+            } else {
+                false
+            }
+        },
+        _ => false,
+    }
+}
+
+fn joystick(m: &winit::platform::android::activity::input::MotionEvent<'_>) {
+    if m.pointer_count() == 0 {
+        return;
+    }
+    let p = m.pointer_at_index(0);
+    let v = |a: AAxis| p.axis_value(a);
+    let (lx, ly) = (v(AAxis::X), v(AAxis::Y));
+    let (mut rx, mut ry) = (v(AAxis::Z), v(AAxis::Rz));
+    // a few pads report the right stick on RX / RY instead of Z / RZ
+    let (ax, ay) = (v(AAxis::Rx), v(AAxis::Ry));
+    if rx.abs() < 1e-3 && ry.abs() < 1e-3 && (ax.abs() > 1e-3 || ay.abs() > 1e-3) {
+        (rx, ry) = (ax, ay);
+    }
+    let lt = v(AAxis::Ltrigger).max(v(AAxis::Brake));
+    let rt = v(AAxis::Rtrigger).max(v(AAxis::Gas));
+    let (hx, hy) = (v(AAxis::HatX), v(AAxis::HatY));
+    joystick_values([lx, ly, rx, ry, lt, rt, hx, hy]);
+}
+
+/// Test harness (scenario 12) fallback: Android 14 blocks an app from feeding
+/// motion events into its own input queue (hidden API), so the harness hands
+/// the same values to the same code that a real controller's events reach.
+pub static SYNTHETIC: AtomicBool = AtomicBool::new(false);
+
+/// lx, ly, rx, ry (Android axes: +Y down), lt, rt, hat x / y.
+pub fn joystick_values(a: [f32; 8]) {
+    let [lx, ly, rx, ry, lt, rt, hx, hy] = a;
+    note(Kind::Gamepad);
+    with_state(|st| {
+        // Android: +Y is down; gilrs / Veloren: +Y is up.
+        let now = [lx, -ly, rx, -ry];
+        let axes = [
+            GilAxis::LeftStickX,
+            GilAxis::LeftStickY,
+            GilAxis::RightStickX,
+            GilAxis::RightStickY,
+        ];
+        let mut q = PAD_Q.lock().unwrap();
+        for i in 0..4 {
+            if (now[i] - st.axes[i]).abs() > 0.002 || (now[i] == 0.0 && st.axes[i] != 0.0) {
+                st.axes[i] = now[i];
+                q.push(PadEvent::Axis(Axis::Simple(axes[i]), now[i]));
+                PAD_AXES.fetch_add(1, Ordering::Relaxed);
+            }
+        }
+        drop(q);
+        // analog triggers -> L2 / R2 buttons (hysteresis)
+        let l = if st.triggers.0 { lt > 0.3 } else { lt > 0.5 };
+        let r = if st.triggers.1 { rt > 0.3 } else { rt > 0.5 };
+        if l != st.triggers.0 {
+            st.triggers.0 = l;
+            set_button(st, GilButton::LeftTrigger2, l);
+        }
+        if r != st.triggers.1 {
+            st.triggers.1 = r;
+            set_button(st, GilButton::RightTrigger2, r);
+        }
+        // hat -> d-pad buttons
+        let hat = (
+            if hx < -0.5 { -1 } else if hx > 0.5 { 1 } else { 0 },
+            if hy < -0.5 { -1 } else if hy > 0.5 { 1 } else { 0 },
+        );
+        if hat != st.hat {
+            let old = st.hat;
+            st.hat = hat;
+            let pairs = [
+                (old.0 == -1, hat.0 == -1, GilButton::DPadLeft),
+                (old.0 == 1, hat.0 == 1, GilButton::DPadRight),
+                (old.1 == -1, hat.1 == -1, GilButton::DPadUp),
+                (old.1 == 1, hat.1 == 1, GilButton::DPadDown),
+            ];
+            for (was, is, b) in pairs {
+                if was != is {
+                    set_button(st, b, is);
+                }
+            }
+        }
+    });
+}
+
+/// A mouse event reduced to what the game needs (also built by the test harness).
+#[derive(Clone, Copy, Debug)]
+pub enum MouseAct {
+    Move,
+    Scroll,
+    /// MotionEvent ACTION_DOWN (a tap may carry no button state)
+    Down,
+    /// ACTION_UP / BUTTON_PRESS / BUTTON_RELEASE
+    Buttons,
+    Cancel,
+    Other,
+}
+
+fn mouse(m: &winit::platform::android::activity::input::MotionEvent<'_>, relative: bool) {
+    if m.pointer_count() == 0 {
+        return;
+    }
+    let p = m.pointer_at_index(0);
+    let act = match m.action() {
+        MotionAction::HoverMove | MotionAction::Move | MotionAction::HoverEnter => MouseAct::Move,
+        MotionAction::Scroll => MouseAct::Scroll,
+        MotionAction::Down => MouseAct::Down,
+        MotionAction::Up | MotionAction::ButtonPress | MotionAction::ButtonRelease => MouseAct::Buttons,
+        MotionAction::Cancel => MouseAct::Cancel,
+        _ => MouseAct::Other,
+    };
+    // captured pointer: x / y are deltas; add the older samples too
+    let (mut hx, mut hy) = (0.0, 0.0);
+    if relative && matches!(act, MouseAct::Move) {
+        for h in p.history() {
+            hx += h.axis_value(AAxis::X);
+            hy += h.axis_value(AAxis::Y);
+        }
+    }
+    mouse_values(
+        act,
+        p.x() + hx,
+        p.y() + hy,
+        m.button_state().0,
+        p.axis_value(AAxis::Vscroll),
+        p.axis_value(AAxis::Hscroll),
+        relative,
+    );
+}
+
+/// `x`, `y`: px (or deltas when `relative`), `buttons`: MotionEvent button state.
+pub fn mouse_values(act: MouseAct, x: f32, y: f32, buttons: u32, vscroll: f32, hscroll: f32, relative: bool) {
+    MOUSE_EVENTS.fetch_add(1, Ordering::Relaxed);
+    MOUSE_ACTIVE.store(true, Ordering::Relaxed);
+    note(Kind::Mouse);
+    let mut q = MOUSE_Q.lock().unwrap();
+    match act {
+        MouseAct::Move => {
+            if relative {
+                q.push(MouseIn::Rel(x, y));
+            } else {
+                q.push(MouseIn::Abs(x, y));
+            }
+        },
+        MouseAct::Scroll => q.push(MouseIn::Wheel(vscroll, hscroll, x, y)),
+        MouseAct::Down | MouseAct::Buttons | MouseAct::Cancel => {
+            let mut now = buttons & 0b111;
+            // a touchpad tap (or an injected event) may carry no button state
+            if now == 0 && matches!(act, MouseAct::Down) {
+                now = 1;
+            }
+            if matches!(act, MouseAct::Cancel) {
+                now = 0;
+            }
+            let old = with_state(|st| std::mem::replace(&mut st.mouse_buttons, now));
+            let (bx, by) = if relative {
+                MOUSE_LAST.lock().unwrap().unwrap_or((0.0, 0.0))
+            } else {
+                (x, y)
+            };
+            for (bit, b) in [(1, MouseButton::Left), (2, MouseButton::Right), (4, MouseButton::Middle)] {
+                if (old ^ now) & bit != 0 {
+                    q.push(MouseIn::Button(b, now & bit != 0, bx, by));
+                }
+            }
+        },
+        MouseAct::Other => {},
+    }
+}
+
+/// Once per frame (from `android::frame`): mouse events -> winit events,
+/// pointer capture, Back requests from the gamepad.
+pub fn frame(gs: &mut crate::GlobalState, out: &mut Vec<Event<()>>) {
+    let grabbed = gs.window.is_cursor_grabbed();
+    GRABBED.store(grabbed, Ordering::Relaxed);
+    if BACK_REQ.swap(false, Ordering::SeqCst) {
+        crate::android::alog(4, "input: gamepad B/Start -> Back");
+        crate::android::send_back();
+    }
+    let window_id = gs.window.window().id();
+    let device_id = DeviceId::dummy();
+    let moved = |x: f32, y: f32| Event::WindowEvent {
+        window_id,
+        event: WindowEvent::CursorMoved {
+            device_id,
+            position: winit::dpi::PhysicalPosition::new(x as f64, y as f64),
+        },
+    };
+    let events = std::mem::take(&mut *MOUSE_Q.lock().unwrap());
+    let mut last = MOUSE_LAST.lock().unwrap();
+    for e in events {
+        match e {
+            MouseIn::Abs(x, y) => {
+                if grabbed {
+                    if let Some((lx, ly)) = *last {
+                        out.push(Event::DeviceEvent {
+                            device_id,
+                            event: DeviceEvent::MouseMotion {
+                                delta: ((x - lx) as f64, (y - ly) as f64),
+                            },
+                        });
+                    }
+                } else {
+                    out.push(moved(x, y));
+                }
+                *last = Some((x, y));
+            },
+            MouseIn::Rel(dx, dy) => {
+                if grabbed {
+                    out.push(Event::DeviceEvent {
+                        device_id,
+                        event: DeviceEvent::MouseMotion {
+                            delta: (dx as f64, dy as f64),
+                        },
+                    });
+                } else {
+                    let size = gs.window.window().inner_size();
+                    let (lx, ly) = last.unwrap_or((size.width as f32 / 2.0, size.height as f32 / 2.0));
+                    let (x, y) = (
+                        (lx + dx).clamp(0.0, size.width as f32),
+                        (ly + dy).clamp(0.0, size.height as f32),
+                    );
+                    out.push(moved(x, y));
+                    *last = Some((x, y));
+                }
+            },
+            MouseIn::Button(button, down, x, y) => {
+                if !grabbed {
+                    out.push(moved(x, y));
+                }
+                out.push(Event::WindowEvent {
+                    window_id,
+                    event: WindowEvent::MouseInput {
+                        device_id,
+                        state: if down { ElementState::Pressed } else { ElementState::Released },
+                        button,
+                    },
+                });
+            },
+            MouseIn::Wheel(v, h, x, y) => {
+                if !grabbed {
+                    out.push(moved(x, y));
+                }
+                out.push(Event::WindowEvent {
+                    window_id,
+                    event: WindowEvent::MouseWheel {
+                        device_id,
+                        delta: MouseScrollDelta::LineDelta(h, v),
+                        phase: TouchPhase::Moved,
+                    },
+                });
+            },
+        }
+    }
+    drop(last);
+    // Pointer capture while the game holds the cursor and a mouse is in use:
+    // the pointer is hidden and reports relative motion (no screen edges).
+    let want = grabbed && MOUSE_ACTIVE.load(Ordering::Relaxed);
+    if want != CAPTURE.load(Ordering::Relaxed) {
+        CAPTURE.store(want, Ordering::Relaxed);
+        crate::android::pointer_capture(want);
+    }
+}
+
+/// Physical letter key -> US letter, for keyboards with a non-Latin layout
+/// (Arabic): upstream bindings use the logical key ("w"), which an Arabic
+/// layout reports as "ص".
+pub fn us_letter(code: winit::keyboard::KeyCode) -> Option<&'static str> {
+    use winit::keyboard::KeyCode as K;
+    Some(match code {
+        K::KeyA => "a", K::KeyB => "b", K::KeyC => "c", K::KeyD => "d", K::KeyE => "e",
+        K::KeyF => "f", K::KeyG => "g", K::KeyH => "h", K::KeyI => "i", K::KeyJ => "j",
+        K::KeyK => "k", K::KeyL => "l", K::KeyM => "m", K::KeyN => "n", K::KeyO => "o",
+        K::KeyP => "p", K::KeyQ => "q", K::KeyR => "r", K::KeyS => "s", K::KeyT => "t",
+        K::KeyU => "u", K::KeyV => "v", K::KeyW => "w", K::KeyX => "x", K::KeyY => "y",
+        K::KeyZ => "z",
+        _ => return None,
+    })
+}
