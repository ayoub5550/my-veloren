+/// Polled by the session: `Some(cooler settings, reason)` when the phone is
+/// hot and the last step is old enough.
+#[cfg(target_os = "android")]
+pub fn thermal_guard(g: &GraphicsSettings) -> Option<(GraphicsSettings, &'static str)> {
+    use std::time::{Duration, Instant};
+    struct St {
+        last_poll: Option<Instant>,
+        last_step: Option<Instant>,
+        hot_polls: u32,
+    }
+    static ST: Mutex<St> = Mutex::new(St {
+        last_poll: None,
+        last_step: None,
+        hot_polls: 0,
+    });
+    let mut st = ST.lock().unwrap_or_else(|e| e.into_inner());
+    let now = Instant::now();
+    if st.last_poll.is_some_and(|t| now - t < Duration::from_secs(5)) {
+        return None;
+    }
+    st.last_poll = Some(now);
+    let (status, headroom) = thermal::read()?;
+    // MODERATE (2) or worse, or the 10 s forecast says throttling is near.
+    let hot = status >= 2 || headroom.is_some_and(|h| h >= 0.95);
+    st.hot_polls = if hot { st.hot_polls + 1 } else { 0 };
+    if st.hot_polls < 2 || st.last_step.is_some_and(|t| now - t < Duration::from_secs(45)) {
+        return None;
+    }
+    let r = cool_down(g)?;
+    st.last_step = Some(now);
+    st.hot_polls = 0;
+    tracing::warn!(
+        "VEL-THERMAL status={status} headroom={headroom:?} step={} vd={}",
+        r.1,
+        r.0.terrain_view_distance
+    );
