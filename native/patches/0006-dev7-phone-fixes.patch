diff --git a/voxygen/src/hud/settings_window/touch_controls.rs b/voxygen/src/hud/settings_window/touch_controls.rs
new file mode 100644
index 000000000..6ff12bef1
--- /dev/null
+++ b/voxygen/src/hud/settings_window/touch_controls.rs
@@ -0,0 +1,242 @@
+//! my-veloren dev.7 (7.6): the "Controls" tab on a phone. Only what the
+//! player actually touches: the on-screen buttons and the stick. Keyboard,
+//! mouse and gamepad bindings are not shown on Android.
+use super::{RESET_BUTTONS_HEIGHT, RESET_BUTTONS_WIDTH};
+
+use crate::{
+    GlobalState,
+    hud::{TEXT_COLOR, img_ids::Imgs},
+    session::settings_change::Touch as TouchChange,
+    ui::{ImageSlider, ToggleButton, fonts::Fonts},
+};
+use conrod_core::{
+    Colorable, Labelable, Positionable, Sizeable, Widget, WidgetCommon, color,
+    position::Relative,
+    widget::{self, Button, Rectangle, Scrollbar, Text},
+    widget_ids,
+};
+use i18n::Localization;
+
+widget_ids! {
+    struct Ids {
+        window,
+        window_scrollbar,
+        intro,
+        sliders[],
+        slider_labels[],
+        slider_values[],
+        toggles[],
+        toggle_labels[],
+        edit_button,
+        reset_button,
+    }
+}
+
+#[derive(WidgetCommon)]
+pub struct TouchControls<'a> {
+    global_state: &'a GlobalState,
+    imgs: &'a Imgs,
+    fonts: &'a Fonts,
+    localized_strings: &'a Localization,
+    #[conrod(common_builder)]
+    common: widget::CommonBuilder,
+}
+
+impl<'a> TouchControls<'a> {
+    pub fn new(
+        global_state: &'a GlobalState,
+        imgs: &'a Imgs,
+        fonts: &'a Fonts,
+        localized_strings: &'a Localization,
+    ) -> Self {
+        Self {
+            global_state,
+            imgs,
+            fonts,
+            localized_strings,
+            common: widget::CommonBuilder::default(),
+        }
+    }
+}
+
+pub struct State {
+    ids: Ids,
+}
+
+/// (i18n key, value, min, max, shown as percent, change)
+type SliderRow = (&'static str, f32, f32, f32, bool, fn(f32) -> TouchChange);
+
+impl Widget for TouchControls<'_> {
+    type Event = Vec<TouchChange>;
+    type State = State;
+    type Style = ();
+
+    fn init_state(&self, id_gen: widget::id::Generator) -> Self::State {
+        State {
+            ids: Ids::new(id_gen),
+        }
+    }
+
+    fn style(&self) -> Self::Style {}
+
+    fn update(self, args: widget::UpdateArgs<Self>) -> Self::Event {
+        let widget::UpdateArgs { state, ui, .. } = args;
+        let mut events = Vec::new();
+        let t = &self.global_state.settings.touch;
+        let i18n = self.localized_strings;
+
+        Rectangle::fill_with(args.rect.dim(), color::TRANSPARENT)
+            .xy(args.rect.xy())
+            .graphics_for(args.id)
+            .scroll_kids()
+            .scroll_kids_vertically()
+            .set(state.ids.window, ui);
+        Scrollbar::y_axis(state.ids.window)
+            .thickness(5.0)
+            .rgba(0.33, 0.33, 0.33, 1.0)
+            .set(state.ids.window_scrollbar, ui);
+
+        Text::new(&i18n.get_msg("hud-settings-touch-intro"))
+            .top_left_with_margins_on(state.ids.window, 10.0, 10.0)
+            .w(560.0)
+            .font_size(self.fonts.cyri.scale(14))
+            .font_id(self.fonts.cyri.conrod_id)
+            .color(TEXT_COLOR)
+            .set(state.ids.intro, ui);
+
+        // Big, finger-friendly buttons first: what people come here for.
+        fn big<'b>(
+            b: Button<'b, widget::button::Image>,
+            imgs: &Imgs,
+            fonts: &Fonts,
+        ) -> Button<'b, widget::button::Image> {
+            b.w_h(RESET_BUTTONS_WIDTH * 1.6, RESET_BUTTONS_HEIGHT * 1.5)
+                .hover_image(imgs.button_hover)
+                .press_image(imgs.button_press)
+                .label_font_size(fonts.cyri.scale(16))
+                .label_color(TEXT_COLOR)
+                .label_font_id(fonts.cyri.conrod_id)
+                .label_y(Relative::Scalar(2.0))
+        }
+        let edit_label = i18n.get_msg("hud-settings-touch-edit_layout");
+        let reset_label = i18n.get_msg("hud-settings-touch-reset");
+        if big(Button::image(self.imgs.button), self.imgs, self.fonts)
+            .down_from(state.ids.intro, 16.0)
+            .label(&edit_label)
+            .set(state.ids.edit_button, ui)
+            .was_clicked()
+        {
+            events.push(TouchChange::EditLayout);
+        }
+        if big(Button::image(self.imgs.button), self.imgs, self.fonts)
+            .right_from(state.ids.edit_button, 16.0)
+            .label(&reset_label)
+            .set(state.ids.reset_button, ui)
+            .was_clicked()
+        {
+            events.push(TouchChange::Reset);
+        }
+
+        let rows: [SliderRow; 7] = [
+            ("hud-settings-touch-opacity", t.opacity, 0.2, 1.0, true, TouchChange::Opacity),
+            ("hud-settings-touch-button_size", t.button_scale, 0.7, 1.4, true, TouchChange::ButtonScale),
+            ("hud-settings-touch-stick_size", t.stick_radius, 0.10, 0.22, false, TouchChange::StickRadius),
+            ("hud-settings-touch-stick_deadzone", t.stick_deadzone, 0.0, 0.3, true, TouchChange::StickDeadzone),
+            ("hud-settings-touch-camera_sensitivity", t.camera_sensitivity, 0.3, 3.0, true, TouchChange::CameraSensitivity),
+            ("hud-settings-touch-camera_smoothing", t.camera_smoothing, 0.0, 0.8, true, TouchChange::CameraSmoothing),
+            ("hud-settings-touch-zoom_sensitivity", t.zoom_sensitivity, 0.3, 3.0, true, TouchChange::ZoomSensitivity),
+        ];
+        let n = rows.len();
+        if state.ids.sliders.len() < n {
+            state.update(|s| {
+                let g = &mut ui.widget_id_generator();
+                s.ids.sliders.resize(n, g);
+                s.ids.slider_labels.resize(n, g);
+                s.ids.slider_values.resize(n, g);
+            });
+        }
+        for (i, (key, value, min, max, pct, change)) in rows.into_iter().enumerate() {
+            let text = i18n.get_msg(key);
+            let label = Text::new(&text)
+                .font_size(self.fonts.cyri.scale(15))
+                .font_id(self.fonts.cyri.conrod_id)
+                .color(TEXT_COLOR);
+            if i == 0 {
+                label
+                    .down_from(state.ids.edit_button, 22.0)
+                    .x_align_to(state.ids.intro, conrod_core::position::Align::Start)
+            } else {
+                label.down_from(state.ids.sliders[i - 1], 14.0)
+            }
+            .set(state.ids.slider_labels[i], ui);
+            // Thick track + wide handle: easy to grab with a thumb.
+            if let Some(v) = ImageSlider::continuous(
+                value.clamp(min, max),
+                min,
+                max,
+                self.imgs.slider_indicator,
+                self.imgs.slider,
+            )
+            .w_h(560.0, 34.0)
+            .down_from(state.ids.slider_labels[i], 8.0)
+            .track_breadth(40.0)
+            .slider_length(22.0)
+            .pad_track((8.0, 8.0))
+            .set(state.ids.sliders[i], ui)
+            {
+                events.push(change(v));
+            }
+            let shown = if pct {
+                let rel = if key.ends_with("opacity") || key.ends_with("button_size") {
+                    value
+                } else {
+                    value / max
+                };
+                format!("{:.0}%", rel * 100.0)
+            } else {
+                format!("{:.0}%", value / 0.15 * 100.0)
+            };
+            Text::new(&shown)
+                .right_from(state.ids.sliders[i], 10.0)
+                .font_size(self.fonts.cyri.scale(15))
+                .font_id(self.fonts.cyri.conrod_id)
+                .color(TEXT_COLOR)
+                .set(state.ids.slider_values[i], ui);
+        }
+
+        let toggles: [(&str, bool, fn(bool) -> TouchChange); 2] = [
+            ("hud-settings-touch-stick_follow", t.stick_follow, TouchChange::StickFollow),
+            ("hud-settings-touch-vibration", t.haptics, TouchChange::Haptics),
+        ];
+        if state.ids.toggles.len() < toggles.len() {
+            state.update(|s| {
+                let g = &mut ui.widget_id_generator();
+                s.ids.toggles.resize(2, g);
+                s.ids.toggle_labels.resize(2, g);
+            });
+        }
+        for (i, (key, on, change)) in toggles.into_iter().enumerate() {
+            let b = ToggleButton::new(on, self.imgs.checkbox, self.imgs.checkbox_checked)
+                .w_h(30.0, 30.0)
+                .hover_images(self.imgs.checkbox_mo, self.imgs.checkbox_checked_mo)
+                .press_images(self.imgs.checkbox_press, self.imgs.checkbox_checked);
+            let b = if i == 0 {
+                b.down_from(state.ids.sliders[n - 1], 22.0)
+            } else {
+                b.down_from(state.ids.toggles[i - 1], 16.0)
+            };
+            if b.set(state.ids.toggles[i], ui) != on {
+                events.push(change(!on));
+            }
+            Text::new(&i18n.get_msg(key))
+                .right_from(state.ids.toggles[i], 12.0)
+                .font_size(self.fonts.cyri.scale(15))
+                .font_id(self.fonts.cyri.conrod_id)
+                .graphics_for(state.ids.toggles[i])
+                .color(TEXT_COLOR)
+                .set(state.ids.toggle_labels[i], ui);
+        }
+
+        events
+    }
+}
