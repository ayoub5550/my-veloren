+/// Android thermal status via the NDK (`AThermal_*`, API 30+), looked up at
+/// run time so the APK still starts on Android 8–10 (no thermal API there).
+#[cfg(target_os = "android")]
+#[allow(unsafe_code)]
+pub mod thermal {
+    use std::sync::OnceLock;
+    type Acquire = unsafe extern "C" fn() -> *mut core::ffi::c_void;
+    type Status = unsafe extern "C" fn(*mut core::ffi::c_void) -> i32;
+    type Headroom = unsafe extern "C" fn(*mut core::ffi::c_void, i32) -> f32;
+    struct Api {
+        mgr: usize,
+        status: Status,
+        headroom: Option<Headroom>,
+    }
+    static API: OnceLock<Option<Api>> = OnceLock::new();
+
+    fn api() -> Option<&'static Api> {
+        API.get_or_init(|| unsafe {
+            // SAFETY: plain dlopen/dlsym of documented NDK symbols; the
+            // function types match <android/thermal.h>.
+            let lib = libc::dlopen(c"libandroid.so".as_ptr(), libc::RTLD_NOW);
+            if lib.is_null() {
+                return None;
+            }
+            let acq = libc::dlsym(lib, c"AThermal_acquireManager".as_ptr());
+            let st = libc::dlsym(lib, c"AThermal_getCurrentThermalStatus".as_ptr());
+            if acq.is_null() || st.is_null() {
+                return None;
+            }
+            let acq: Acquire = std::mem::transmute(acq);
+            let mgr = acq();
+            if mgr.is_null() {
+                return None;
+            }
+            let hr = libc::dlsym(lib, c"AThermal_getThermalHeadroom".as_ptr());
+            Some(Api {
+                mgr: mgr as usize,
+                status: std::mem::transmute::<*mut libc::c_void, Status>(st),
+                headroom: (!hr.is_null())
+                    .then(|| std::mem::transmute::<*mut libc::c_void, Headroom>(hr)),
+            })
+        })
+        .as_ref()
+    }
+
+    /// (status 0 none .. 6 shutdown, headroom forecast in 10 s; 1.0 = throttling).
+    pub fn read() -> Option<(i32, Option<f32>)> {
+        let a = api()?;
+        // SAFETY: `mgr` came from AThermal_acquireManager and is never released.
+        unsafe {
+            let p = a.mgr as *mut core::ffi::c_void;
+            let s = (a.status)(p);
+            let h = a.headroom.map(|f| f(p, 10)).filter(|h| h.is_finite());
+            Some((s, h))
+        }
+    }
+}
