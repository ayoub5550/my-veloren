@@ -0,0 +1,207 @@
+//! my-veloren dev.8 (8.2 / 8.4): several singleplayer worlds on a phone.
+//!
+//! * Ready-made small worlds: maps generated on the build machine (seed + size
+//!   below, see `tools/pregen_worlds.sh` in my-veloren) and shipped as assets,
+//!   because generating a full 1024×1024-chunk world on a phone takes far too
+//!   long. Installing one only copies its map file into a new world folder.
+//! * Worlds generated on the phone are limited to small sizes.
+//! * Export / import of every world (map, characters, server data) as one tar
+//!   file (Android only; the Java side moves it to/from Downloads).
+
+use std::{
+    fs,
+    path::{Path, PathBuf},
+};
+
+use common::{assets::ASSETS_PATH, consts::DAY_LENGTH_DEFAULT, resources::MapKind};
+use server::GenOpts;
+use tracing::{error, info};
+
+use super::{SingleplayerWorld, SingleplayerWorlds};
+
+/// A map generated on the build machine and shipped with the game.
+pub struct Pregen {
+    /// asset specifier of the map (`assets/world/map/<name>.bin`)
+    pub asset: &'static str,
+    pub name: &'static str,
+    pub seed: u32,
+    pub x_lg: u32,
+    pub y_lg: u32,
+    pub map_kind: MapKind,
+}
+
+pub const PREGEN: [Pregen; 2] = [
+    // 128×128 chunks (4 km): 1 town, 2 gnarling fortifications, 1 sahagin dungeon
+    Pregen {
+        asset: "world.map.my_veloren_small_7",
+        name: "Small land",
+        seed: 1337,
+        x_lg: 7,
+        y_lg: 7,
+        map_kind: MapKind::Square,
+    },
+    // 256×256 chunks (8 km): 3 towns, cultist + vampire castle + gnarling
+    // dungeons, dwarven mine, jungle ruin, pirate hideout, troll caves
+    Pregen {
+        asset: "world.map.my_veloren_island_8",
+        name: "Island",
+        seed: 1337,
+        x_lg: 8,
+        y_lg: 8,
+        map_kind: MapKind::Circle,
+    },
+];
+
+/// Largest world (log2 of chunks per side) the phone build lets you generate.
+/// 8 = 256×256 chunks ≈ 8×8 km; the official world is 10 (1024×1024).
+pub const PHONE_MAX_LG: u32 = 8;
+
+/// Defaults for "Create custom" on a phone: small enough to generate there.
+pub fn phone_gen_opts() -> GenOpts {
+    GenOpts {
+        x_lg: 7,
+        y_lg: 7,
+        ..GenOpts::default()
+    }
+}
+
+pub fn pregen_map_path(p: &Pregen) -> PathBuf {
+    let mut s = p.asset.replace('.', "/");
+    s.push_str(".bin");
+    ASSETS_PATH.join(s)
+}
+
+impl SingleplayerWorlds {
+    pub fn worlds_folder(&self) -> &Path { &self.worlds_folder }
+
+    /// Add a world from a shipped ready-made map. Returns its index.
+    pub fn add_pregenerated(&mut self, idx: usize) -> Option<usize> {
+        let p = PREGEN.get(idx)?;
+        let src = pregen_map_path(p);
+        let folder_name = self.world_folder_name();
+        let path = self.worlds_folder.join(folder_name);
+        if let Err(e) = fs::create_dir_all(&path) {
+            error!("pregen world: cannot create folder: {e}");
+            return None;
+        }
+        let map_path = path.join("map.bin");
+        if let Err(e) = fs::copy(&src, &map_path) {
+            error!("pregen world: cannot copy {}: {e}", src.display());
+            let _ = fs::remove_dir_all(&path);
+            return None;
+        }
+        let world = SingleplayerWorld {
+            name: p.name.to_string(),
+            gen_opts: Some(GenOpts {
+                x_lg: p.x_lg,
+                y_lg: p.y_lg,
+                map_kind: p.map_kind,
+                ..GenOpts::default()
+            }),
+            day_length: DAY_LENGTH_DEFAULT,
+            seed: p.seed,
+            is_generated: true,
+            map_path,
+            path,
+        };
+        super::singleplayer_world::write_world_meta(&world);
+        info!("pregen world '{}' added", p.name);
+        self.worlds.push(world);
+        Some(self.worlds.len() - 1)
+    }
+
+    /// Re-read the worlds folder (after an import).
+    pub fn reload(&mut self) {
+        self.worlds = super::singleplayer_world::load_worlds(&self.worlds_folder);
+        self.current = None;
+    }
+}
+
+#[cfg(target_os = "android")]
+pub mod transfer {
+    //! Export / import of all singleplayer worlds as one `.tar`.
+    use super::*;
+    use std::io;
+
+    /// Folder for files handed to / received from Java.
+    pub fn exchange_dir(worlds_folder: &Path) -> PathBuf {
+        worlds_folder
+            .parent()
+            .unwrap_or(worlds_folder)
+            .join("exchange")
+    }
+
+    pub fn export_name() -> String {
+        format!("my-veloren-saves-{}.tar", chrono::Local::now().format("%Y%m%d-%H%M%S"))
+    }
+
+    /// Write every world folder into `<exchange>/<name>` and return the path.
+    pub fn export_all(worlds: &SingleplayerWorlds) -> io::Result<PathBuf> {
+        let dir = exchange_dir(&worlds.worlds_folder);
+        fs::create_dir_all(&dir)?;
+        // only keep the newest export around
+        if let Ok(rd) = fs::read_dir(&dir) {
+            for e in rd.flatten() {
+                if e.file_name().to_string_lossy().starts_with("my-veloren-saves-") {
+                    let _ = fs::remove_file(e.path());
+                }
+            }
+        }
+        let out = dir.join(export_name());
+        let f = fs::File::create(&out)?;
+        let mut b = tar::Builder::new(io::BufWriter::new(f));
+        b.follow_symlinks(false);
+        let mut n = 0;
+        for w in &worlds.worlds {
+            if let Some(name) = w.path.file_name() {
+                b.append_dir_all(Path::new("singleplayer_worlds").join(name), &w.path)?;
+                n += 1;
+            }
+        }
+        b.into_inner()?.into_inner().map_err(|e| e.into_error())?.sync_all()?;
+        info!("export: {n} worlds -> {}", out.display());
+        Ok(out)
+    }
+
+    /// Import worlds from a tar made by `export_all`. Existing worlds are never
+    /// overwritten: an imported world whose folder name exists gets a suffix.
+    /// Returns the number of worlds added.
+    pub fn import_tar(worlds: &mut SingleplayerWorlds, tar_path: &Path) -> Result<usize, String> {
+        let dir = exchange_dir(&worlds.worlds_folder);
+        let tmp = dir.join("import-tmp");
+        let _ = fs::remove_dir_all(&tmp);
+        fs::create_dir_all(&tmp).map_err(|e| e.to_string())?;
+        let f = fs::File::open(tar_path).map_err(|e| format!("open: {e}"))?;
+        let mut a = tar::Archive::new(io::BufReader::new(f));
+        // `unpack` refuses entries that would escape `tmp` (.. / absolute paths)
+        a.unpack(&tmp).map_err(|e| format!("not a saves file: {e}"))?;
+        let src_root = tmp.join("singleplayer_worlds");
+        let rd = fs::read_dir(&src_root).map_err(|_| "no singleplayer_worlds in the file".to_string())?;
+        let mut added = 0;
+        for e in rd.flatten() {
+            let p = e.path();
+            if !p.join("meta.ron").is_file() {
+                continue;
+            }
+            let base = e.file_name().to_string_lossy().to_string();
+            let mut name = base.clone();
+            let mut i = 1;
+            while worlds.worlds_folder.join(&name).exists() {
+                name = format!("{base}_import{i}");
+                i += 1;
+            }
+            let dst = worlds.worlds_folder.join(&name);
+            if fs::rename(&p, &dst).is_ok() {
+                added += 1;
+            }
+        }
+        let _ = fs::remove_dir_all(&tmp);
+        worlds.reload();
+        info!("import: {added} worlds from {}", tar_path.display());
+        if added == 0 {
+            Err("no world found in the file".into())
+        } else {
+            Ok(added)
+        }
+    }
+}
