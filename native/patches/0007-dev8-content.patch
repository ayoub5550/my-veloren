         initial: String,
         auto: Option<String>,
     },
+    /// dev.8 (8.4): copy a file to the public Downloads folder (MediaStore).
+    ExportFile { path: String, name: String },
+    /// dev.8 (8.4): open the system file picker for a saves file.
+    PickImport { dest: String },
+    /// dev.8: short on-screen message.
+    Toast(String),
+}
+
+// ---------------------------------------------------- save transfer (8.4) ---
+
+/// Results from Java: (op, text, ok). op 1 = export finished (text = where /
+/// error), op 2 = import file picked and copied (text = local path / error).
+static FILE_RESULTS: Mutex<Vec<(i32, String, bool)>> = Mutex::new(Vec::new());
+
+pub fn export_file(path: &std::path::Path, name: &str) {
+    ainfo!("files: export {} as {name}", path.display());
+    jni_send(JniCall::ExportFile { path: path.to_string_lossy().into_owned(), name: name.to_owned() });
+}
+
+pub fn pick_import(dest: &std::path::Path) {
+    ainfo!("files: pick an import file -> {}", dest.display());
+    jni_send(JniCall::PickImport { dest: dest.to_string_lossy().into_owned() });
+}
+
+pub fn toast(msg: &str) { jni_send(JniCall::Toast(msg.to_owned())); }
+
+pub fn take_file_result(op: i32) -> Option<(String, bool)> {
+    let mut r = FILE_RESULTS.lock().unwrap();
+    let i = r.iter().position(|x| x.0 == op)?;
+    let (_, t, ok) = r.remove(i);
+    Some((t, ok))
+}
+
+extern "system" fn native_file(
+    mut env: jni::JNIEnv,
+    _this: jni::objects::JObject,
+    op: jni::sys::jint,
+    text: jni::objects::JString,
+    ok: jni::sys::jboolean,
+) {
+    let s: String = if text.is_null() {
+        String::new()
+    } else {
+        env.get_string(&text).map(|j| j.into()).unwrap_or_default()
+    };
+    ainfo!("files: result op={op} ok={} {s}", ok != 0);
+    FILE_RESULTS.lock().unwrap().push((op, s, ok != 0));
 }
 
