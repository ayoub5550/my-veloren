+                Some((v, d)) => {
+                    let ang = v[0].atan2(v[1]);
+                    // closed loop: if the last drag made it worse, the drag
+                    // direction is the other way round on this build
+                    let mut fs = FACE_SIGN.lock().unwrap();
+                    if let Some(prev) = fs.0 {
+                        if ang.abs() > prev.abs() + 0.05 {
+                            fs.1 = -fs.1;
+                        }
+                    }
+                    fs.0 = if left == 0 { None } else { Some(ang) };
+                    let sign = fs.1;
+                    drop(fs);
+                    if ang.abs() < 0.3 || left == 0 {
+                        ainfo!("VEL-STEP face {tgt:?}: angle={ang:.2} dist={d:.1} (tries left {left})");
+                    } else {
+                        let dx = (sign * ang * 0.12).clamp(-0.3, 0.3);
+                        p.inject = vec![
+                            Act::Down(CAM_ID, 0.55, 0.22),
+                            Act::MoveTo(CAM_ID, 0.55 + dx, 0.22, 0.4),
+                            Act::Up(CAM_ID),
+                            Act::Wait(0.6),
+                            Act::Face(tgt, left - 1),
+                        ];
+                    }
+                },
+                None => ainfo!("VEL-STEP face {tgt:?}: no target"),
+            }
+            true
+        },
+        Act::AimMine(left, dir) => {
+            let p8 = crate::content_audit::probe8().unwrap_or_default();
+            if p8.mine_target || (left == 0 && dir < 0) {
+                ainfo!("VEL-STEP aim mine: target={} (dir {dir}, tries left {left})", p8.mine_target);
+            } else if left == 0 {
+                // looking down did not find it: sweep back up
+                p.inject = vec![Act::AimMine(20, -1)];
+            } else {
+                let dy = 0.05 * dir as f32;
+                p.inject = vec![
+                    Act::Down(CAM_ID, 0.55, 0.30),
+                    Act::MoveTo(CAM_ID, 0.55, 0.30 + dy, 0.4),
+                    Act::Up(CAM_ID),
+                    Act::Wait(0.6),
+                    Act::AimMine(left - 1, dir),
+                ];
+            }
+            true
+        },
         Act::Finish | Act::FinishKill => {
             let kill = matches!(act, Act::FinishKill);
             let pass = p.results.iter().filter(|r| r.1).count();
