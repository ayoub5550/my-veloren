+//! my-veloren dev.8: content audit on the phone (Test Lab game-loop scenario 10).
+//!
+//! The session publishes a second probe (`Probe8`) with what the world around the
+//! player contains (sites on the map, time of day, weather, hostile/wild/tamed
+//! creatures, ships, loot, riding state, mining target, inventory) and executes
+//! harness requests (server chat commands of the singleplayer admin, use an
+//! inventory item, dismount). The scripted steps and checks live in `android.rs`;
+//! the check logic is here so it stays readable.
+
+use std::{
+    collections::BTreeMap,
+    sync::{
+        Mutex,
+        atomic::{AtomicBool, Ordering},
+    },
+};
+
+use client::Client;
+use common::{
+    comp::{self, inventory::slot::Slot},
+    link::Is,
+    mounting::{Rider, VolumeRider},
+    vol::ReadVol,
+};
+use specs::{Join, WorldExt};
+use vek::*;
+
+/// Things the harness can point the stick / camera at.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tgt {
+    /// nearest living wild (or hostile) creature
+    Wild,
+    /// nearest creature owned by the player
+    Pet,
+    /// nearest ship or airship
+    Ship,
+}
+
+#[derive(Clone, Debug, Default)]
+pub struct Probe8 {
+    pub pos: [f32; 3],
+    /// map markers by kind (`Town`, `Gnarling`, `Cave`, ...) — the whole world map
+    pub sites: BTreeMap<String, usize>,
+    pub tod_hours: f32,
+    pub rain: f32,
+    pub cloud: f32,
+    /// alive hostiles within 160 m and the strongest one (max health, body)
+    pub hostiles: usize,
+    pub strongest: Option<(f32, String)>,
+    pub villagers: usize,
+    pub wild_near: usize,
+    /// creatures within 8 m: "body/alignment d=.. hp=cur/max" (diagnostics)
+    pub near_desc: Vec<String>,
+    pub pets: usize,
+    pub ships: usize,
+    pub airships: usize,
+    pub loot_near: usize,
+    pub riding: bool,
+    pub riding_volume: bool,
+    pub mine_target: bool,
+    pub pickaxe_equipped: bool,
+    /// (item definition id, amount) of every inventory stack
+    pub inv: Vec<(String, u32)>,
+    /// solid blocks above the head within 40 m (= under a roof / underground)
+    pub roofed: bool,
+    pub health_frac: f32,
+    /// target → (stick-space direction [right, forward], horizontal distance)
+    pub rel: Vec<(Tgt, [f32; 2], f32)>,
+    /// chat lines that came back from the server since the last `Mark`
+    pub last_server_msg: Option<String>,
+    /// world size in chunks (official world: 1024 × 1024)
+    pub world_chunks: [u16; 2],
+    pub wielding: bool,
+    /// contextual buttons the touch layer would show now
+    pub can_interact: bool,
+    pub can_mount: bool,
+    /// block at the feet (diagnostics for placed sprites)
+    pub feet_block: String,
+}
+
+impl Probe8 {
+    pub fn rel(&self, t: Tgt) -> Option<([f32; 2], f32)> {
+        self.rel.iter().find(|r| r.0 == t).map(|r| (r.1, r.2))
+    }
+
+    pub fn count_item(&self, needle: &str) -> u32 {
+        self.inv
+            .iter()
+            .filter(|(id, _)| id.to_lowercase().contains(needle))
+            .map(|(_, n)| *n)
+            .sum()
+    }
+
+    pub fn total_items(&self) -> u32 { self.inv.iter().map(|(_, n)| *n).sum() }
+}
+
+#[derive(Clone, Debug)]
+pub enum Req {
+    Cmd(String, Vec<String>),
+    /// use (equip / consume) the first inventory item whose id contains this
+    UseItem(String),
+    /// put the first inventory item whose id contains this in the active main hand
+    Equip(String),
+    Unmount,
+}
+
+static PROBE8: Mutex<Option<Probe8>> = Mutex::new(None);
+static BASE8: Mutex<Option<Probe8>> = Mutex::new(None);
+static REQS: Mutex<Vec<Req>> = Mutex::new(Vec::new());
+static MINE_TARGET: AtomicBool = AtomicBool::new(false);
+static SERVER_MSG: Mutex<Option<String>> = Mutex::new(None);
+/// strongest hostile seen in any dungeon visit: (max health, body, where)
+static STRONGEST: Mutex<Option<(f32, String, String)>> = Mutex::new(None);
+
+pub fn request(r: Req) { REQS.lock().unwrap().push(r); }
+
+pub fn probe8() -> Option<Probe8> { PROBE8.lock().unwrap().clone() }
+
+pub fn mark() {
+    *SERVER_MSG.lock().unwrap() = None;
+    *BASE8.lock().unwrap() = probe8();
+}
+
+pub fn base8() -> Probe8 { BASE8.lock().unwrap().clone().unwrap_or_default() }
+
+pub fn set_mine_target(on: bool) { MINE_TARGET.store(on, Ordering::Relaxed); }
+
+/// Server answers to commands (errors, info) arrive as chat; keep the last one
+/// so a failing check can say why.
+pub fn note_server_msg(s: &str) { *SERVER_MSG.lock().unwrap() = Some(s.chars().take(160).collect()); }
+
+pub fn note_strongest(place: &str) {
+    if let Some((hp, body)) = probe8().and_then(|p| p.strongest) {
+        let mut s = STRONGEST.lock().unwrap();
+        if s.as_ref().is_none_or(|(best, _, _)| hp > *best) {
+            *s = Some((hp, body, place.to_owned()));
+        }
+    }
+}
+
+pub fn strongest() -> Option<(f32, String, String)> { STRONGEST.lock().unwrap().clone() }
+
+fn body_name(b: &comp::Body) -> String {
+    let s = format!("{b:?}");
+    // `Humanoid(Body { species: Human, .. })` → keep it short for the log
+    s.split(['{', ',']).take(2).collect::<Vec<_>>().join("").chars().take(60).collect()
+}
+
+/// Called every session tick on Android: run pending requests, then refresh
+/// `Probe8`.
+pub fn session_tick(client: &mut Client, forward: Vec2<f32>, right: Vec2<f32>) {
+    let reqs = std::mem::take(&mut *REQS.lock().unwrap());
+    for r in reqs {
+        match r {
+            Req::Cmd(name, args) => {
+                crate::android::alog(4, &format!("VEL-STEP command /{name} {}", args.join(" ")));
+                client.send_command(name, args);
+            },
+            Req::UseItem(needle) => {
+                let slot = client.inventories().get(client.entity()).and_then(|inv| {
+                    inv.slots_with_id()
+                        .find(|(_, s)| {
+                            s.as_ref().is_some_and(|i| {
+                                format!("{:?}", i.item_definition_id())
+                                    .to_lowercase()
+                                    .contains(&needle)
+                            })
+                        })
+                        .map(|(id, _)| id)
+                });
+                crate::android::alog(4, &format!("VEL-STEP use item '{needle}' slot={slot:?}"));
+                if let Some(slot) = slot {
+                    client.use_slot(Slot::Inventory(slot));
+                }
+            },
+            Req::Equip(needle) => {
+                let slot = client.inventories().get(client.entity()).and_then(|inv| {
+                    inv.slots_with_id()
+                        .find(|(_, s)| {
+                            s.as_ref().is_some_and(|i| {
+                                format!("{:?}", i.item_definition_id())
+                                    .to_lowercase()
+                                    .contains(&needle)
+                            })
+                        })
+                        .map(|(id, _)| id)
+                });
+                crate::android::alog(4, &format!("VEL-STEP equip '{needle}' slot={slot:?}"));
+                if let Some(slot) = slot {
+                    client.swap_slots(
+                        Slot::Inventory(slot),
+                        Slot::Equip(comp::inventory::slot::EquipSlot::ActiveMainhand),
+                    );
+                }
+            },
+            Req::Unmount => client.unmount(),
+        }
+    }
+
+    let me = client.entity();
+    let my_uid = client.uid();
+    let weather = client.weather_at_player();
+    let tod = client.state().get_time_of_day();
+    let sites = client.sites().values().fold(BTreeMap::new(), |mut m, s| {
+        *m.entry(format!("{:?}", s.marker.kind)).or_insert(0usize) += 1;
+        m
+    });
+    let ecs = client.state().ecs();
+    let positions = ecs.read_storage::<comp::Pos>();
+    let alignments = ecs.read_storage::<comp::Alignment>();
+    let bodies = ecs.read_storage::<comp::Body>();
+    let healths = ecs.read_storage::<comp::Health>();
+    let pickups = ecs.read_storage::<comp::PickupItem>();
+    let riders = ecs.read_storage::<Is<Rider>>();
+    let vriders = ecs.read_storage::<Is<VolumeRider>>();
+    let inventories = ecs.read_storage::<comp::Inventory>();
+    let my_pos = positions.get(me).map(|p| p.0).unwrap_or_default();
+    let alive = |e| !healths.get(e).is_some_and(|h: &comp::Health| h.is_dead);
+
+    let mut p = Probe8 {
+        pos: my_pos.into_array(),
+        sites,
+        tod_hours: ((tod.rem_euclid(86400.0)) / 3600.0) as f32,
+        rain: weather.rain,
+        cloud: weather.cloud,
+        mine_target: MINE_TARGET.load(Ordering::Relaxed),
+        riding: riders.get(me).is_some(),
+        riding_volume: vriders.get(me).is_some(),
+        health_frac: healths.get(me).map_or(0.0, |h| h.fraction()),
+        last_server_msg: SERVER_MSG.lock().unwrap().clone(),
+        world_chunks: client.world_data().chunk_size().into_array(),
+        wielding: client.is_wielding() == Some(true),
+        can_interact: crate::touch::context().can_interact,
+        can_mount: crate::touch::context().can_mount,
+        ..Default::default()
+    };
+    let mut nearest: BTreeMap<u8, (f32, Vec2<f32>)> = BTreeMap::new();
+    let mut consider = |k: u8, d: Vec2<f32>| {
+        let m = d.magnitude();
+        if nearest.get(&k).is_none_or(|(best, _)| m < *best) {
+            nearest.insert(k, (m, d));
+        }
+    };
+    for (e, pos, body) in (&ecs.entities(), &positions, &bodies).join() {
+        if e == me {
+            continue;
+        }
+        let d3 = pos.0 - my_pos;
+        let dist = d3.magnitude();
+        if let comp::Body::Ship(ship) = body {
+            if dist < 200.0 {
+                if matches!(ship, comp::ship::Body::DefaultAirship | comp::ship::Body::AirBalloon) {
+                    p.airships += 1;
+                } else {
+                    p.ships += 1;
+                }
+                consider(2, d3.xy());
+            }
+            continue;
+        }
+        if !alive(e) {
+            continue;
+        }
+        if dist < 8.0 && p.near_desc.len() < 6 {
+            let al = match alignments.get(e) {
+                Some(comp::Alignment::Wild) => "wild",
+                Some(comp::Alignment::Enemy) => "enemy",
+                Some(comp::Alignment::Npc) => "npc",
+                Some(comp::Alignment::Owned(_)) => "owned",
+                Some(_) => "other",
+                None => "none",
+            };
+            let hp = healths
+                .get(e)
+                .map_or("?".to_string(), |h| format!("{:.0}/{:.0}", h.current(), h.maximum()));
+            p.near_desc.push(format!("{}/{al} d={dist:.1} hp={hp}", body_name(body)));
+        }
+        match alignments.get(e) {
+            Some(comp::Alignment::Enemy) if dist < 160.0 => {
+                p.hostiles += 1;
+                if let Some(h) = healths.get(e) {
+                    let hp = h.maximum();
+                    if p.strongest.as_ref().is_none_or(|(best, _)| hp > *best) {
+                        p.strongest = Some((hp, body_name(body)));
+                    }
+                }
+            },
+            Some(comp::Alignment::Npc) if dist < 160.0 => {
+                if matches!(body, comp::Body::Humanoid(_)) {
+                    p.villagers += 1;
+                }
+            },
+            Some(comp::Alignment::Wild) => {
+                if dist < 40.0 {
+                    p.wild_near += 1;
+                    consider(0, d3.xy());
+                }
+            },
+            Some(comp::Alignment::Owned(uid)) if Some(*uid) == my_uid => {
+                p.pets += 1;
+                consider(1, d3.xy());
+            },
+            _ => {},
+        }
+    }
+    p.loot_near = (&positions, &pickups)
+        .join()
+        .filter(|(pos, _)| pos.0.distance(my_pos) < 25.0)
+        .count();
+    if let Some(inv) = inventories.get(me) {
+        p.inv = inv
+            .slots()
+            .flatten()
+            .map(|i| (format!("{:?}", i.item_definition_id()), i.amount()))
+            .collect();
+        p.pickaxe_equipped = inv
+            .equipped(comp::inventory::slot::EquipSlot::ActiveMainhand)
+            .is_some_and(|i| format!("{:?}", i.item_definition_id()).contains("pickaxe"));
+    }
+    {
+        let terrain = client.state().terrain();
+        let feet = my_pos.map(|e| e.floor() as i32);
+        p.feet_block = terrain.get(feet).map_or_else(
+            |_| "?".into(),
+            |b| format!("{:?}/{:?}", b.kind(), b.get_sprite()),
+        );
+        let head = feet + Vec3::unit_z() * 2;
+        p.roofed = (1..40).any(|dz| {
+            terrain
+                .get(head + Vec3::unit_z() * dz)
+                .is_ok_and(|b| b.is_solid())
+        });
+    }
+    for (k, (dist, d)) in nearest {
+        let n = d.try_normalized().unwrap_or_default();
+        let t = match k {
+            0 => Tgt::Wild,
+            1 => Tgt::Pet,
+            _ => Tgt::Ship,
+        };
+        p.rel.push((t, [n.dot(right), n.dot(forward)], dist));
+    }
+    *PROBE8.lock().unwrap() = Some(p);
+}
+
+/// Wait conditions for `Act::Until` (true = stop waiting).
+pub fn cond(name: &str, p: &Probe8, b: &Probe8) -> bool {
+    let moved = Vec3::<f32>::from(p.pos).distance(Vec3::<f32>::from(b.pos));
+    match name {
+        "night" => p.tod_hours >= 20.0 || p.tod_hours < 5.0,
+        "day" => (9.0..16.0).contains(&p.tod_hours),
+        "rain" => p.rain > 0.2,
+        "teleported" => moved > 60.0,
+        "villagers" => p.villagers >= 2,
+        "hostiles" => p.hostiles >= 1,
+        "pet" => p.pets > b.pets,
+        "wild" => p.wild_near > 0,
+        "riding" => p.riding || p.riding_volume,
+        "not_riding" => !p.riding && !p.riding_volume,
+        "ship" => p.ships > b.ships,
+        "airship" => p.airships > b.airships,
+        "pickaxe" => p.count_item("pickaxe") > 0 || p.pickaxe_equipped,
+        "equipped" => p.pickaxe_equipped,
+        "collar" => p.count_item("collar") > 0,
+        "items_up" => p.total_items() > b.total_items(),
+        "loot" => p.loot_near > b.loot_near || p.total_items() > b.total_items(),
+        "wild_gone" => p.wild_near < b.wild_near,
+        "wielding" => p.wielding,
+        "can_interact" => p.can_interact,
+        "can_mount" => p.can_mount,
+        "tamed_or_used" => p.pets > b.pets || p.count_item("collar") < b.count_item("collar"),
+        _ => true,
+    }
+}
+
+const DUNGEON_KINDS: [&str; 10] = [
+    "Gnarling",
+    "Adlet",
+    "Haniwa",
+    "Cultist",
+    "Sahagin",
+    "VampireCastle",
+    "Myrmidon",
+    "Terracotta",
+    "DwarvenMine",
+    "ChapelSite",
+];
+
+/// dev.8 checks (scenario 10). `None` = not a dev.8 check name.
+pub fn check(name: &str, p: &Probe8) -> Option<(bool, String)> {
+    let b = base8();
+    let moved = Vec3::<f32>::from(p.pos).distance(Vec3::<f32>::from(b.pos));
+    let why = || p.last_server_msg.clone().unwrap_or_default();
+    Some(match name {
+        "world_sites" => {
+            let towns = p.sites.get("Town").copied().unwrap_or(0);
+            let dungeons: usize = DUNGEON_KINDS.iter().filter_map(|k| p.sites.get(*k)).sum();
+            let caves = p.sites.get("Cave").copied().unwrap_or(0);
+            (
+                towns > 0 && dungeons > 0,
+                format!("towns={towns} dungeons={dungeons} caves={caves} all={:?}", p.sites),
+            )
+        },
+        "night" => (cond("night", p, &b), format!("hour={:.1}", p.tod_hours)),
+        "day" => (cond("day", p, &b), format!("hour={:.1}", p.tod_hours)),
+        "weather_rain" => (
+            p.rain > 0.2,
+            format!("rain={:.2} cloud={:.2} {}", p.rain, p.cloud, why()),
+        ),
+        "town" => (
+            moved > 60.0 && p.villagers >= 2,
+            format!("teleported {moved:.0} m to {:?}; villagers={} {}", p.pos.map(|v| v as i32), p.villagers, why()),
+        ),
+        "dungeon" => (
+            moved > 60.0 && p.hostiles >= 1,
+            format!(
+                "teleported {moved:.0} m to {:?}; hostiles={} strongest={:?} roofed={} {}",
+                p.pos.map(|v| v as i32),
+                p.hostiles,
+                p.strongest,
+                p.roofed,
+                why()
+            ),
+        ),
+        "cave" => (
+            moved > 60.0 && (p.roofed || p.hostiles > 0),
+            format!("teleported {moved:.0} m; roofed={} hostiles={} {}", p.roofed, p.hostiles, why()),
+        ),
+        "strong_enemy" => {
+            let s = strongest();
+            (
+                s.as_ref().is_some_and(|(hp, _, _)| *hp >= 400.0),
+                format!("strongest hostile seen in dungeons: {s:?} (boss-class >= 400 HP)"),
+            )
+        },
+        "farm_field" => (moved > 60.0, format!("teleported {moved:.0} m to a farm field {}", why())),
+        "harvest" => (
+            p.total_items() > b.total_items(),
+            format!(
+                "items {} -> {} can_interact(before)={} feet={} {}",
+                b.total_items(),
+                p.total_items(),
+                b.can_interact,
+                p.feet_block,
+                why()
+            ),
+        ),
+        "mining" => (
+            p.total_items() > b.total_items(),
+            format!(
+                "items {} -> {} pickaxe_equipped={} wielding={} mine_target(before)={} feet={} {}",
+                b.total_items(),
+                p.total_items(),
+                p.pickaxe_equipped,
+                p.wielding,
+                b.mine_target,
+                p.feet_block,
+                why()
+            ),
+        ),
+        "hunt" => (
+            p.wild_near < b.wild_near,
+            format!(
+                "animal killed: wild alive {} -> {}; loot near={} items {} -> {} \
+                 (a /spawn'ed animal has no loot table; natural animals drop loot) \
+                 near(before)={:?} near(now)={:?}",
+                b.wild_near,
+                p.wild_near,
+                p.loot_near,
+                b.total_items(),
+                p.total_items(),
+                b.near_desc,
+                p.near_desc
+            ),
+        ),
+        "tame" => (
+            p.pets > b.pets,
+            format!(
+                "pets {} -> {} collars {} -> {} near(before)={:?} {}",
+                b.pets,
+                p.pets,
+                b.count_item("collar"),
+                p.count_item("collar"),
+                b.near_desc,
+                why()
+            ),
+        ),
+        "ride" => (
+            p.riding,
+            format!(
+                "riding={} pet_dist={:?} can_mount(before)={} near={:?}",
+                p.riding,
+                p.rel(Tgt::Pet).map(|r| r.1),
+                b.can_mount,
+                p.near_desc
+            ),
+        ),
+        "ride_moves" => (
+            p.riding && moved > 5.0,
+            format!("riding={} moved {moved:.1} m in 4 s", p.riding),
+        ),
+        "dismount" => (!p.riding, format!("riding={}", p.riding)),
+        "ship_spawned" => (p.ships > b.ships, format!("ships {} -> {} {}", b.ships, p.ships, why())),
+        "ship_board" => (
+            p.riding_volume || p.riding,
+            format!(
+                "on board={} can_mount(before)={} ship_dist={:?}",
+                p.riding_volume,
+                b.can_mount,
+                p.rel(Tgt::Ship).map(|r| r.1)
+            ),
+        ),
+        "airship_spawned" => (
+            p.airships > b.airships,
+            format!("airships {} -> {} {}", b.airships, p.airships, why()),
+        ),
+        "world_small" => {
+            let [x, y] = p.world_chunks;
+            (
+                x == 128 && y == 128,
+                format!("world {x}x{y} chunks (ready-made 'Small land' = 128x128; official = 1024x1024)"),
+            )
+        },
+        "export_downloads" => match crate::android::take_file_result(1) {
+            Some((t, ok)) => (ok, t),
+            None => (false, "no export result from Java".into()),
+        },
+        _ => return None,
+    })
+}
+
+/// dev.8 scenario 11, main menu part (before the world starts): add the
+/// ready-made world, export every world, import the export back, then play the
+/// ready-made world. Results are logged as `VEL-CHECK`.
+pub fn menu_steps(w: &mut crate::singleplayer::SingleplayerWorlds) {
+    use crate::{android::alog_check, singleplayer::phone_worlds::transfer};
+    let n0 = w.worlds.len();
+    let idx = w.add_pregenerated(0);
+    let map_ok = idx
+        .and_then(|i| w.worlds.get(i))
+        .and_then(|x| std::fs::metadata(&x.map_path).ok())
+        .map(|m| m.len());
+    alog_check(
+        "pregen_world_added",
+        idx.is_some() && map_ok.unwrap_or(0) > 0 && w.worlds.len() == n0 + 1,
+        &format!("worlds {n0} -> {} map.bin bytes={map_ok:?}", w.worlds.len()),
+    );
+    let n1 = w.worlds.len();
+    match transfer::export_all(w) {
+        Ok(path) => {
+            let size = std::fs::metadata(&path).map(|m| m.len()).unwrap_or(0);
+            alog_check("export_tar", size > 0, &format!("{} bytes={size}", path.display()));
+            let name = path.file_name().map(|n| n.to_string_lossy().into_owned()).unwrap_or_default();
+            crate::android::export_file(&path, &name);
+            match transfer::import_tar(w, &path) {
+                Ok(n) => alog_check(
+                    "import_tar",
+                    n == n1 && w.worlds.len() == 2 * n1,
+                    &format!("imported {n}, worlds {n1} -> {}", w.worlds.len()),
+                ),
+                Err(e) => alog_check("import_tar", false, &e),
+            }
+        },
+        Err(e) => alog_check("export_tar", false, &e.to_string()),
+    }
+    // play the first (not imported) ready-made world
+    w.current = w
+        .worlds
+        .iter()
+        .position(|x| x.name == crate::singleplayer::phone_worlds::PREGEN[0].name && x.is_generated);
+    crate::android::alog(4, &format!("VEL-STEP scenario 11 plays world {:?}", w.current));
+}
