+//   SPDX-License-Identifier: BSD-3-Clause
+//
+// Changes for Veloren: the source here is linear HDR (before tone mapping),
+// so the edge analysis and the sharpening delta run on a Reinhard-compressed
+// green channel (x / (1 + x)) and the result is expanded back; the edge
+// direction variant is used; the interface is Veloren's `aa_apply`.
+
+#define SGSR_EDGE_THRESHOLD (8.0 / 255.0)
+#define SGSR_EDGE_SHARPNESS 2.0
+
+float sgsr_fast_lanczos2(float x) {
+    float wA = x - 4.0;
+    float wB = x * wA - wA;
+    wA *= wA;
+    return wB * wA;
+}
+
+vec2 sgsr_weight_y(float dx, float dy, float c, vec3 data) {
+    float std_ = data.x;
+    vec2 dir = data.yz;
+    float edge_dis = dx * dir.y + dy * dir.x;
+    float x = (dx * dx + dy * dy) + (edge_dis * edge_dis) * (clamp(c * c * std_, 0.0, 1.0) * 0.7 - 1.0);
+    float w = sgsr_fast_lanczos2(x);
+    return vec2(w, w * c);
+}
+
+vec2 sgsr_edge_direction(vec4 left, vec4 right) {
+    float RxLz = right.x - left.z;
+    float RwLy = right.w - left.y;
+    vec2 delta = vec2(RxLz + RwLy, RxLz - RwLy);
+    float len_inv = inversesqrt(delta.x * delta.x + 3.075740e-05 + delta.y * delta.y);
+    return delta * len_inv;
+}
+
+// textureGather(.., 1) at the texel corner `ij` without textureGather (not
+// available in every shader front end Veloren uses): green channel of the
+// texels (i-1, j), (i, j), (i, j-1), (i-1, j-1), in gather order.
+vec4 sgsr_gather_g(texture2D tex, sampler smplr, ivec2 ij, ivec2 sz) {
+    ivec2 hi = sz - 1;
+    return vec4(
+        texelFetch(sampler2D(tex, smplr), clamp(ij + ivec2(-1, 0), ivec2(0), hi), 0).g,
+        texelFetch(sampler2D(tex, smplr), clamp(ij, ivec2(0), hi), 0).g,
+        texelFetch(sampler2D(tex, smplr), clamp(ij + ivec2(0, -1), ivec2(0), hi), 0).g,
+        texelFetch(sampler2D(tex, smplr), clamp(ij + ivec2(-1, -1), ivec2(0), hi), 0).g
+    );
+}
+
+// HDR <-> [0, 1) for the analysis.
+vec4 sgsr_c(vec4 v) { return v / (1.0 + v); }
+float sgsr_c1(float v) { return v / (1.0 + v); }
+
+vec4 aa_apply(
+    texture2D tex, sampler smplr,
+    texture2D depth_tex, sampler depth_smplr,
+    vec2 fragCoord,
+    vec2 resolution
+) {
+    vec2 uv = fragCoord / resolution;
+    ivec2 in_isize = textureSize(sampler2D(tex, smplr), 0);
+    vec2 in_size = vec2(in_isize);
+    vec4 viewport = vec4(1.0 / in_size, in_size);
+
+    vec4 color = textureLod(sampler2D(tex, smplr), uv, 0.0);
+    float g = sgsr_c1(max(color.g, 0.0));
+
+    vec2 img_coord = uv * viewport.zw + vec2(-0.5, 0.5);
+    vec2 img_coord_pixel = floor(img_coord);
+    ivec2 ij = ivec2(img_coord_pixel);
+    vec2 pl = img_coord - img_coord_pixel;
+    vec4 left = sgsr_c(max(sgsr_gather_g(tex, smplr, ij, in_isize), vec4(0.0)));
+
+    float edge_vote = abs(left.z - left.y) + abs(g - left.y) + abs(g - left.z);
+    if (edge_vote > SGSR_EDGE_THRESHOLD) {
+        ij.x += 1;
+
+        vec4 right = sgsr_c(max(sgsr_gather_g(tex, smplr, ij + ivec2(1, 0), in_isize), vec4(0.0)));
+        vec4 up_down;
+        up_down.xy = sgsr_c(max(sgsr_gather_g(tex, smplr, ij + ivec2(0, -1), in_isize), vec4(0.0))).wz;
+        up_down.zw = sgsr_c(max(sgsr_gather_g(tex, smplr, ij + ivec2(0, 1), in_isize), vec4(0.0))).yx;
+
+        float mean = (left.y + left.z + right.x + right.w) * 0.25;
+        left -= vec4(mean);
+        right -= vec4(mean);
+        up_down -= vec4(mean);
+        float cw = g - mean;
+
+        float sum = abs(left.x) + abs(left.y) + abs(left.z) + abs(left.w)
+            + abs(right.x) + abs(right.y) + abs(right.z) + abs(right.w)
+            + abs(up_down.x) + abs(up_down.y) + abs(up_down.z) + abs(up_down.w);
+        float sum_mean = 1.014185e+01 / max(sum, 1e-6);
+        float std_ = sum_mean * sum_mean;
+
+        vec3 data = vec3(std_, sgsr_edge_direction(left, right));
+        vec2 aWY = sgsr_weight_y(pl.x, pl.y + 1.0, up_down.x, data);
+        aWY += sgsr_weight_y(pl.x - 1.0, pl.y + 1.0, up_down.y, data);
+        aWY += sgsr_weight_y(pl.x - 1.0, pl.y - 2.0, up_down.z, data);
+        aWY += sgsr_weight_y(pl.x, pl.y - 2.0, up_down.w, data);
+        aWY += sgsr_weight_y(pl.x + 1.0, pl.y - 1.0, left.x, data);
+        aWY += sgsr_weight_y(pl.x, pl.y - 1.0, left.y, data);
+        aWY += sgsr_weight_y(pl.x, pl.y, left.z, data);
+        aWY += sgsr_weight_y(pl.x + 1.0, pl.y, left.w, data);
+        aWY += sgsr_weight_y(pl.x - 1.0, pl.y - 1.0, right.x, data);
+        aWY += sgsr_weight_y(pl.x - 2.0, pl.y - 1.0, right.y, data);
+        aWY += sgsr_weight_y(pl.x - 2.0, pl.y, right.z, data);
+        aWY += sgsr_weight_y(pl.x - 1.0, pl.y, right.w, data);
+
+        float final_y = aWY.y / aWY.x;
+        float max_y = max(max(left.y, left.z), max(right.x, right.w));
+        float min_y = min(min(left.y, left.z), min(right.x, right.w));
+        float delta_y = clamp(SGSR_EDGE_SHARPNESS * final_y, min_y, max_y) - cw;
+        // smooth high contrast input
+        delta_y = clamp(delta_y, -23.0 / 255.0, 23.0 / 255.0);
+        if (!isnan(delta_y)) {
+            // Apply the delta in the compressed domain, per channel.
+            vec3 cc = sgsr_c(vec4(max(color.rgb, vec3(0.0)), 0.0)).rgb;
+            cc = clamp(cc + delta_y, 0.0, 0.996);
+            color.rgb = cc / (1.0 - cc);
+        }
+    }
+    color.a = 1.0;
+    return color;
+}
