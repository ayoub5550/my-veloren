diff --git a/voxygen/src/framegen.rs b/voxygen/src/framegen.rs
new file mode 100644
index 0000000..039fb49
--- /dev/null
+++ b/voxygen/src/framegen.rs
@@ -0,0 +1,272 @@
+//! my-veloren dev.10: frame generation by depth reprojection.
+//!
+//! When enabled, every second in-game frame is *generated* instead of
+//! rendered: the world passes (shadows, terrain, figures, clouds, bloom) are
+//! skipped and the post-process pass re-projects the previous real frame
+//! (still sitting in the colour/depth targets) to the new camera, using the
+//! depth buffer. The HUD and touch controls are drawn fresh every frame.
+//!
+//! This is the cheap, single-threaded cousin of VR "timewarp"/"spacewarp":
+//! camera motion (turning, orbiting, walking, gliding) is shown at the full
+//! presented rate while the GPU renders the world at half of it. Moving
+//! entities and animated water only change on real frames.
+//!
+//! Pacing: a generated frame is held back so that it is presented about one
+//! present interval after the real frame before it, and frame generation
+//! steps aside (renders every frame for real) while real frames take too
+//! long for that rhythm (`VEL-FG` lines tell which mode is active).
+
+use std::{
+    sync::Mutex,
+    time::{Duration, Instant},
+};
+use vek::*;
+
+#[derive(Clone, Copy)]
+struct Snap {
+    view: Mat4<f64>,
+    proj: Mat4<f64>,
+    focus_off: Vec3<f64>,
+    res: Vec2<u32>,
+}
+
+struct St {
+    /// User setting (graphics.frame_generation).
+    enabled: bool,
+    /// Test override: generate even when real frames are slow (VM).
+    forced: bool,
+    /// Camera of the last real frame.
+    last_real: Option<Snap>,
+    /// Decision for the frame being built (set by `plan`, read by `render`).
+    pending_generated: bool,
+    /// Generated frames presented since the last real one.
+    prev_generated: u32,
+    /// When `plan` last ran (= we are in the world).
+    last_plan: Option<Instant>,
+    /// When the last real frame was presented.
+    last_real_present: Option<Instant>,
+    /// Smoothed CPU time of real / generated frames (s).
+    real_ema: f64,
+    gen_ema: f64,
+    /// Fallback to all-real frames until this time.
+    backoff_until: Option<Instant>,
+    // stats for VEL-FG
+    n_real: u64,
+    n_gen: u64,
+    n_cut: u64,
+    n_backoff: u64,
+    n_plan: u64,
+}
+
+static ST: Mutex<St> = Mutex::new(St {
+    enabled: false,
+    forced: false,
+    last_real: None,
+    pending_generated: false,
+    prev_generated: 0,
+    last_plan: None,
+    last_real_present: None,
+    real_ema: 0.0,
+    gen_ema: 0.003,
+    backoff_until: None,
+    n_real: 0,
+    n_gen: 0,
+    n_cut: 0,
+    n_backoff: 0,
+    n_plan: 0,
+});
+
+fn st() -> std::sync::MutexGuard<'static, St> { ST.lock().unwrap_or_else(|e| e.into_inner()) }
+
+/// Fixed present rate while frame generation runs (real frames = half).
+pub const PRESENT_FPS: u32 = 60;
+
+/// Set from the graphics settings every frame (cheap).
+pub fn set_enabled(enabled: bool) {
+    let mut s = st();
+    if std::env::var_os("MY_VELOREN_FG_HOLD").is_some() {
+        s.forced = true;
+    }
+    if s.enabled != enabled {
+        tracing::info!("VEL-FG enabled={enabled}");
+        s.enabled = enabled;
+        s.last_real = None;
+        s.prev_generated = 0;
+        s.backoff_until = None;
+    }
+}
+
+/// Test hook (`force_framegen` file): ignore the slow-frame back-off.
+pub fn set_forced(forced: bool) { st().forced = forced; }
+
+/// Forget the previous frame (targets were recreated, surface lost, ...).
+pub fn invalidate() {
+    let mut s = st();
+    s.last_real = None;
+    s.prev_generated = 0;
+    s.pending_generated = false;
+}
+
+/// True while the player is in the world with frame generation on and not
+/// backed off: the frame cap becomes `PRESENT_FPS`.
+pub fn active() -> bool {
+    let s = st();
+    s.enabled
+        && s.last_plan
+            .is_some_and(|t| t.elapsed() < Duration::from_millis(500))
+        && !s.backoff_until.is_some_and(|t| Instant::now() < t)
+}
+
+/// Present rate to use for an in-world frame cap of `max_fps`.
+pub fn target_fps(max_fps: u32) -> u32 {
+    if active() { PRESENT_FPS.max(max_fps.min(PRESENT_FPS)) } else { max_fps }
+}
+
+/// `old NDC (x, y, depth, 1)` → `new clip space` for the post-process pass.
+fn reproj(old: &Snap, view: Mat4<f64>, proj: Mat4<f64>, focus_off: Vec3<f64>) -> Mat4<f64> {
+    proj * view * Mat4::translation_3d(old.focus_off - focus_off) * old.view.inverted()
+        * old.proj.inverted()
+}
+
+fn to_uv(m: &Mat4<f64>, x: f64, y: f64, d: f64) -> Option<Vec2<f64>> {
+    let c = *m * Vec4::new(x, y, d, 1.0);
+    (c.w > 1e-6).then(|| Vec2::new(c.x / c.w, c.y / c.w))
+}
+
+/// Called once per in-world frame with the new camera (Scene::maintain).
+/// Returns the re-projection matrix (and its inverse) when this frame is to
+/// be generated.
+pub fn plan(
+    view: Mat4<f32>,
+    proj: Mat4<f32>,
+    focus_off: Vec3<f32>,
+    res: Vec2<u32>,
+    allow: bool,
+) -> Option<(Mat4<f32>, Mat4<f32>)> {
+    let mut s = st();
+    let now = Instant::now();
+    s.last_plan = Some(now);
+    let snap = Snap {
+        view: view.as_(),
+        proj: proj.as_(),
+        focus_off: focus_off.as_(),
+        res,
+    };
+    let backing_off = !s.forced && s.backoff_until.is_some_and(|t| now < t);
+    let mut out = None;
+    if s.enabled && allow && s.prev_generated < debug_hold() && !backing_off {
+        if let Some(old) = s.last_real.filter(|o| o.res == res) {
+            let m = reproj(&old, snap.view, snap.proj, snap.focus_off);
+            // Camera cut / teleport / huge turn: render for real.
+            let ok = [(0.0, 0.0), (-0.8, -0.8), (0.8, 0.8)].iter().all(|&(x, y)| {
+                to_uv(&m, x, y, 0.00625) // ~10 m away (reversed z)
+                    .is_some_and(|p| (p - Vec2::new(x, y)).magnitude() < 0.35 && p.x.is_finite())
+            });
+            if ok {
+                out = Some((m.as_(), m.inverted().as_()));
+            } else {
+                s.n_cut += 1;
+                tracing::debug!("VEL-FG camera cut -> real frame");
+            }
+        }
+    }
+    s.n_plan += 1;
+    if s.n_plan % 240 == 1 {
+        tracing::debug!(
+            "VEL-FG plan #{} enabled={} allow={allow} prev_gen={} backoff={backing_off} last_real={} res={res:?} last_res={:?} out={}",
+            s.n_plan, s.enabled, s.prev_generated, s.last_real.is_some(), s.last_real.map(|o| o.res), out.is_some()
+        );
+    }
+    s.pending_generated = out.is_some();
+    if out.is_none() {
+        s.last_real = Some(snap);
+    }
+    out
+}
+
+/// Consumed by the session renderer: skip the world passes this frame?
+pub fn take_generated() -> bool { std::mem::take(&mut st().pending_generated) }
+
+/// Peek (run loop, before rendering).
+pub fn is_generated_pending() -> bool { st().pending_generated }
+
+/// How long to wait before recording a generated frame so it is shown about
+/// one present interval after the previous real frame.
+pub fn pre_present_wait() -> Option<Duration> {
+    let s = st();
+    if !s.pending_generated {
+        return None;
+    }
+    let t = s.last_real_present?;
+    let goal = 1.0 / PRESENT_FPS as f64 - s.gen_ema;
+    let left = goal - t.elapsed().as_secs_f64();
+    (left > 0.0005).then(|| Duration::from_secs_f64(left.min(0.05)))
+}
+
+/// After the frame was presented; `work` = tick + acquire + record seconds.
+pub fn frame_finished(generated: bool, work: f64) {
+    let mut s = st();
+    let now = Instant::now();
+    if generated {
+        s.gen_ema = 0.9 * s.gen_ema + 0.1 * work;
+        s.n_gen += 1;
+    } else {
+        s.real_ema = if s.real_ema == 0.0 { work } else { 0.9 * s.real_ema + 0.1 * work };
+        s.n_real += 1;
+        if s.enabled && s.n_real % 120 == 0 {
+            tracing::debug!(
+                "VEL-FG real={} gen={} cut={} backoff={}",
+                s.n_real, s.n_gen, s.n_cut, s.n_backoff
+            );
+        }
+        s.last_real_present = Some(now);
+        // A real frame that alone takes longer than ~1.3 present intervals
+        // cannot be paced with a generated one: step aside for 5 s.
+        if s.enabled
+            && !s.forced
+            && !s.backoff_until.is_some_and(|t| now < t)
+            && s.n_real > 30
+            && s.real_ema > 1.3 / PRESENT_FPS as f64
+        {
+            s.backoff_until = Some(now + Duration::from_secs(5));
+            s.n_backoff += 1;
+            s.real_ema = 1.0 / PRESENT_FPS as f64;
+        }
+    }
+    s.prev_generated = if generated { s.prev_generated + 1 } else { 0 };
+}
+
+/// Generated frames per real frame: 1, or `MY_VELOREN_FG_HOLD` (desktop
+/// harness: hold the world for many frames to inspect the re-projection).
+fn debug_hold() -> u32 {
+    static HOLD: std::sync::OnceLock<u32> = std::sync::OnceLock::new();
+    *HOLD.get_or_init(|| {
+        std::env::var("MY_VELOREN_FG_HOLD")
+            .ok()
+            .and_then(|v| v.parse().ok())
+            .unwrap_or(1)
+            .max(1)
+    })
+}
+
+/// (generated, real) frames so far.
+pub fn counters() -> (u64, u64) {
+    let s = st();
+    (s.n_gen, s.n_real)
+}
+
+/// One line for VEL-PERF.
+pub fn summary() -> String {
+    let s = st();
+    format!(
+        "fg[on={} forced={} real={} gen={} cut={} backoff={} real_ms={:.1} gen_ms={:.1}]",
+        s.enabled as u8,
+        s.forced as u8,
+        s.n_real,
+        s.n_gen,
+        s.n_cut,
+        s.n_backoff,
+        s.real_ema * 1000.0,
+        s.gen_ema * 1000.0
+    )
+}
