+        rate_rc: -1,
+        session: 0,
+        target_ns: 0,
+        reports: 0,
+    });
+
+    fn load() -> Option<Api> {
+        // SAFETY: dlopen/dlsym of documented NDK symbols; the function types
+        // match <android/native_window.h> and <android/performance_hint.h>.
+        unsafe {
+            let lib = libc::dlopen(c"libandroid.so".as_ptr(), libc::RTLD_NOW);
+            if lib.is_null() {
+                return None;
+            }
+            let sym = |n: &core::ffi::CStr| {
+                let p = libc::dlsym(lib, n.as_ptr());
+                (!p.is_null()).then_some(p)
+            };
+            let set_frame_rate = sym(c"ANativeWindow_setFrameRate")
+                .map(|p| std::mem::transmute::<*mut libc::c_void, SetFrameRate>(p));
+            let hint = match (
+                sym(c"APerformanceHint_getManager"),
+                sym(c"APerformanceHint_createSession"),
+                sym(c"APerformanceHint_updateTargetWorkDuration"),
+                sym(c"APerformanceHint_reportActualWorkDuration"),
+            ) {
+                (Some(a), Some(b), Some(c), Some(d)) => Some((
+                    std::mem::transmute::<*mut libc::c_void, GetManager>(a),
+                    std::mem::transmute::<*mut libc::c_void, CreateSession>(b),
+                    std::mem::transmute::<*mut libc::c_void, UpdateTarget>(c),
+                    std::mem::transmute::<*mut libc::c_void, ReportActual>(d),
+                )),
+                _ => None,
+            };
+            Some(Api { set_frame_rate, hint })
+        }
+    }
+
+    /// Main loop, once per frame: `fps` = the present rate the frame cap
+    /// aims at, `work` = seconds of CPU work this frame (no cap sleep).
+    pub fn frame(fps: u32, work: f64) {
+        let mut st = ST.lock().unwrap_or_else(|e| e.into_inner());
+        if st.api.is_none() {
+            let api = load();
+            tracing::info!(
+                "VEL-PACING setFrameRate={} adpf={}",
+                api.as_ref().is_some_and(|a| a.set_frame_rate.is_some()),
+                api.as_ref().is_some_and(|a| a.hint.is_some())
+            );
+            st.api = Some(api);
+        }
+        let Some(Some(api)) = st.api.as_ref() else { return };
+        let (set_frame_rate, hint) = (api.set_frame_rate, api.hint);
+        let fps = fps.clamp(10, 120);
+        // Display rate.
+        if let Some(set) = set_frame_rate {
+            let win = crate::android::app().native_window();
+            let ptr = win.as_ref().map_or(0, |w| w.ptr().as_ptr() as usize);
+            if ptr != 0 && (ptr != st.window || fps != st.rate) {
+                // SAFETY: `win` holds a reference on the window for this call.
+                // compatibility 0 = DEFAULT (the app may run at multiples).
+                let rc = unsafe { set(ptr as *mut core::ffi::c_void, fps as f32, 0) };
+                tracing::info!("VEL-PACING display rate {fps} Hz rc={rc}");
+                st.window = ptr;
+                st.rate = fps;
+                st.rate_rc = rc;
+            }
+            drop(win);
+        }
+        // ADPF hint session for the main thread.
+        if let Some((get, create, update, report)) = hint {
+            let target = (1e9 / fps as f64) as i64;
+            // SAFETY: documented ADPF calls; the session lives for the process.
+            unsafe {
+                if st.session == 0 {
+                    let mgr = get();
+                    if !mgr.is_null() {
+                        let tid = libc::gettid();
+                        let s = create(mgr, &tid, 1, target);
+                        st.session = s as usize;
+                        st.target_ns = target;
+                        tracing::info!("VEL-PACING adpf session={}", !s.is_null());
+                        if s.is_null() {
+                            // Unsupported on this device: do not retry.
+                            st.api = Some(Some(Api { set_frame_rate, hint: None }));
+                            return;
+                        }
+                    }
+                }
+                if st.session != 0 {
+                    let s = st.session as *mut core::ffi::c_void;
+                    if target != st.target_ns {
+                        update(s, target);
+                        st.target_ns = target;
+                    }
+                    let w = (work * 1e9) as i64;
+                    if w > 0 {
+                        report(s, w);
+                        st.reports += 1;
+                    }
+                }
+            }
+        }
+    }
+
+    pub fn summary() -> String {
+        let st = ST.lock().unwrap_or_else(|e| e.into_inner());
+        format!(
+            "pacing[hz={} rc={} adpf={} reports={}]",
+            st.rate, st.rate_rc, (st.session != 0) as u8, st.reports
+        )
+    }
+}
+
+#[cfg(target_os = "android")]
+pub fn pacing_summary() -> String { pacing::summary() }
