+// dev.10 frame generation: where a pixel of the previous (real) frame lands
+// now (xy = uv, z = its previous depth, reversed z: larger = nearer).
+vec3 fg_forward(vec2 src_uv) {
+    vec2 sz = vec2(textureSize(sampler2D(t_src_depth, s_src_depth), 0));
+    float d = texelFetch(sampler2D(t_src_depth, s_src_depth), clamp(ivec2(src_uv * sz), ivec2(0), ivec2(sz) - 1), 0).x;
+    vec4 c = reproj_mat * vec4((src_uv * 2.0 - 1.0) * vec2(1, -1), d, 1.0);
+    vec2 ndc = c.w > 1e-6 ? c.xy / c.w : vec2(4.0);
+    return vec3((ndc * vec2(1, -1) + 1.0) * 0.5, d);
+}
+
+// Inverse of fg_forward by fixed-point iteration from a start point; returns
+// (previous uv, residual in output pixels, previous depth).
+vec4 fg_search(vec2 uv, vec2 start) {
+    vec2 s = start;
+    vec3 f = fg_forward(s);
+    for (int i = 0; i < 5; i ++) {
+        s = clamp(s + (uv - f.xy), vec2(0.0), vec2(1.0));
+        f = fg_forward(s);
+    }
+    return vec4(s, length((f.xy - uv) * screen_res.xy), f.z);
+}
+
+// The previous-frame uv whose content is seen at `uv` in this frame. Two
+// searches: one from the same uv (finds surfaces that barely moved) and one
+// from where the far background was (finds what a moving foreground uncovers).
+// If both converge the nearer surface wins (it occludes); if neither does, the
+// background is the better guess for a disocclusion.
+vec2 fg_reproject(vec2 uv) {
+    vec4 far_c = reproj_inv * vec4((uv * 2.0 - 1.0) * vec2(1, -1), 0.0, 1.0);
+    vec2 far_uv = far_c.w > 1e-6 ? (far_c.xy / far_c.w * vec2(1, -1) + 1.0) * 0.5 : uv;
+    vec4 a = fg_search(uv, uv);
+    vec4 b = fg_search(uv, clamp(far_uv, vec2(0.0), vec2(1.0)));
+    const float OK_PX = 1.5;
+    bool ca = a.z < OK_PX;
+    bool cb = b.z < OK_PX;
+    if (ca && cb) {
+        return a.w >= b.w ? a.xy : b.xy;
+    } else if (ca) {
+        return a.xy;
+    } else if (cb) {
+        return b.xy;
+    } else {
+        return a.w < b.w ? a.xy : b.xy;
+    }
+}
