+        g.render_mode.upscale_mode = UpscaleMode { factor: if old_ultra { 0.8 } else { 0.75 } };
+        what.push(if old_ultra { "ultra" } else { "high" });
+    }
+    let _ = std::fs::write(&path, format!("dev10 {}\n", what.join(",")));
+    tracing::info!("mobile preset: dev10 upgrade [{}]", what.join(","));
