+        b(Ability1, 0.62, 0.37, 0.055),
+        b(Ability2, 0.69, 0.37, 0.055),
+        b(Ability3, 0.76, 0.37, 0.055),
+        b(Ability4, 0.83, 0.37, 0.055),
+        b(Ability5, 0.90, 0.37, 0.055),
+        // contextual (appear only when possible)
+        b(Interact, 0.62, 0.62, 0.075),
+        b(Mount, 0.62, 0.80, 0.065),
+        b(SwimUp, 0.53, 0.55, 0.06),
+        b(SwimDown, 0.53, 0.75, 0.06),
+        b(Respawn, 0.40, 0.40, 0.08),
+        // left column (movement modifiers)
+        b(Glide, 0.05, 0.32, 0.055),
+        b(Sneak, 0.05, 0.45, 0.045),
+        b(Wield, 0.05, 0.58, 0.045),
+        b(Lantern, 0.05, 0.71, 0.045),
+        // top menu bar
+        b(Menu, 0.27, 0.065, 0.045),
+        b(Bag, 0.34, 0.065, 0.045),
+        b(Map, 0.41, 0.065, 0.045),
+        b(Skills, 0.48, 0.065, 0.045),
+        b(Crafting, 0.55, 0.065, 0.045),
+        b(Social, 0.62, 0.065, 0.045),
+        b(Chat, 0.69, 0.065, 0.045),
+        b(Edit, 0.76, 0.065, 0.045),
