+// ------------------------------------------------------------------ tests ---
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    const W: f64 = 2400.0;
+    const H: f64 = 1080.0;
+
+    fn ctx() -> Context {
+        Context {
+            in_session: true,
+            game_input: true,
+            ..Default::default()
+        }
+    }
+
+    fn px(b: ButtonLayout) -> (f64, f64) { (b.x as f64 * W, b.y as f64 * H) }
+
+    #[test]
+    fn default_layout_has_every_control_once() {
+        let l = default_layout();
+        for c in Ctl::ALL {
+            assert_eq!(l.iter().filter(|b| b.ctl == c).count(), 1, "{c:?}");
+        }
+        assert_eq!(l.len(), Ctl::ALL.len());
+    }
+
+    #[test]
+    fn default_layout_does_not_overlap_and_fits() {
+        for aspect in [16.0 / 9.0, 2.0, 2400.0 / 1080.0, 22.0 / 9.0] {
+            let l = default_layout();
+            for (i, a) in l.iter().enumerate() {
+                assert!(a.x - a.size / aspect >= 0.0, "{:?} off left @{aspect}", a.ctl);
+                assert!(a.x + a.size / aspect <= 1.0, "{:?} off right @{aspect}", a.ctl);
+                assert!(a.y - a.size >= 0.0 && a.y + a.size <= 1.0, "{:?} off v", a.ctl);
+                for b in &l[i + 1..] {
+                    let d = dist_h(a.x, a.y, b.x, b.y, aspect);
+                    assert!(
+                        d > a.size + b.size,
+                        "{:?} overlaps {:?} @{aspect}: {d} <= {}",
+                        a.ctl,
+                        b.ctl,
+                        a.size + b.size
+                    );
+                }
+            }
+            // Tools do not overlap each other.
+            for (i, a) in Tool::ALL.iter().enumerate() {
+                for b in &Tool::ALL[i + 1..] {
+                    let (ax, ay, ar) = a.place();
+                    let (bx, by, br) = b.place();
+                    assert!(dist_h(ax, ay, bx, by, aspect) > ar + br);
+                }
+            }
+        }
+    }
+
+    #[test]
+    fn button_press_and_release() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        let (x, y) = px(s.layout(Ctl::Jump));
+        let o = t.on_touch(1, Phase::Started, x, y, W, H, &ctx(), &mut s);
+        assert_eq!(o, vec![Out::Press(Ctl::Jump)]);
+        let o = t.on_touch(1, Phase::Moved, x + 30.0, y, W, H, &ctx(), &mut s);
+        assert!(o.is_empty(), "button finger must not pan: {o:?}");
+        assert_eq!(t.on_frame(&s), vec![]);
+        let o = t.on_touch(1, Phase::Ended, x + 30.0, y, W, H, &ctx(), &mut s);
+        assert_eq!(o, vec![Out::Release(Ctl::Jump)]);
+    }
+
+    #[test]
+    fn analog_stick_walk_and_run() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        let (ox, oy) = (0.2 * W, 0.75 * H);
+        assert!(t.on_touch(1, Phase::Started, ox, oy, W, H, &ctx(), &mut s).is_empty());
+        // inside dead-zone
+        let o = t.on_touch(1, Phase::Moved, ox + 5.0, oy, W, H, &ctx(), &mut s);
+        assert!(o.is_empty());
+        let r = s.stick_radius as f64 * H;
+        // light tilt forward → slow
+        let o = t.on_touch(1, Phase::Moved, ox, oy - 0.4 * r, W, H, &ctx(), &mut s);
+        let Out::Move(x, y) = o[0] else { panic!() };
+        assert!(x.abs() < 1e-3 && y > 0.2 && y < 0.4, "{y}");
+        // full tilt beyond radius → clamped to 1
+        let o = t.on_touch(1, Phase::Moved, ox + 3.0 * r, oy, W, H, &ctx(), &mut s);
+        let Out::Move(x, y) = o[0] else { panic!() };
+        assert!((x - 1.0).abs() < 1e-3 && y.abs() < 1e-3);
+        let o = t.on_touch(1, Phase::Ended, ox, oy, W, H, &ctx(), &mut s);
+        assert_eq!(o, vec![Out::Move(0.0, 0.0)]);
+    }
+
+    #[test]
+    fn multitouch_stick_camera_attack_together() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        s.camera_smoothing = 0.0;
+        let c = ctx();
+        let (ax, ay) = px(s.layout(Ctl::Primary));
+        t.on_touch(1, Phase::Started, 0.2 * W, 0.75 * H, W, H, &c, &mut s);
+        t.on_touch(2, Phase::Started, 0.5 * W, 0.22 * H, W, H, &c, &mut s);
+        assert_eq!(t.on_touch(3, Phase::Started, ax, ay, W, H, &c, &mut s), vec![
+            Out::Press(Ctl::Primary)
+        ]);
+        let m = t.on_touch(1, Phase::Moved, 0.2 * W, 0.75 * H - 200.0, W, H, &c, &mut s);
+        assert!(matches!(m[0], Out::Move(_, y) if y > 0.9));
+        t.on_touch(2, Phase::Moved, 0.5 * W + 100.0, 0.22 * H, W, H, &c, &mut s);
+        let p = t.on_frame(&s);
+        assert!(matches!(p[0], Out::Pan(x, y) if x > 50.0 && y.abs() < 1e-3), "{p:?}");
+        // jitter on the attack finger does not touch the camera
+        t.on_touch(3, Phase::Moved, ax + 20.0, ay + 20.0, W, H, &c, &mut s);
+        assert!(t.on_frame(&s).is_empty());
+        assert_eq!(t.finger_count(), 3);
+    }
+
+    #[test]
+    fn camera_smoothing_converges() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        s.camera_smoothing = 0.5;
+        let c = ctx();
+        t.on_touch(2, Phase::Started, 0.5 * W, 0.22 * H, W, H, &c, &mut s);
+        t.on_touch(2, Phase::Moved, 0.5 * W + 100.0, 0.22 * H, W, H, &c, &mut s);
+        let mut total = 0.0;
+        for _ in 0..40 {
+            for o in t.on_frame(&s) {
+                if let Out::Pan(x, _) = o {
+                    total += x;
+                }
+            }
+        }
+        let expect = 100.0 * PAN_BASE as f32 / H as f32;
+        assert!((total - expect).abs() < 0.05 * expect, "{total} vs {expect}");
+    }
+
+    #[test]
+    fn pinch_zoom() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        let c = ctx();
+        set_window_height(H);
+        t.on_touch(1, Phase::Started, 0.55 * W, 0.25 * H, W, H, &c, &mut s);
+        t.on_touch(2, Phase::Started, 0.65 * W, 0.25 * H, W, H, &c, &mut s);
+        let o = t.on_touch(2, Phase::Moved, 0.75 * W, 0.25 * H, W, H, &c, &mut s);
+        assert!(matches!(o[0], Out::Zoom(z) if z < 0.0), "{o:?}");
+        // no pan while pinching
+        assert!(t.on_frame(&s).is_empty());
+        let o = t.on_touch(2, Phase::Moved, 0.66 * W, 0.25 * H, W, H, &c, &mut s);
+        assert!(matches!(o[0], Out::Zoom(z) if z > 0.0), "{o:?}");
+    }
+
+    #[test]
+    fn contextual_buttons() {
+        let mut c = ctx();
+        assert!(!c.visible(Ctl::Interact));
+        assert!(!c.visible(Ctl::Mount));
+        assert!(!c.visible(Ctl::SwimUp));
+        c.can_interact = true;
+        c.riding = true;
+        c.in_liquid = true;
+        assert!(c.visible(Ctl::Interact));
+        assert!(c.visible(Ctl::Mount));
+        assert_eq!(Ctl::Mount.label(&c), "Dismount");
+        assert!(c.visible(Ctl::SwimDown));
+        c.dead = true;
+        assert!(c.visible(Ctl::Respawn));
+        assert!(!c.visible(Ctl::Primary));
+        c.dead = false;
+        c.game_input = false;
+        assert!(!c.visible(Ctl::Primary));
+        assert!(c.visible(Ctl::Bag), "menu bar stays to close windows");
+        assert!(!c.visible(Ctl::Edit));
+    }
+
+    #[test]
+    fn window_open_means_mouse_and_releases_held() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        let mut c = ctx();
+        let (x, y) = px(s.layout(Ctl::Primary));
+        t.on_touch(1, Phase::Started, x, y, W, H, &c, &mut s);
+        c.game_input = false;
+        let o = t.on_touch(2, Phase::Started, 0.5 * W, 0.5 * H, W, H, &c, &mut s);
+        assert_eq!(o, vec![
+            Out::Release(Ctl::Primary),
+            Out::MouseMove(0.5 * W, 0.5 * H),
+            Out::MouseDown(0.5 * W, 0.5 * H)
+        ]);
+        let (bx, by) = px(s.layout(Ctl::Bag));
+        assert_eq!(t.on_touch(3, Phase::Started, bx, by, W, H, &c, &mut s), vec![
+            Out::Press(Ctl::Bag)
+        ]);
+    }
+
+    #[test]
+    fn layout_editor_move_resize_save_reset() {
+        let mut t = TouchLayer::default();
+        let mut s = TouchSettings::default();
+        let c = ctx();
+        let (ex, ey) = px(s.layout(Ctl::Edit));
+        t.on_touch(1, Phase::Started, ex, ey, W, H, &c, &mut s);
+        t.on_touch(1, Phase::Ended, ex, ey, W, H, &c, &mut s);
+        assert!(t.edit);
+        let (jx, jy) = px(s.layout(Ctl::Jump));
+        assert!(t.on_touch(2, Phase::Started, jx, jy, W, H, &c, &mut s).is_empty());
+        t.on_touch(2, Phase::Moved, jx - 240.0, jy - 108.0, W, H, &c, &mut s);
+        t.on_touch(2, Phase::Ended, jx - 240.0, jy - 108.0, W, H, &c, &mut s);
+        let j = s.layout(Ctl::Jump);
+        assert!((j.x - 0.85).abs() < 1e-3 && (j.y - 0.43).abs() < 1e-3, "{j:?}");
+        let tap = |t: &mut TouchLayer, s: &mut TouchSettings, tool: Tool| {
+            let (x, y, _) = tool.place();
+            let o = t.on_touch(9, Phase::Started, x as f64 * W, y as f64 * H, W, H, &c, s);
+            t.on_touch(9, Phase::Ended, x as f64 * W, y as f64 * H, W, H, &c, s);
+            o
+        };
+        tap(&mut t, &mut s, Tool::Bigger);
+        tap(&mut t, &mut s, Tool::Fainter);
+        let j = s.layout(Ctl::Jump);
+        assert!((j.size - 0.085 * 1.1).abs() < 1e-4 && (j.alpha - 0.85).abs() < 1e-4);
+        // round trip through RON like settings.ron
+        let ron = ron::ser::to_string(&s).unwrap();
+        let back: TouchSettings = ron::from_str(&ron).unwrap();
+        assert_eq!(back, s);
+        // missing field / older file → defaults
+        let old: TouchSettings = ron::from_str("(opacity: 0.4)").unwrap();
+        assert_eq!(old.buttons, default_layout());
+        assert_eq!(tap(&mut t, &mut s, Tool::Done), vec![Out::Save]);
+        assert!(!t.edit);
+        // Reset
+        t.on_touch(1, Phase::Started, ex, ey, W, H, &c, &mut s);
+        tap(&mut t, &mut s, Tool::Reset);
+        assert_eq!(s.buttons, default_layout());
+    }
+
+    #[test]
+    fn primitives_draw_visible_buttons() {
+        let t = TouchLayer::default();
+        let s = TouchSettings::default();
+        let p = t.primitives(&ctx(), &s, 2.2);
+        let labels: Vec<_> = p.iter().filter_map(|p| p.label).collect();
+        assert!(labels.contains(&"Attack") && labels.contains(&"Bag"));
+        assert!(!labels.contains(&"Use"), "contextual hidden");
+        let none = t.primitives(&Context::default(), &s, 2.2);
+        assert!(none.is_empty());
+    }
+}
