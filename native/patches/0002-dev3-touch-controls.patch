+pub const MIN_SIZE: f32 = 0.035;
+pub const MAX_SIZE: f32 = 0.25;
+pub const MIN_ALPHA: f32 = 0.15;
+
+/// Default landscape layout. Verified non-overlapping by unit tests for
+/// aspect ratios 16:9 .. 22:9.
+pub fn default_layout() -> Vec<ButtonLayout> {
+    use Ctl::*;
+    let b = |ctl, x, y, size| ButtonLayout {
+        ctl,
+        x,
