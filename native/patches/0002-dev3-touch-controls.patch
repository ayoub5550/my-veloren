diff --git a/voxygen/src/touch.rs b/voxygen/src/touch.rs
new file mode 100644
index 000000000..db7b74739
--- /dev/null
+++ b/voxygen/src/touch.rs
@@ -0,0 +1,1263 @@
+//! On-screen touch controls (my-veloren dev.3).
+//!
+//! Pure logic only (serde + std): no winit / wgpu / ECS types, so the whole
+//! state machine is unit-tested on the host (`native/touch-tests`).
+//!
+//! * `android.rs` feeds raw touches into [`TouchLayer::on_touch`] and maps the
+//!   returned [`Out`] actions to voxygen window events.
+//! * `hud/touch_overlay.rs` draws [`TouchLayer::primitives`].
+//! * The session publishes a [`Context`] every tick (what is near / possible)
+//!   which drives the context-sensitive buttons (3.7).
+//! * The layout lives in `settings.ron` under `touch` ([`TouchSettings`]).
+//!
+//! Coordinates: positions are fractions of the window (x of width, y of
+//! height, origin top-left); sizes/radii are fractions of the window height.
+
+use serde::{Deserialize, Serialize};
+use std::{collections::VecDeque, sync::Mutex};
+
+// ------------------------------------------------------------------ model ---
+
+/// Every on-screen control.
+#[derive(Clone, Copy, Debug, PartialEq, Eq, Hash, Serialize, Deserialize)]
+pub enum Ctl {
+    // Combat (3.4)
+    Primary,
+    Secondary,
+    Block,
+    Jump,
+    Roll,
+    Ability1,
+    Ability2,
+    Ability3,
+    Ability4,
+    Ability5,
+    // Movement / interaction (3.5)
+    Glide,
+    Sneak,
+    SwimUp,
+    SwimDown,
+    Interact,
+    Mount,
+    Wield,
+    Lantern,
+    Respawn,
+    // Menu bar (3.6)
+    Menu,
+    Bag,
+    Map,
+    Skills,
+    Crafting,
+    Social,
+    Chat,
+    Edit,
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Group {
+    /// Gameplay buttons: only while the game owns the input (no window open).
+    Game,
+    /// Shown only when the [`Context`] says the action is possible (3.7).
+    Contextual,
+    /// Top menu bar: always visible in a session, so windows can be closed.
+    MenuBar,
+}
+
+impl Ctl {
+    pub const ALL: [Ctl; 27] = [
+        Ctl::Primary,
+        Ctl::Secondary,
+        Ctl::Block,
+        Ctl::Jump,
+        Ctl::Roll,
+        Ctl::Ability1,
+        Ctl::Ability2,
+        Ctl::Ability3,
+        Ctl::Ability4,
+        Ctl::Ability5,
+        Ctl::Glide,
+        Ctl::Sneak,
+        Ctl::SwimUp,
+        Ctl::SwimDown,
+        Ctl::Interact,
+        Ctl::Mount,
+        Ctl::Wield,
+        Ctl::Lantern,
+        Ctl::Respawn,
+        Ctl::Menu,
+        Ctl::Bag,
+        Ctl::Map,
+        Ctl::Skills,
+        Ctl::Crafting,
+        Ctl::Social,
+        Ctl::Chat,
+        Ctl::Edit,
+    ];
+
+    pub fn group(self) -> Group {
+        use Ctl::*;
+        match self {
+            Interact | Mount | SwimUp | SwimDown | Respawn => Group::Contextual,
+            Menu | Bag | Map | Skills | Crafting | Social | Chat | Edit => Group::MenuBar,
+            _ => Group::Game,
+        }
+    }
+
+    /// Text printed on the button. Also used by keyboard hints ("Press [Use]").
+    pub fn label(self, ctx: &Context) -> &'static str {
+        use Ctl::*;
+        match self {
+            Primary => "Attack",
+            Secondary => "Skill",
+            Block => "Block",
+            Jump => "Jump",
+            Roll => "Roll",
+            Ability1 => "1",
+            Ability2 => "2",
+            Ability3 => "3",
+            Ability4 => "4",
+            Ability5 => "5",
+            Glide => "Glide",
+            Sneak => "Sneak",
+            SwimUp => "Up",
+            SwimDown => "Down",
+            Interact => "Use",
+            Mount => {
+                if ctx.riding {
+                    "Dismount"
+                } else {
+                    "Mount"
+                }
+            },
+            Wield => "Wield",
+            Lantern => "Lamp",
+            Respawn => "Respawn",
+            Menu => "Menu",
+            Bag => "Bag",
+            Map => "Map",
+            Skills => "Skills",
+            Crafting => "Craft",
+            Social => "Social",
+            Chat => "Chat",
+            Edit => "Edit",
+        }
+    }
+
+    /// Base color (rgb) of the button face.
+    fn tint(self) -> [f32; 3] {
+        use Ctl::*;
+        match self {
+            Primary => [0.80, 0.25, 0.20],
+            Secondary => [0.75, 0.45, 0.15],
+            Block => [0.30, 0.45, 0.75],
+            Jump | Roll => [0.25, 0.60, 0.35],
+            Ability1 | Ability2 | Ability3 | Ability4 | Ability5 => [0.55, 0.30, 0.70],
+            Interact | Mount | Respawn => [0.85, 0.70, 0.20],
+            SwimUp | SwimDown => [0.20, 0.55, 0.80],
+            Menu | Bag | Map | Skills | Crafting | Social | Chat | Edit => [0.25, 0.25, 0.30],
+            Glide | Sneak | Wield | Lantern => [0.35, 0.35, 0.40],
+        }
+    }
+}
+
+/// Position / size / opacity of one button (persisted).
+#[derive(Clone, Copy, Debug, PartialEq, Serialize, Deserialize)]
+pub struct ButtonLayout {
