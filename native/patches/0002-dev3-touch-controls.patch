+/// Stick finger position for a stick vector (right, forward) of magnitude m
+/// (accounts for the dead-zone, so the game receives exactly `v`).
+fn stick_pos(gs: &GlobalState, aspect: f32, v: (f32, f32)) -> (f32, f32) {
+    let s = &gs.settings.touch;
+    let m = (v.0 * v.0 + v.1 * v.1).sqrt();
+    if m < 1e-4 {
+        return STICK_BASE;
+    }
+    let dz = s.stick_deadzone;
+    let raw = (m * (1.0 - dz) + dz).min(1.0) / m;
+    (
+        STICK_BASE.0 + v.0 * raw * s.stick_radius / aspect,
+        STICK_BASE.1 - v.1 * raw * s.stick_radius,
+    )
+}
