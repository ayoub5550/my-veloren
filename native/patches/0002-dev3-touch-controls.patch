+fn expect_path() -> Option<PathBuf> { DATA_DIR.get().map(|d| d.join("layout_expect")) }
+
+fn yaw_delta(a: f32, b: f32) -> f32 {
+    let mut d = (b - a) % std::f32::consts::TAU;
+    if d > std::f32::consts::PI {
+        d -= std::f32::consts::TAU;
+    } else if d < -std::f32::consts::PI {
+        d += std::f32::consts::TAU;
+    }
+    d
+}
+
+fn hspeed(p: &Probe) -> f32 { (p.vel[0] * p.vel[0] + p.vel[1] * p.vel[1]).sqrt() }
+
+fn check(name: &'static str, p: &Probe, rec: &mut Rec, gs: &GlobalState) -> (bool, String) {
+    match name {
+        "haptics" => {
+            vibrate(40);
+            (true, "self-test pulse sent via JNI (see 'jni:' errors if any)".into())
+        },
+        "multitouch" => {
+            let moved = ((p.pos[0] - rec.base.pos[0]).powi(2)
+                + (p.pos[1] - rec.base.pos[1]).powi(2))
+            .sqrt();
+            let dyaw = yaw_delta(rec.base.cam_yaw, p.cam_yaw);
+            (
+                moved > 1.5 && dyaw.abs() > 0.15 && rec.attack && rec.max_fingers >= 3,
+                format!(
+                    "moved={moved:.1}m cam_yaw_delta={dyaw:.2}rad attack_seen={} \
+                     max_fingers={} states={:?}",
+                    rec.attack, rec.max_fingers, rec.states
+                ),
+            )
+        },
+        "analog_slow" => {
+            rec.slow = avg(&rec.speeds);
+            (rec.slow > 0.2, format!("light tilt (0.35) speed={:.2} m/s", rec.slow))
+        },
+        "analog_fast" => {
+            let fast = avg(&rec.speeds);
+            (
+                rec.slow > 0.2 && fast > rec.slow * 1.3,
+                format!("light={:.2} m/s full={fast:.2} m/s", rec.slow),
+            )
+        },
+        "pinch_zoom" => {
+            let d = p.cam_dist - rec.base.cam_dist;
+            (d < -0.3, format!("camera distance {:.2} -> {:.2}", rec.base.cam_dist, p.cam_dist))
+        },
+        "buttons" => (true, format!("no crash; character states seen {:?}", rec.states)),
+        "glide" => (
+            rec.glide_wield || rec.gliding,
+            format!("glider_wielded={} gliding={}", rec.glide_wield, rec.gliding),
+        ),
+        "bag_open" => (
+            p.bag_open && !p.ctx.game_input,
+            format!("bag={} game_input={}", p.bag_open, p.ctx.game_input),
+        ),
+        "bag_closed" => (
+            !p.bag_open && p.ctx.game_input,
+            format!("bag={} game_input={}", p.bag_open, p.ctx.game_input),
+        ),
+        "map_open" => (
+            p.map_open && !p.ctx.game_input,
+            format!("map={} game_input={}", p.map_open, p.ctx.game_input),
+        ),
+        "map_closed" => (
+            !p.map_open && p.ctx.game_input,
+            format!("map={} game_input={}", p.map_open, p.ctx.game_input),
+        ),
+        "game_input_back" => (p.ctx.game_input, format!("game_input={}", p.ctx.game_input)),
+        "layout_saved" => {
+            let j = gs.settings.touch.layout(Ctl::Jump);
+            let on_disk = read_settings_touch(gs);
+            let disk_j = on_disk.as_ref().map(|t| t.layout(Ctl::Jump));
+            let ok = disk_j == Some(j)
+                && (j.x - 0.70).abs() < 0.03
+                && (j.y - 0.22).abs() < 0.03
+                && j.size > 0.09
+                && j.alpha < 1.0;
+            if let Some(path) = expect_path() {
+                let _ = std::fs::write(path, format!("{} {} {} {}", j.x, j.y, j.size, j.alpha));
+            }
+            (ok, format!("jump={j:?} on_disk={disk_j:?}"))
+        },
+        "layout_restored" => {
+            let j = gs.settings.touch.layout(Ctl::Jump);
+            let expect: Option<Vec<f32>> = expect_path()
+                .and_then(|p| std::fs::read_to_string(p).ok())
+                .map(|s| s.split_whitespace().filter_map(|v| v.parse().ok()).collect());
+            let ok = expect.as_ref().is_some_and(|e| {
+                e.len() == 4
+                    && (e[0] - j.x).abs() < 1e-4
+                    && (e[1] - j.y).abs() < 1e-4
+                    && (e[2] - j.size).abs() < 1e-4
+                    && (e[3] - j.alpha).abs() < 1e-4
+            });
+            (ok, format!("loaded jump={j:?} expected={expect:?}"))
+        },
+        "layout_reset" => {
+            let ok = gs.settings.touch.buttons == touch::default_layout()
+                && read_settings_touch(gs).is_some_and(|t| t.buttons == touch::default_layout());
+            (ok, format!("jump={:?}", gs.settings.touch.layout(Ctl::Jump)))
+        },
+        _ => (false, "unknown check".into()),
+    }
+}
+
+fn read_settings_touch(gs: &GlobalState) -> Option<touch::TouchSettings> {
+    let s = std::fs::read_to_string(gs.config_dir.join("settings.ron")).ok()?;
+    let v: crate::settings::Settings = ron::from_str(&s).ok()?;
+    Some(v.touch)
+}
