+/// `settings.ron` → `touch: (...)` (3.8).
+#[derive(Clone, Debug, PartialEq, Serialize, Deserialize)]
+#[serde(default)]
+pub struct TouchSettings {
+    /// Draw and use the on-screen controls (Android always uses touch).
+    pub enabled: bool,
+    /// Global opacity of the overlay (0.1..=1).
+    pub opacity: f32,
+    /// Camera drag sensitivity multiplier.
+    pub camera_sensitivity: f32,
+    /// Camera drag smoothing, 0 = raw, 0.9 = very smooth.
+    pub camera_smoothing: f32,
+    /// Pinch zoom speed multiplier.
+    pub zoom_sensitivity: f32,
+    /// Virtual stick radius (fraction of window height).
+    pub stick_radius: f32,
+    /// Dead-zone as a fraction of the stick radius.
+    pub stick_deadzone: f32,
+    /// Vibrate on hits taken / dealt.
+    pub haptics: bool,
+    pub buttons: Vec<ButtonLayout>,
+}
+
+impl Default for TouchSettings {
+    fn default() -> Self {
+        Self {
+            enabled: true,
+            opacity: 0.6,
+            camera_sensitivity: 1.0,
+            camera_smoothing: 0.35,
+            zoom_sensitivity: 1.0,
+            stick_radius: 0.13,
+            stick_deadzone: 0.15,
+            haptics: true,
+            buttons: default_layout(),
+        }
+    }
+}
+
+impl TouchSettings {
+    /// Layout of `ctl`, falling back to the default for buttons missing in an
+    /// older settings file.
+    pub fn layout(&self, ctl: Ctl) -> ButtonLayout {
+        self.buttons
+            .iter()
+            .find(|b| b.ctl == ctl)
+            .copied()
+            .or_else(|| default_layout().into_iter().find(|b| b.ctl == ctl))
+            .expect("every Ctl has a default layout")
+    }
+
+    fn layout_mut(&mut self, ctl: Ctl) -> &mut ButtonLayout {
+        if !self.buttons.iter().any(|b| b.ctl == ctl) {
+            let d = self.layout(ctl);
+            self.buttons.push(d);
+        }
+        self.buttons.iter_mut().find(|b| b.ctl == ctl).unwrap()
+    }
+
+    pub fn reset_layout(&mut self) {
+        let fresh = TouchSettings::default();
+        self.buttons = fresh.buttons;
+        self.opacity = fresh.opacity;
+    }
+}
+
+/// What the player can currently do; published by the session every tick.
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Context {
+    pub in_session: bool,
+    /// The game owns the input (cursor grabbed, no HUD window open).
+    pub game_input: bool,
+    pub can_interact: bool,
+    pub can_mount: bool,
+    pub riding: bool,
+    pub in_liquid: bool,
+    pub dead: bool,
+}
+
+impl Context {
+    pub fn visible(&self, ctl: Ctl) -> bool {
+        if !self.in_session {
+            return false;
+        }
+        match ctl.group() {
+            Group::MenuBar => ctl != Ctl::Edit || self.game_input,
+            Group::Game => self.game_input && !self.dead,
+            Group::Contextual => match ctl {
+                Ctl::Respawn => self.dead,
+                Ctl::Interact => self.game_input && !self.dead && self.can_interact,
+                Ctl::Mount => self.game_input && !self.dead && (self.can_mount || self.riding),
+                Ctl::SwimUp | Ctl::SwimDown => self.game_input && !self.dead && self.in_liquid,
+                _ => false,
+            },
+        }
+    }
+}
+
+// ---------------------------------------------------------------- outputs ---
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Phase {
+    Started,
+    Moved,
+    Ended,
+    Cancelled,
+}
+
+/// Actions produced by the touch layer, mapped to voxygen events by the host.
+#[derive(Clone, Copy, Debug, PartialEq)]
+pub enum Out {
+    Press(Ctl),
+    Release(Ctl),
+    /// Analog movement, x = right, y = forward, magnitude 0..=1 (3.2).
+    Move(f32, f32),
+    /// Camera pan in "cursor pixels" (already scaled by sensitivity).
+    Pan(f32, f32),
+    /// Camera zoom delta (negative = closer), same unit as mouse wheel events.
+    Zoom(f32),
+    /// Mouse emulation (menus / open windows), physical pixels.
+    MouseMove(f64, f64),
+    MouseDown(f64, f64),
+    MouseUp(f64, f64),
+    /// Persist settings (layout editor "Done").
+    Save,
+}
+
+/// Edit-mode toolbar buttons (3.8).
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum Tool {
+    Smaller,
+    Bigger,
+    Fainter,
+    Stronger,
+    Reset,
+    Done,
+}
+
+impl Tool {
+    pub const ALL: [Tool; 6] = [
+        Tool::Smaller,
+        Tool::Bigger,
+        Tool::Fainter,
+        Tool::Stronger,
+        Tool::Reset,
+        Tool::Done,
+    ];
+
+    pub fn label(self) -> &'static str {
+        match self {
+            Tool::Smaller => "Size -",
+            Tool::Bigger => "Size +",
+            Tool::Fainter => "Alpha -",
+            Tool::Stronger => "Alpha +",
+            Tool::Reset => "Reset",
+            Tool::Done => "Done",
+        }
+    }
+
+    /// Center (fractions) and radius (fraction of height).
+    pub fn place(self) -> (f32, f32, f32) {
+        let i = Tool::ALL.iter().position(|t| *t == self).unwrap() as f32;
+        (0.30 + i * 0.08, 0.20, 0.05)
+    }
+}
+
+// ----------------------------------------------------------------- layer ---
+
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Finger {
+    Mouse,
+    Button(Ctl),
+    Stick { ox: f64, oy: f64 },
+    Camera { lx: f64, ly: f64 },
+    /// Second finger of a pinch on the camera area.
+    Pinch { lx: f64, ly: f64 },
+    EditDrag { ctl: Ctl, lx: f64, ly: f64 },
+    Ignored,
+}
+
+/// One drawable element, in window fractions.
+#[derive(Clone, Debug, PartialEq)]
+pub struct Prim {
+    pub x: f32,
+    pub y: f32,
+    /// Radius as a fraction of the window height; 0 = text only.
+    pub r: f32,
+    pub rgba: [f32; 4],
+    pub label: Option<&'static str>,
+    pub text_rgba: [f32; 4],
+}
+
+#[derive(Default)]
+pub struct TouchLayer {
+    fingers: Vec<(u64, Finger)>,
+    /// Current stick vector (x right, y forward).
+    stick: (f32, f32),
+    /// Camera pan waiting to be released by the smoother.
+    pan_pending: (f32, f32),
+    pinch_dist: Option<f64>,
+    pub edit: bool,
+    pub selected: Option<Ctl>,
+    last_ctx: Context,
+    /// Counters for logs / tests.
+    pub stats: Stats,
+}
+
+#[derive(Clone, Copy, Debug, Default, PartialEq)]
+pub struct Stats {
+    pub presses: u32,
+    pub pans: u32,
+    pub zooms: u32,
+    pub stick_moves: u32,
+    pub max_fingers: u32,
+}
+
+/// Pixel scale for camera pans: the dev2 value (0.6 at 1080 px height).
+const PAN_BASE: f64 = 0.6 * 1080.0;
+/// Pinch: zoom units per screen height of finger distance change.
+const ZOOM_PER_HEIGHT: f64 = 40.0;
+/// Extra touch radius around buttons (fingers are fat).
+const HIT_SLOP: f32 = 1.15;
+/// Left part of the screen that starts the virtual stick.
+const STICK_ZONE: f32 = 0.45;
+
+fn dist_h(ax: f32, ay: f32, bx: f32, by: f32, aspect: f32) -> f32 {
+    (((ax - bx) * aspect).powi(2) + (ay - by).powi(2)).sqrt()
+}
+
+impl TouchLayer {
+    pub fn finger_count(&self) -> usize { self.fingers.len() }
+
+    pub fn stick(&self) -> (f32, f32) { self.stick }
+
+    fn finger(&self, id: u64) -> Option<Finger> {
+        self.fingers.iter().find(|(f, _)| *f == id).map(|(_, k)| *k)
+    }
+
+    fn set_finger(&mut self, id: u64, k: Finger) {
+        if let Some(e) = self.fingers.iter_mut().find(|(f, _)| *f == id) {
+            e.1 = k;
+        } else {
+            self.fingers.push((id, k));
+            self.stats.max_fingers = self.stats.max_fingers.max(self.fingers.len() as u32);
+        }
+    }
+
+    fn remove_finger(&mut self, id: u64) -> Option<Finger> {
+        let i = self.fingers.iter().position(|(f, _)| *f == id)?;
+        Some(self.fingers.remove(i).1)
+    }
+
+    /// Topmost visible button under (fx, fy).
+    fn hit(
+        &self,
+        fx: f32,
+        fy: f32,
+        aspect: f32,
+        ctx: &Context,
+        s: &TouchSettings,
+        all: bool,
+    ) -> Option<Ctl> {
+        Ctl::ALL
+            .iter()
+            .rev()
+            .copied()
+            .filter(|c| all || ctx.visible(*c))
+            .filter(|c| !(all && *c == Ctl::Edit))
+            .map(|c| (c, s.layout(c)))
+            .filter(|(_, b)| dist_h(fx, fy, b.x, b.y, aspect) <= b.size * HIT_SLOP)
+            .min_by(|a, b| {
+                let da = dist_h(fx, fy, a.1.x, a.1.y, aspect) / a.1.size;
+                let db = dist_h(fx, fy, b.1.x, b.1.y, aspect) / b.1.size;
+                da.partial_cmp(&db).unwrap_or(std::cmp::Ordering::Equal)
+            })
+            .map(|(c, _)| c)
+    }
+
+    fn hit_tool(fx: f32, fy: f32, aspect: f32) -> Option<Tool> {
+        Tool::ALL.iter().copied().find(|t| {
+            let (x, y, r) = t.place();
+            dist_h(fx, fy, x, y, aspect) <= r * HIT_SLOP
+        })
+    }
+
+    /// Release everything that is held (window opened, edit mode, state change).
+    pub fn release_all(&mut self, out: &mut Vec<Out>) {
+        for (_, f) in self.fingers.drain(..) {
+            if let Finger::Button(c) = f {
+                out.push(Out::Release(c));
+            }
+        }
+        if self.stick != (0.0, 0.0) {
+            self.stick = (0.0, 0.0);
+            out.push(Out::Move(0.0, 0.0));
+        }
+        self.pinch_dist = None;
+        self.pan_pending = (0.0, 0.0);
+    }
+
+    /// A mode change (session entered/left, window opened/closed) drops all
+    /// held inputs so nothing gets stuck. Called per touch and per frame.
+    pub fn sync_context(&mut self, ctx: &Context) -> Vec<Out> {
+        let mut out = Vec::new();
+        if ctx.in_session != self.last_ctx.in_session
+            || ctx.game_input != self.last_ctx.game_input
+        {
+            self.release_all(&mut out);
+            if !ctx.game_input {
+                self.edit = false;
+                self.selected = None;
+            }
+        }
+        self.last_ctx = *ctx;
+        out
+    }
+
+    /// Feed one touch event. `w`/`h` = window size in physical pixels.
+    #[allow(clippy::too_many_arguments)]
+    pub fn on_touch(
+        &mut self,
+        id: u64,
+        phase: Phase,
+        x: f64,
+        y: f64,
+        w: f64,
+        h: f64,
+        ctx: &Context,
+        s: &mut TouchSettings,
+    ) -> Vec<Out> {
+        let mut out = Vec::new();
+        let (w, h) = (w.max(1.0), h.max(1.0));
+        set_window_height(h);
+        let aspect = (w / h) as f32;
+        let (fx, fy) = ((x / w) as f32, (y / h) as f32);
+
+        out.extend(self.sync_context(ctx));
+
+        // ---- menus / open windows: one finger = mouse, menu bar still works --
+        if !ctx.in_session || !ctx.game_input {
+            match phase {
+                Phase::Started => {
+                    if let Some(c) = self
+                        .hit(fx, fy, aspect, ctx, s, false)
+                        .filter(|c| c.group() == Group::MenuBar)
+                    {
+                        self.set_finger(id, Finger::Button(c));
+                        self.stats.presses += 1;
+                        out.push(Out::Press(c));
+                    } else if !self.fingers.iter().any(|(_, f)| *f == Finger::Mouse) {
+                        self.set_finger(id, Finger::Mouse);
+                        out.push(Out::MouseMove(x, y));
+                        out.push(Out::MouseDown(x, y));
+                    } else {
+                        self.set_finger(id, Finger::Ignored);
+                    }
+                },
+                Phase::Moved => {
+                    if self.finger(id) == Some(Finger::Mouse) {
+                        out.push(Out::MouseMove(x, y));
+                    }
+                },
+                Phase::Ended | Phase::Cancelled => match self.remove_finger(id) {
+                    Some(Finger::Mouse) => {
+                        out.push(Out::MouseMove(x, y));
+                        out.push(Out::MouseUp(x, y));
+                    },
+                    Some(Finger::Button(c)) => out.push(Out::Release(c)),
+                    _ => {},
+                },
+            }
+            return out;
+        }
+
+        // ---- layout editor (3.8) ---------------------------------------------
+        if self.edit {
+            match phase {
+                Phase::Started => {
+                    if let Some(t) = Self::hit_tool(fx, fy, aspect) {
+                        self.apply_tool(t, s, &mut out);
+                        self.set_finger(id, Finger::Ignored);
+                    } else if let Some(c) = self.hit(fx, fy, aspect, ctx, s, true) {
+                        self.selected = Some(c);
+                        self.set_finger(id, Finger::EditDrag { ctl: c, lx: x, ly: y });
+                    } else {
+                        self.set_finger(id, Finger::Ignored);
+                    }
+                },
+                Phase::Moved => {
+                    if let Some(Finger::EditDrag { ctl, lx, ly }) = self.finger(id) {
+                        let b = s.layout_mut(ctl);
+                        b.x = (b.x + ((x - lx) / w) as f32).clamp(0.02, 0.98);
+                        b.y = (b.y + ((y - ly) / h) as f32).clamp(0.03, 0.97);
+                        self.set_finger(id, Finger::EditDrag { ctl, lx: x, ly: y });
+                    }
+                },
+                Phase::Ended | Phase::Cancelled => {
+                    self.remove_finger(id);
+                },
+            }
+            return out;
+        }
+
+        // ---- gameplay (3.2 - 3.5, 3.9) -----------------------------------------
+        match phase {
+            Phase::Started => {
+                if self.finger(id).is_some() {
+                    return out;
+                }
+                if let Some(c) = self.hit(fx, fy, aspect, ctx, s, false) {
+                    if c == Ctl::Edit {
+                        self.release_all(&mut out);
+                        self.edit = true;
+                        self.selected = None;
+                        self.set_finger(id, Finger::Ignored);
+                    } else {
+                        self.set_finger(id, Finger::Button(c));
+                        self.stats.presses += 1;
+                        out.push(Out::Press(c));
+                    }
+                } else if fx < STICK_ZONE
+                    && !self
+                        .fingers
+                        .iter()
+                        .any(|(_, f)| matches!(f, Finger::Stick { .. }))
+                {
+                    self.set_finger(id, Finger::Stick { ox: x, oy: y });
+                } else if !self
+                    .fingers
+                    .iter()
+                    .any(|(_, f)| matches!(f, Finger::Camera { .. }))
+                {
+                    self.set_finger(id, Finger::Camera { lx: x, ly: y });
+                } else if !self
+                    .fingers
+                    .iter()
+                    .any(|(_, f)| matches!(f, Finger::Pinch { .. }))
+                {
+                    self.set_finger(id, Finger::Pinch { lx: x, ly: y });
+                    self.pinch_dist = self.pinch_distance();
+                } else {
+                    self.set_finger(id, Finger::Ignored);
+                }
+            },
+            Phase::Moved => match self.finger(id) {
+                Some(Finger::Stick { ox, oy }) => {
+                    let r = (s.stick_radius.max(0.02) as f64) * h;
+                    let (mut vx, mut vy) = (((x - ox) / r) as f32, (-(y - oy) / r) as f32);
+                    let m = (vx * vx + vy * vy).sqrt();
+                    if m > 1.0 {
+                        vx /= m;
+                        vy /= m;
+                    }
+                    let m = m.min(1.0);
+                    let dz = s.stick_deadzone.clamp(0.0, 0.9);
+                    let (vx, vy) = if m <= dz {
+                        (0.0, 0.0)
+                    } else {
+                        let k = (m - dz) / (1.0 - dz) / m;
+                        (vx * k, vy * k)
+                    };
+                    if (vx - self.stick.0).abs() > 0.01 || (vy - self.stick.1).abs() > 0.01 {
+                        self.stick = (vx, vy);
+                        self.stats.stick_moves += 1;
+                        out.push(Out::Move(vx, vy));
+                    }
+                },
+                Some(Finger::Camera { lx, ly }) => {
+                    self.set_finger(id, Finger::Camera { lx: x, ly: y });
+                    if self.pinch_dist.is_some() {
+                        self.pinch(s, &mut out);
+                    } else {
+                        let k = PAN_BASE / h * s.camera_sensitivity as f64;
+                        self.pan_pending.0 += ((x - lx) * k) as f32;
+                        self.pan_pending.1 += ((y - ly) * k) as f32;
+                    }
+                },
+                Some(Finger::Pinch { .. }) => {
+                    self.set_finger(id, Finger::Pinch { lx: x, ly: y });
+                    self.pinch(s, &mut out);
+                },
+                // Button fingers never leak into the camera (3.9).
+                _ => {},
+            },
+            Phase::Ended | Phase::Cancelled => match self.remove_finger(id) {
+                Some(Finger::Button(c)) => out.push(Out::Release(c)),
+                Some(Finger::Stick { .. }) => {
+                    self.stick = (0.0, 0.0);
+                    out.push(Out::Move(0.0, 0.0));
+                },
+                Some(Finger::Camera { .. }) => {
+                    self.pinch_dist = None;
+                    // The pinch partner keeps steering the camera.
+                    if let Some(e) = self
+                        .fingers
+                        .iter_mut()
+                        .find(|(_, f)| matches!(f, Finger::Pinch { .. }))
+                        && let Finger::Pinch { lx, ly } = e.1
+                    {
+                        e.1 = Finger::Camera { lx, ly };
+                    }
+                },
+                Some(Finger::Pinch { .. }) => self.pinch_dist = None,
+                _ => {},
+            },
+        }
+        out
+    }
+
+    fn pinch_distance(&self) -> Option<f64> {
+        let cam = self.fingers.iter().find_map(|(_, f)| match f {
+            Finger::Camera { lx, ly } => Some((*lx, *ly)),
+            _ => None,
+        })?;
+        let pin = self.fingers.iter().find_map(|(_, f)| match f {
+            Finger::Pinch { lx, ly } => Some((*lx, *ly)),
+            _ => None,
+        })?;
+        Some(((cam.0 - pin.0).powi(2) + (cam.1 - pin.1).powi(2)).sqrt())
+    }
+
+    fn pinch(&mut self, s: &TouchSettings, out: &mut Vec<Out>) {
+        let (Some(prev), Some(now)) = (self.pinch_dist, self.pinch_distance()) else {
+            return;
+        };
+        let h = self.last_h();
+        let d = (now - prev) / h;
+        if d.abs() > 0.002 {
+            // Fingers apart (d > 0) = zoom in = negative zoom delta.
+            out.push(Out::Zoom(
+                (-d * ZOOM_PER_HEIGHT * s.zoom_sensitivity as f64) as f32,
+            ));
+            self.stats.zooms += 1;
+            self.pinch_dist = Some(now);
+        }
+    }
+
+    fn last_h(&self) -> f64 { LAST_H.with(|h| *h.borrow()).max(1.0) }
+
+    fn apply_tool(&mut self, t: Tool, s: &mut TouchSettings, out: &mut Vec<Out>) {
+        match t {
+            Tool::Smaller | Tool::Bigger | Tool::Fainter | Tool::Stronger => {
+                if let Some(c) = self.selected {
+                    let b = s.layout_mut(c);
+                    match t {
+                        Tool::Smaller => b.size = (b.size * 0.9).clamp(MIN_SIZE, MAX_SIZE),
+                        Tool::Bigger => b.size = (b.size * 1.1).clamp(MIN_SIZE, MAX_SIZE),
+                        Tool::Fainter => b.alpha = (b.alpha - 0.15).clamp(MIN_ALPHA, 1.0),
+                        _ => b.alpha = (b.alpha + 0.15).clamp(MIN_ALPHA, 1.0),
+                    }
+                } else {
+                    // No button selected: change the global overlay opacity.
+                    match t {
+                        Tool::Fainter => s.opacity = (s.opacity - 0.1).clamp(0.1, 1.0),
+                        Tool::Stronger => s.opacity = (s.opacity + 0.1).clamp(0.1, 1.0),
+                        _ => {},
+                    }
+                }
+            },
+            Tool::Reset => {
+                s.reset_layout();
+                self.selected = None;
+            },
+            Tool::Done => {
+                self.edit = false;
+                self.selected = None;
+                out.push(Out::Save);
+            },
+        }
+    }
+
+    /// Per-frame update: releases smoothed camera motion (3.3).
+    pub fn on_frame(&mut self, s: &TouchSettings) -> Vec<Out> {
+        let (px, py) = self.pan_pending;
+        if px.abs() < 0.01 && py.abs() < 0.01 {
+            self.pan_pending = (0.0, 0.0);
+            return Vec::new();
+        }
+        let keep = s.camera_smoothing.clamp(0.0, 0.9);
+        let (ex, ey) = (px * (1.0 - keep), py * (1.0 - keep));
+        self.pan_pending = (px - ex, py - ey);
+        self.stats.pans += 1;
+        vec![Out::Pan(ex, ey)]
+    }
+
+    /// Everything to draw this frame.
+    pub fn primitives(&self, ctx: &Context, s: &TouchSettings, aspect: f32) -> Vec<Prim> {
+        let mut p = Vec::new();
+        if !ctx.in_session || !s.enabled {
+            return p;
+        }
+        let ga = s.opacity.clamp(0.1, 1.0);
+        let held: Vec<Ctl> = self
+            .fingers
+            .iter()
+            .filter_map(|(_, f)| match f {
+                Finger::Button(c) => Some(*c),
+                _ => None,
+            })
+            .collect();
+
+        // Virtual stick (3.2): base + knob where the finger is.
+        if ctx.game_input && !ctx.dead && !self.edit {
+            let r = s.stick_radius;
+            let stick = self.fingers.iter().find_map(|(_, f)| match f {
+                Finger::Stick { ox, oy } => Some((*ox, *oy)),
+                _ => None,
+            });
+            let h = self.last_h();
+            let w = h * aspect as f64;
+            let (bx, by, a) = match stick {
+                Some((ox, oy)) => ((ox / w) as f32, (oy / h) as f32, 1.0),
+                None => (0.20, 0.72, 0.45),
+            };
+            p.push(Prim {
+                x: bx,
+                y: by,
+                r,
+                rgba: [0.1, 0.1, 0.12, 0.35 * ga * a],
+                label: None,
+                text_rgba: [0.0; 4],
+            });
+            let (kx, ky) = (
+                bx + self.stick.0 * r / aspect,
+                by - self.stick.1 * r,
+            );
+            p.push(Prim {
+                x: kx,
+                y: ky,
+                r: r * 0.42,
+                rgba: [0.85, 0.85, 0.9, 0.55 * ga * a],
+                label: None,
+                text_rgba: [0.0; 4],
+            });
+        }
+
+        for c in Ctl::ALL {
+            let shown = if self.edit {
+                c != Ctl::Edit
+            } else {
+                ctx.visible(c)
+            };
+            if !shown {
+                continue;
+            }
+            let b = s.layout(c);
+            let pressed = held.contains(&c);
+            let selected = self.edit && self.selected == Some(c);
+            let a = (ga * b.alpha).clamp(0.05, 1.0);
+            let t = c.tint();
+            // Border
+            p.push(Prim {
+                x: b.x,
+                y: b.y,
+                r: b.size,
+                rgba: if selected {
+                    [1.0, 0.85, 0.2, 0.95]
+                } else {
+                    [0.05, 0.05, 0.05, 0.55 * a]
+                },
+                label: None,
+                text_rgba: [0.0; 4],
+            });
+            // Face
+            let k = if pressed { 1.35 } else { 1.0 };
+            let face_a = if self.edit && c.group() == Group::Contextual {
+                0.5 * a
+            } else if pressed {
+                (0.95 * a).max(0.7)
+            } else {
+                0.7 * a
+            };
+            p.push(Prim {
+                x: b.x,
+                y: b.y,
+                r: b.size * 0.88,
+                rgba: [
+                    (t[0] * k).min(1.0),
+                    (t[1] * k).min(1.0),
+                    (t[2] * k).min(1.0),
+                    face_a,
+                ],
+                label: Some(c.label(ctx)),
+                text_rgba: [1.0, 1.0, 1.0, (a * 1.4).clamp(0.5, 1.0)],
+            });
+        }
+
+        if self.edit {
+            p.push(Prim {
+                x: 0.5,
+                y: 0.30,
+                r: 0.0,
+                rgba: [0.0; 4],
+                label: Some(if self.selected.is_some() {
+                    "Drag to move - Size/Alpha change the selected button"
+                } else {
+                    "Edit layout: drag a button, or tap one to select it"
+                }),
+                text_rgba: [1.0, 0.9, 0.4, 1.0],
+            });
+            for t in Tool::ALL {
+                let (x, y, r) = t.place();
+                p.push(Prim {
+                    x,
+                    y,
+                    r,
+                    rgba: [0.05, 0.05, 0.05, 0.85],
+                    label: None,
+                    text_rgba: [0.0; 4],
+                });
+                p.push(Prim {
+                    x,
+                    y,
+                    r: r * 0.88,
+                    rgba: if t == Tool::Done {
+                        [0.2, 0.6, 0.3, 0.95]
+                    } else if t == Tool::Reset {
+                        [0.7, 0.25, 0.2, 0.95]
+                    } else {
+                        [0.3, 0.3, 0.38, 0.95]
+                    },
+                    label: Some(t.label()),
+                    text_rgba: [1.0, 1.0, 1.0, 1.0],
+                });
+            }
+        }
+        p
+    }
+}
+
+thread_local! {
+    static LAST_H: std::cell::RefCell<f64> = const { std::cell::RefCell::new(1080.0) };
+}
+
+/// Remember the window height (used by pinch/stick drawing helpers).
+pub fn set_window_height(h: f64) { LAST_H.with(|c| *c.borrow_mut() = h.max(1.0)); }
+
+// --------------------------------------------------------------- globals ---
+
+/// The single touch layer (UI thread).
+pub static LAYER: Mutex<Option<TouchLayer>> = Mutex::new(None);
+static CONTEXT: Mutex<Context> = Mutex::new(Context {
+    in_session: false,
+    game_input: false,
+    can_interact: false,
+    can_mount: false,
+    riding: false,
+    in_liquid: false,
+    dead: false,
+});
+static HAPTICS: Mutex<VecDeque<u32>> = Mutex::new(VecDeque::new());
+
+/// Whether the touch overlay is active on this platform.
+pub fn active() -> bool { cfg!(target_os = "android") }
+
+pub fn with_layer<R>(f: impl FnOnce(&mut TouchLayer) -> R) -> R {
+    let mut g = LAYER.lock().unwrap_or_else(|e| e.into_inner());
+    f(g.get_or_insert_with(TouchLayer::default))
+}
+
+pub fn set_context(c: Context) { *CONTEXT.lock().unwrap_or_else(|e| e.into_inner()) = c; }
+
+pub fn context() -> Context { *CONTEXT.lock().unwrap_or_else(|e| e.into_inner()) }
+
+/// Ask for a vibration pulse (3.10); drained by the platform layer.
+pub fn request_haptic(ms: u32) {
+    if active() {
+        let mut q = HAPTICS.lock().unwrap_or_else(|e| e.into_inner());
+        if q.len() < 8 {
+            q.push_back(ms);
+        }
+    }
+}
+
+pub fn take_haptics() -> Vec<u32> {
+    HAPTICS
+        .lock()
+        .unwrap_or_else(|e| e.into_inner())
+        .drain(..)
+        .collect()
+}
+
+/// Keyboard hints on touch devices name the on-screen button instead of a key
+/// (3.10), e.g. "Press [Use] to talk".
+pub fn hint_label_for(ctl: Option<Ctl>) -> Option<&'static str> {
+    if !active() {
+        return None;
+    }
+    ctl.map(|c| c.label(&context()))
+}
