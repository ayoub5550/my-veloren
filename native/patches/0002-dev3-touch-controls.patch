+// -------------------------------------------------------------------- JNI ---
+
+enum JniCall {
+    Vibrate(u32),
+    FinishLoop,
+}
+
+static JNI_TX: Mutex<Option<mpsc::Sender<JniCall>>> = Mutex::new(None);
+
+/// One permanently attached thread performs all Java calls, so the render
+/// thread never blocks on JNI.
+fn start_jni_thread() {
+    let (tx, rx) = mpsc::channel::<JniCall>();
+    *JNI_TX.lock().unwrap() = Some(tx);
+    let _ = std::thread::Builder::new()
+        .name("veloren-jni".into())
+        .spawn(move || {
+            let app = app();
+            // SAFETY: pointers come from android-activity and stay valid for the
+            // lifetime of the process.
+            let vm = match unsafe { jni::JavaVM::from_raw(app.vm_as_ptr() as *mut _) } {
+                Ok(vm) => vm,
+                Err(e) => return aerror!("jni: no JavaVM: {e}"),
+            };
+            let mut env = match vm.attach_current_thread_permanently() {
+                Ok(env) => env,
+                Err(e) => return aerror!("jni: attach failed: {e}"),
+            };
+            let activity =
+                unsafe { jni::objects::JObject::from_raw(app.activity_as_ptr() as jni::sys::jobject) };
+            ainfo!("jni: ready");
+            for call in rx {
+                let r = match call {
+                    JniCall::Vibrate(ms) => env
+                        .call_method(&activity, "vibrate", "(I)V", &[jni::objects::JValue::Int(
+                            ms as i32,
+                        )])
+                        .map(|_| ()),
+                    JniCall::FinishLoop => env.call_method(&activity, "finishLoop", "()V", &[]).map(|_| ()),
+                };
+                if let Err(e) = r {
+                    let _ = env.exception_describe();
+                    let _ = env.exception_clear();
+                    aerror!("jni: call failed: {e}");
+                }
+            }
+        });
+}
+
+fn jni_send(c: JniCall) {
+    if let Some(tx) = JNI_TX.lock().unwrap().as_ref() {
+        let _ = tx.send(c);
+    }
+}
+
+static HAPTIC_COUNT: Mutex<u32> = Mutex::new(0);
+
+fn vibrate(ms: u32) {
+    *HAPTIC_COUNT.lock().unwrap() += 1;
+    jni_send(JniCall::Vibrate(ms));
+}
