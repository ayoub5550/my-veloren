+                ainfo!("VEL-STEP non-NPC window opened -> tap 'Menu' to close (#{})", s.closes);
+                p.fingers.insert(TAP_ID, (x, y));
+                touches.push((TAP_ID, Phase::Started, x, y));
+                s.tap_at = Some(now);
+            } else if pr.ctx.dead {
+                // killed on the way (wild animals near villages): use the contextual
+                // Respawn button, then keep seeking from the campfire
+                for id in [STICK_ID, CAM_ID, JUMP_ID] {
+                    if let Some((x, y)) = p.fingers.remove(&id) {
+                        touches.push((id, Phase::Ended, x, y));
+                    }
+                }
+                s.jump_at = None;
+                s.detour = None;
+                s.anchor = None;
+                if s.respawns < 3 {
+                    let (x, y) = center(Ctl::Respawn, gs);
+                    s.respawns += 1;
+                    ainfo!("VEL-STEP died during NPC seek -> tap contextual 'Respawn' (#{})", s.respawns);
+                    p.fingers.insert(TAP_ID, (x, y));
+                    touches.push((TAP_ID, Phase::Started, x, y));
+                    s.tap_at = Some(now);
+                }
+            } else if pr.ctx.can_interact
+                && s.taps < 6
+                && pr.npc_dist.is_some_and(|d| d <= 3.5)
+            {
+                if let Some((x, y)) = p.fingers.remove(&STICK_ID) {
+                    touches.push((STICK_ID, Phase::Ended, x, y));
+                }
+                let (x, y) = center(Ctl::Interact, gs);
+                ainfo!("VEL-STEP context button 'Use' visible -> tap (npc_dist={:?})", pr.npc_dist);
+                p.fingers.insert(TAP_ID, (x, y));
+                touches.push((TAP_ID, Phase::Started, x, y));
+                s.taps += 1;
+                s.tap_at = Some(now);
+            } else if let (Some(v), Some(d)) = (pr.npc_stick, pr.npc_dist) {
+                // turn the camera towards the villager, walk when roughly facing it
+                if !p.fingers.contains_key(&CAM_ID) {
+                    p.fingers.insert(CAM_ID, (0.5, 0.22));
+                    touches.push((CAM_ID, Phase::Started, 0.5, 0.22));
+                }
+                let (cx, cy) = p.fingers[&CAM_ID];
+                let turn = v[0].clamp(-1.0, 1.0) * 0.01;
+                let nx = if (0.46..=0.9).contains(&(cx + turn)) { cx + turn } else { 0.5 };
+                if nx == 0.5 && cx != 0.5 {
+                    touches.push((CAM_ID, Phase::Ended, cx, cy));
+                    touches.push((CAM_ID, Phase::Started, nx, cy));
+                } else {
+                    touches.push((CAM_ID, Phase::Moved, nx, cy));
+                }
+                p.fingers.insert(CAM_ID, (nx, cy));
+                // stuck on terrain (wall, fence, steep step)? jump + strafe around it
+                let moved = s.anchor.map_or(true, |(a, _)| {
+                    let (dx, dy) = (pr.pos[0] - a[0], pr.pos[1] - a[1]);
+                    dx * dx + dy * dy > 0.8 * 0.8
+                });
+                if moved {
+                    s.anchor = Some((pr.pos, now));
+                } else if d > 2.0
+                    && s.detour.is_none()
+                    && s.anchor.is_some_and(|(_, at)| now.duration_since(at).as_secs_f32() > 4.0)
+                {
+                    s.detours += 1;
+                    // same side three times with growing length (3/5/7 s), then
+                    // the other side: alternating every time just oscillates in
+                    // front of the same wall (r8q run 1: 20 detours, no progress)
+                    let k = s.detours - 1;
+                    let side = if (k / 3) % 2 == 0 { 1.0 } else { -1.0 };
+                    let secs = 3 + 2 * (k % 3) as u64;
+                    s.detour = Some((side, now + Duration::from_secs(secs)));
+                    s.anchor = Some((pr.pos, now));
+                    let (jx, jy) = center(Ctl::Jump, gs);
+                    if !p.fingers.contains_key(&JUMP_ID) {
+                        p.fingers.insert(JUMP_ID, (jx, jy));
+                        touches.push((JUMP_ID, Phase::Started, jx, jy));
+                        s.jump_at = Some(now);
+                    }
+                    ainfo!(
+                        "VEL-STEP stuck at {:?} npc_dist={d:.1} -> jump + detour {} (#{})",
+                        pr.pos,
+                        if side > 0.0 { "right" } else { "left" },
+                        s.detours
+                    );
+                }
+                if s.jump_at.is_some_and(|at| now.duration_since(at).as_secs_f32() > 0.5) {
+                    if let Some((x, y)) = p.fingers.remove(&JUMP_ID) {
+                        touches.push((JUMP_ID, Phase::Ended, x, y));
+                    }
+                    s.jump_at = None;
+                }
+                if s.detour.is_some_and(|(_, until)| now >= until) {
+                    s.detour = None;
+                }
+                let walk = if d <= 2.0 {
+                    (0.0, 0.0)
+                } else if let Some((side, _)) = s.detour {
+                    // perpendicular to the target direction, slightly forward
+                    let (px, py) = (v[1] * side, -v[0] * side);
+                    let (wx, wy) = (px + 0.3 * v[0], py + 0.3 * v[1]);
+                    let m = (wx * wx + wy * wy).sqrt().max(1e-4);
+                    (wx / m, wy / m)
+                } else {
+                    (v[0], v[1])
+                };
+                let (sx, sy) = stick_pos(gs, aspect, walk);
+                if !p.fingers.contains_key(&STICK_ID) {
+                    p.fingers.insert(STICK_ID, STICK_BASE);
+                    touches.push((STICK_ID, Phase::Started, STICK_BASE.0, STICK_BASE.1));
+                }
+                p.fingers.insert(STICK_ID, (sx, sy));
+                touches.push((STICK_ID, Phase::Moved, sx, sy));
+            }
+            if finished {
+                if pr.dialogue_open || pr.trade_open {
+                    // close the dialogue with the menu-bar "Menu" (Escape) button
+                    let mut q = Vec::new();
+                    tap_at(&mut q, center(Ctl::Menu, gs));
+                    p.inject = q;
+                }
+                for id in [STICK_ID, CAM_ID, TAP_ID, JUMP_ID] {
+                    if let Some((x, y)) = p.fingers.remove(&id) {
+                        touches.push((id, Phase::Ended, x, y));
+                    }
+                }
+                p.seek = None;
+            }
+            finished
+        },
+        Act::Finish => {
+            let pass = p.results.iter().filter(|r| r.1).count();
+            let fail: Vec<_> = p.results.iter().filter(|r| !r.1).map(|r| r.0.clone()).collect();
+            ainfo!(
+                "VEL-SCENARIO {} DONE pass={} fail={} failed={:?} haptics={}",
+                p.scenario,
+                pass,
+                fail.len(),
+                fail,
+                *HAPTIC_COUNT.lock().unwrap()
+            );
+            p.finished = true;
+            jni_send(JniCall::FinishLoop);
+            let _ = std::thread::Builder::new().spawn(|| {
+                std::thread::sleep(Duration::from_secs(3));
+                ainfo!("android: game loop scenario finished, exiting process");
+                // _exit, not exit(): running C atexit/static destructors while the
+                // render thread still owns the EGL/Vulkan context aborts in
+                // libEGL_emulation (`pthread_mutex_lock called on a destroyed mutex`).
+                unsafe { libc::_exit(0) };
+            });
+            true
+        },
+    };
+    if done {
+        p.queue.pop_front();
+        for a in std::mem::take(&mut p.inject).into_iter().rev() {
+            p.queue.push_front(a);
         }
+        p.act_start = now;
+        p.act_frames = 0;
+        p.act_from = None;
+    }
+    drop(g);
+    for (id, ph, x, y) in touches {
+        handle_touch(
+            id,
+            ph,
+            x as f64 * w,
+            y as f64 * h,
+            state_name,
+            gs,
+            out,
+        );
     }
 }
