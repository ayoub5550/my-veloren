diff --git a/voxygen/src/hud/touch_overlay.rs b/voxygen/src/hud/touch_overlay.rs
new file mode 100644
index 000000000..643c53750
--- /dev/null
+++ b/voxygen/src/hud/touch_overlay.rs
@@ -0,0 +1,70 @@
+//! Draws the on-screen touch controls (my-veloren dev.3, 3.1) on top of the HUD.
+//! Layout and state come from `crate::touch`; this module only renders.
+use crate::ui::fonts::Fonts;
+use conrod_core::{
+    Color, Colorable, Positionable, UiCell, Widget,
+    widget::{self, Text},
+    widget_ids,
+};
+
+widget_ids! {
+    pub struct Ids {
+        circles[],
+        labels[],
+    }
+}
+
+pub fn draw(ids: &mut Ids, ui: &mut UiCell, fonts: &Fonts, settings: &crate::touch::TouchSettings) {
+    let (win_w, win_h) = (ui.win_w, ui.win_h);
+    if win_w <= 1.0 || win_h <= 1.0 {
+        return;
+    }
+    let aspect = (win_w / win_h) as f32;
+    let ctx = crate::touch::context();
+    let prims = crate::touch::with_layer(|l| l.primitives(&ctx, settings, aspect));
+    let n_circles = prims.iter().filter(|p| p.r > 0.0).count();
+    let n_labels = prims.iter().filter(|p| p.label.is_some()).count();
+    if ids.circles.len() < n_circles {
+        ids.circles.resize(n_circles, &mut ui.widget_id_generator());
+    }
+    if ids.labels.len() < n_labels {
+        ids.labels.resize(n_labels, &mut ui.widget_id_generator());
+    }
+    let window = ui.window;
+    let (mut ci, mut li) = (0, 0);
+    for p in prims {
+        let x = (p.x as f64 - 0.5) * win_w;
+        let y = (0.5 - p.y as f64) * win_h;
+        let r = p.r as f64 * win_h;
+        if p.r > 0.0 {
+            widget::Circle::fill(r)
+                .color(Color::Rgba(p.rgba[0], p.rgba[1], p.rgba[2], p.rgba[3]))
+                .x_y(x, y)
+                .graphics_for(window)
+                .set(ids.circles[ci], ui);
+            ci += 1;
+        }
+        if let Some(label) = p.label {
+            let len = label.chars().count().max(1) as f64;
+            let size = if r > 0.0 {
+                (r * 2.0 * 0.85 / (0.6 * len)).min(r * 0.62)
+            } else {
+                win_h * 0.035
+            }
+            .clamp(7.0, 64.0) as u32;
+            Text::new(label)
+                .font_id(fonts.cyri.conrod_id)
+                .font_size(size)
+                .color(Color::Rgba(
+                    p.text_rgba[0],
+                    p.text_rgba[1],
+                    p.text_rgba[2],
+                    p.text_rgba[3],
+                ))
+                .x_y(x, y)
+                .graphics_for(window)
+                .set(ids.labels[li], ui);
+            li += 1;
+        }
+    }
+}
