+pub const TEST_CHAR_NAME: &str = "أيوب";
+
+pub fn set_text_auto(t: &str) { *TEXT_AUTO.lock().unwrap() = Some(t.to_owned()); }
+
+static LAST_CHATS: Mutex<Vec<String>> = Mutex::new(Vec::new());
+
+/// Plain chat messages received by the client (scenario 7 checks its own).
+pub fn note_chat(t: &str) {
+    let mut v = LAST_CHATS.lock().unwrap();
+    v.push(t.to_owned());
+    if v.len() > 20 {
+        v.remove(0);
+    }
+}
+
+static CHAR_NAME: Mutex<Option<String>> = Mutex::new(None);
+
+pub fn note_char_name(n: &str) { *CHAR_NAME.lock().unwrap() = Some(n.to_owned()); }
+
+/// A check that happens outside the session autopilot (char selection).
+pub fn alog_check(name: &str, ok: bool, detail: &str) {
+    ainfo!("VEL-CHECK {name} {} {detail}", if ok { "PASS" } else { "FAIL" });
+}
