+// ------------------------------------------------------- text input (6.4) ---
+
+/// Where a text dialog result goes.
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+pub enum TextTarget {
+    /// The focused conrod text field in the HUD (chat, searches...).
+    Hud,
+    /// The character name in character creation (iced).
+    CharName,
+}
+
+static TEXT_PENDING: Mutex<Option<TextTarget>> = Mutex::new(None);
+static TEXT_RESULTS: Mutex<Vec<(TextTarget, Option<String>)>> = Mutex::new(Vec::new());
+/// Test Lab: text the next dialog types by itself.
+static TEXT_AUTO: Mutex<Option<String>> = Mutex::new(None);
+pub static TEXT_DIALOGS: AtomicU64 = AtomicU64::new(0);
+
+/// Open the system text dialog unless one is already open.
+pub fn request_text(target: TextTarget, title: &str, initial: &str) {
+    let mut p = TEXT_PENDING.lock().unwrap();
+    if p.is_some() {
+        return;
+    }
+    *p = Some(target);
+    TEXT_DIALOGS.fetch_add(1, Ordering::SeqCst);
+    let auto = TEXT_AUTO.lock().unwrap().take();
+    ainfo!("text: dialog for {target:?} (auto={})", auto.is_some());
+    jni_send(JniCall::TextInput {
+        title: title.to_owned(),
+        initial: initial.to_owned(),
+        auto,
+    });
+}
+
+/// Results for `target` (Some = OK with text, None = cancelled).
+pub fn take_text(target: TextTarget) -> Option<Option<String>> {
+    let mut r = TEXT_RESULTS.lock().unwrap();
+    let i = r.iter().position(|(t, _)| *t == target)?;
+    Some(r.remove(i).1)
+}
+
+pub fn text_dialog_open() -> bool { TEXT_PENDING.lock().unwrap().is_some() }
+
+/// `VelorenActivity.nativeText(String text, boolean ok)`, registered with
+/// RegisterNatives from the JNI thread (NativeActivity does not use
+/// System.loadLibrary, so JNI could not find it by name).
+extern "system" fn native_text(
+    mut env: jni::JNIEnv,
+    _this: jni::objects::JObject,
+    text: jni::objects::JString,
+    ok: jni::sys::jboolean,
+) {
+    let s: Option<String> = if ok != 0 && !text.is_null() {
+        env.get_string(&text).ok().map(|j| j.into())
+    } else {
+        None
+    };
+    let target = TEXT_PENDING.lock().unwrap().take().unwrap_or(TextTarget::Hud);
+    ainfo!(
+        "text: result for {target:?}: {}",
+        match &s {
+            Some(t) => format!("ok, {} chars", t.chars().count()),
+            None => "cancelled".into(),
+        }
+    );
+    TEXT_RESULTS.lock().unwrap().push((target, s));
+}
+
+/// Hand typed text to the UI that asked for it (HUD: conrod text + Enter;
+/// escape = unfocus on cancel). Character name is read by char selection.
+fn deliver_text(state_name: Option<&'static str>, gs: &mut GlobalState) {
+    if state_name != Some("Session") {
+        return;
+    }
+    if let Some(res) = take_text(TextTarget::Hud) {
+        match res {
+            Some(t) if !t.is_empty() => {
+                use conrod_core::{event::Input, input::{Button, Key as CKey}};
+                gs.window.send_event(VEvent::Ui(crate::ui::Event(Input::Text(t))));
+                gs.window.send_event(VEvent::Ui(crate::ui::Event(Input::Press(Button::Keyboard(
+                    CKey::Return,
+                )))));
+                gs.window.send_event(VEvent::Ui(crate::ui::Event(Input::Release(
+                    Button::Keyboard(CKey::Return),
+                ))));
+                // Upstream keeps the chat field focused after Enter (desktop
+                // users press Enter/Esc again), which on touch left every HUD
+                // button dead. Release the focus a few frames later, once the
+                // message has been sent.
+                UNFOCUS_IN.store(3, Ordering::SeqCst);
+            },
+            _ => {
+                gs.window.send_event(VEvent::InputUpdate(GameInput::Escape, true));
+                gs.window.send_event(VEvent::InputUpdate(GameInput::Escape, false));
+            },
+        }
+    }
+}
+
+static WAS_TYPING: AtomicBool = AtomicBool::new(false);
+/// Frames until the HUD text field is unfocused after a submitted dialog.
+static UNFOCUS_IN: std::sync::atomic::AtomicU32 = std::sync::atomic::AtomicU32::new(0);
+
+fn unfocus_after_send(state_name: Option<&'static str>, gs: &mut GlobalState) {
+    let n = UNFOCUS_IN.load(Ordering::SeqCst);
+    if n == 0 {
+        return;
+    }
+    UNFOCUS_IN.store(n - 1, Ordering::SeqCst);
+    if n == 1 && state_name == Some("Session") && touch::typing() {
+        ainfo!("text: chat sent, releasing the chat field");
+        gs.window.send_event(VEvent::InputUpdate(GameInput::Escape, true));
+        gs.window.send_event(VEvent::InputUpdate(GameInput::Escape, false));
+    }
+}
+
+/// Rising edge of "a HUD text field has the keyboard" opens the dialog.
+fn watch_typing(state_name: Option<&'static str>) {
+    let typing = state_name == Some("Session") && touch::typing();
+    if typing && !WAS_TYPING.load(Ordering::SeqCst) && !text_dialog_open() {
+        request_text(TextTarget::Hud, "Chat", "");
+    }
+    WAS_TYPING.store(typing, Ordering::SeqCst);
+}
+
+/// Test Lab: text typed by the next dialog / character name for scenario 8.
