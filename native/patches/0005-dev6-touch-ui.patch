+
+// ---------------------------------------------------------- UI scale (6.6) ---
+
+/// Marker in the config dir; bump to re-apply the automatic UI scale once.
+pub const UI_SCALE_VERSION: &str = "dev6-v1";
+
+/// UI pixels (physical) per Veloren UI unit for a screen density in dpi.
+///
+/// Veloren's HUD is laid out for >= 1280x720 UI units on a monitor. On a
+/// phone the default (`RelativeToWindow 1920x1080`) maps one UI unit to
+/// about one physical pixel, which is ~0.06 mm at 420 dpi: unreadable and
+/// too small to touch. 0.57 dp per UI unit gives a 1080 px tall phone
+/// ~720 UI units (the HUD's minimum design height) and keeps the physical
+/// size the same on denser screens.
+pub fn ui_scale_for_dpi(dpi: u32) -> f64 {
+    let density = dpi.max(120) as f64 / 160.0;
+    (0.57 * density).clamp(1.0, 2.5)
+}
+
+pub fn ui_scale_first_launch(
+    interface: &mut crate::settings::InterfaceSettings,
+    dpi: Option<u32>,
+    config_dir: &std::path::Path,
+) {
+    let path = config_dir.join("ui_scale_preset");
+    let marker = std::fs::read_to_string(&path).unwrap_or_default();
+    if marker.split_whitespace().next() == Some(UI_SCALE_VERSION) {
+        tracing::info!("mobile ui scale: keeping user setting ({})", marker.trim());
+        return;
+    }
+    let dpi = dpi.unwrap_or(420);
+    let scale = ui_scale_for_dpi(dpi);
+    interface.ui_scale = crate::ui::ScaleMode::Absolute(scale);
+    let _ = std::fs::write(&path, format!("{UI_SCALE_VERSION} dpi={dpi} scale={scale:.2}\n"));
+    tracing::info!("mobile ui scale: dpi={dpi} -> Absolute({scale:.2})");
+}
