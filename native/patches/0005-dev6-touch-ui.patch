+/// Monotonic seconds for the touch layer (long-press / double-tap).
+fn clock() -> f64 {
+    static T0: OnceLock<Instant> = OnceLock::new();
+    T0.get_or_init(Instant::now).elapsed().as_secs_f64()
 }
 
