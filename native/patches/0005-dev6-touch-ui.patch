+/// Combining marks (harakat etc.) are transparent for joining.
+fn transparent(c: char) -> bool {
+    matches!(c as u32, 0x0610..=0x061A | 0x064B..=0x065F | 0x0670 | 0x06D6..=0x06ED)
+}
+
+/// Joins to the following letter (dual-joining).
+fn joins_next(c: char) -> bool { c == TATWEEL || forms(c).is_some_and(|f| f.3 != 0 || f.4 != 0) }
+
+/// Joins to the previous letter (dual- or right-joining).
+fn joins_prev(c: char) -> bool { c == TATWEEL || forms(c).is_some_and(|f| f.2 != 0) }
+
+pub fn is_rtl(c: char) -> bool {
+    matches!(c as u32,
+        0x0590..=0x08FF | 0xFB1D..=0xFDFF | 0xFE70..=0xFEFF | 0x10800..=0x10FFF | 0x1E800..=0x1EFFF)
+}
+
+/// Arabic letters -> presentation forms (logical order is kept).
+pub fn shape_arabic(s: &str) -> String {
+    let chars: Vec<char> = s.chars().collect();
+    let mut out = String::with_capacity(s.len());
+    let prev_letter = |i: usize| chars[..i].iter().rev().find(|c| !transparent(**c)).copied();
+    let next_letter = |i: usize| chars[i + 1..].iter().find(|c| !transparent(**c)).copied();
+    let mut i = 0;
+    while i < chars.len() {
+        let c = chars[i];
+        let Some(f) = forms(c) else {
+            out.push(c);
+            i += 1;
+            continue;
+        };
+        let jp = prev_letter(i).is_some_and(joins_next) && joins_prev(c);
+        // Lam + alef ligature.
+        if c == LAM {
+            if let Some(j) = (i + 1..chars.len()).find(|j| !transparent(chars[*j])) {
+                if let Some(l) = LAM_ALEF.iter().find(|l| l.0 == chars[j] as u32) {
+                    let lig = if jp { l.2 } else { l.1 };
+                    out.push(char::from_u32(lig).unwrap_or(c));
+                    // keep marks that sat between lam and alef
+                    out.extend(chars[i + 1..j].iter());
+                    i = j + 1;
+                    continue;
+                }
+            }
+        }
+        let jn = joins_next(c) && next_letter(i).is_some_and(joins_prev);
+        let (iso, fin, ini, med) = (f.1, f.2, f.3, f.4);
+        let pick = match (jp, jn) {
+            (true, true) if med != 0 => med,
+            (true, _) if fin != 0 => fin,
+            (false, true) if ini != 0 => ini,
+            _ => iso,
+        };
+        out.push(char::from_u32(if pick != 0 { pick } else { c as u32 }).unwrap_or(c));
+        i += 1;
+    }
+    out
+}
+
+#[derive(Clone, Copy, PartialEq, Eq, Debug)]
+enum Class {
+    R,
+    L,
+    Num,
+    Neutral,
+}
+
+fn class(c: char) -> Class {
+    if is_rtl(c) && !c.is_ascii_digit() && !matches!(c as u32, 0x0660..=0x0669 | 0x06F0..=0x06F9) {
+        Class::R
+    } else if c.is_numeric() {
+        Class::Num
+    } else if c.is_alphabetic() {
+        Class::L
+    } else {
+        Class::Neutral
+    }
+}
+
+fn mirror(c: char) -> char {
+    match c {
+        '(' => ')',
+        ')' => '(',
+        '[' => ']',
+        ']' => '[',
+        '{' => '}',
+        '}' => '{',
+        '<' => '>',
+        '>' => '<',
+        '«' => '»',
+        '»' => '«',
+        c => c,
+    }
+}
+
+/// Reverse an RTL run; digit groups (with . , : inside) keep their order.
+fn reverse_rtl(run: &[char], out: &mut Vec<char>) {
+    let mut segs: Vec<(bool, Vec<char>)> = Vec::new();
+    for (k, &c) in run.iter().enumerate() {
+        let num = class(c) == Class::Num
+            || (matches!(c, '.' | ',' | ':' | '/')
+                && k > 0
+                && class(run[k - 1]) == Class::Num
+                && run.get(k + 1).is_some_and(|n| class(*n) == Class::Num));
+        match segs.last_mut() {
+            Some((n, v)) if *n == num => v.push(c),
+            _ => segs.push((num, vec![c])),
+        }
+    }
+    for (num, v) in segs.into_iter().rev() {
+        if num {
+            out.extend(v);
+        } else {
+            out.extend(v.into_iter().rev().map(mirror));
+        }
+    }
+}
+
+/// Visual order of one line (see module docs).
+pub fn visual_line(line: &str) -> Cow<'_, str> {
+    if !line.chars().any(is_rtl) {
+        return Cow::Borrowed(line);
+    }
+    let shaped = shape_arabic(line);
+    let chars: Vec<char> = shaped.chars().collect();
+    let cls: Vec<Class> = chars.iter().map(|c| class(*c)).collect();
+    let base_rtl = cls
+        .iter()
+        .find(|c| matches!(c, Class::R | Class::L))
+        .is_some_and(|c| *c == Class::R);
+    // Runs of the "other" direction: from its first strong char to its last
+    // strong char before the next strong char of the base direction.
+    let other = if base_rtl { Class::L } else { Class::R };
+    let base = if base_rtl { Class::R } else { Class::L };
+    let mut runs: Vec<(bool, std::ops::Range<usize>)> = Vec::new(); // (is_rtl, range)
+    let mut i = 0;
+    let n = chars.len();
+    while i < n {
+        let in_other = cls[i] == other;
+        if in_other {
+            let start = i;
+            let mut last = i;
+            let mut j = i + 1;
+            while j < n && cls[j] != base {
+                // numbers inside the run stay with it
+                if cls[j] == other || cls[j] == Class::Num {
+                    last = j;
+                }
+                j += 1;
+            }
+            runs.push((!base_rtl, start..last + 1));
+            i = last + 1;
+        } else {
+            let start = i;
+            let mut j = i + 1;
+            while j < n && cls[j] != other {
+                j += 1;
+            }
+            runs.push((base_rtl, start..j));
+            i = j;
+        }
+    }
+    let mut out: Vec<char> = Vec::with_capacity(n);
+    let emit = |rtl: bool, r: &std::ops::Range<usize>, out: &mut Vec<char>| {
+        if rtl {
+            reverse_rtl(&chars[r.clone()], out);
+        } else {
+            out.extend(&chars[r.clone()]);
+        }
+    };
+    if base_rtl {
+        for (rtl, r) in runs.iter().rev() {
+            emit(*rtl, r, &mut out);
+        }
+    } else {
+        for (rtl, r) in runs.iter() {
+            emit(*rtl, r, &mut out);
+        }
+    }
+    Cow::Owned(out.into_iter().collect())
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    fn cps(s: &str) -> Vec<u32> { s.chars().map(|c| c as u32).collect() }
+
+    #[test]
+    fn latin_is_untouched_and_borrowed() {
+        assert!(matches!(visual_line("Hello, world 42"), Cow::Borrowed(_)));
+    }
+
+    #[test]
+    fn salam_joins() {
+        // سلام: seen initial, lam-alef final ligature, meem isolated
+        assert_eq!(cps(&shape_arabic("سلام")), vec![0xFEB3, 0xFEFC, 0xFEE1]);
+        // visual order is reversed
+        assert_eq!(cps(&visual_line("سلام")), vec![0xFEE1, 0xFEFC, 0xFEB3]);
+    }
+
+    #[test]
+    fn marhaba_forms() {
+        // مرحبا: meem initial, reh final, hah initial, beh medial, alef final
+        assert_eq!(cps(&shape_arabic("مرحبا")), vec![0xFEE3, 0xFEAE, 0xFEA3, 0xFE92, 0xFE8E]);
+    }
+
+    #[test]
+    fn mixed_ltr_paragraph_keeps_name_first() {
+        let v = visual_line("[Ayoub] مرحبا");
+        assert!(v.starts_with("[Ayoub] "), "{v}");
+        assert_eq!(v.chars().skip(8).count(), 5);
+    }
+
+    #[test]
+    fn rtl_paragraph_with_number_and_latin() {
+        // "level 12 في Veloren" in an Arabic sentence: numbers keep order.
+        let v = visual_line("المستوى 12");
+        assert!(v.starts_with("12 "), "{v}");
+        let v = visual_line("مرحبا Veloren");
+        assert!(v.starts_with("Veloren "), "{v}");
+    }
+
+    #[test]
+    fn brackets_mirror_in_rtl() {
+        let v = visual_line("(نعم)");
+        assert_eq!(v.chars().next(), Some('('));
+        assert_eq!(v.chars().last(), Some(')'));
+    }
+}
