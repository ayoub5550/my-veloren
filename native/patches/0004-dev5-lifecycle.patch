+    #[cfg(target_os = "android")]
+    pub fn android_resume(&mut self) -> Result<Vec2<u32>, String> {
+        let surface = self
+            .android_instance
+            .create_surface(Arc::clone(&self.android_window))
+            .map_err(|e| format!("create_surface: {e}"))?;
+        self.surface = Some(surface);
+        let size = self.android_window.inner_size();
+        let dims = Vec2::new(size.width, size.height);
+        if dims.x != 0 && dims.y != 0 && dims != self.resolution {
+            self.on_resize(dims);
+        } else {
+            self.configure_surface();
+        }
+        Ok(dims)
+    }
+
+    /// my-veloren dev.5: true while there is no surface (app in background).
