+/// dev.5 (5.5): write a crash report that the Java side offers to share on the
+/// next launch (`files/userdata/crash/*.txt`). Returns the file path.
+pub fn write_crash_report(kind: &str, text: &str) -> Option<PathBuf> {
+    let dir = DATA_DIR.get()?.join("userdata").join("crash");
+    std::fs::create_dir_all(&dir).ok()?;
+    let ts = std::time::SystemTime::now()
+        .duration_since(std::time::UNIX_EPOCH)
+        .map(|d| d.as_secs())
+        .unwrap_or(0);
+    let path = dir.join(format!("{kind}-{ts}.txt"));
+    let body = format!(
+        "my-veloren crash report\nkind: {kind}\nunix_time: {ts}\nvoxygen: {}\n\n{text}\n",
+        env!("CARGO_PKG_VERSION")
+    );
+    std::fs::write(&path, body).ok()?;
+    Some(path)
+}
