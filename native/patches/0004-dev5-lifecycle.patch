+//! my-veloren dev.5: Android activity lifecycle (pause / resume / autosave).
+//!
+//! winit reports `Event::Suspended` when Android destroys the native window
+//! (Home, app switcher, screen off, another activity on top) and
+//! `Event::Resumed` when a new one exists. On suspend:
+//! * the wgpu surface is dropped while the window still exists, and frames are
+//!   skipped until resume (rendering into a destroyed window crashes);
+//! * audio is muted;
+//! * settings + profile are written, and the singleplayer server persists all
+//!   characters right away, then pauses (no world simulation in background).
+//!
+//! On resume, a new surface is created for the new window, the volume is
+//! restored and the server is unpaused if this module paused it.
+
+use std::sync::atomic::{AtomicBool, AtomicU32, AtomicU64, Ordering};
+
+use crate::GlobalState;
+
+static SUSPENDED: AtomicBool = AtomicBool::new(false);
+static SUSPENDS: AtomicU32 = AtomicU32::new(0);
+static RESUMES: AtomicU32 = AtomicU32::new(0);
+static RESUME_FAILS: AtomicU32 = AtomicU32::new(0);
+/// Frames actually drawn into a surface (skipped frames are not counted).
+static PRESENTED: AtomicU64 = AtomicU64::new(0);
+/// Whether this module paused the singleplayer server (so resume only
+/// unpauses what it paused, never a pause the player chose in the Esc menu).
+static WE_PAUSED: AtomicBool = AtomicBool::new(false);
+/// Observed while suspended (for the Test Lab check).
+static PAUSED_SEEN: AtomicBool = AtomicBool::new(false);
+
+pub fn is_suspended() -> bool { SUSPENDED.load(Ordering::SeqCst) }
+
+pub fn suspends() -> u32 { SUSPENDS.load(Ordering::SeqCst) }
+
+pub fn resumes() -> u32 { RESUMES.load(Ordering::SeqCst) }
+
+pub fn resume_fails() -> u32 { RESUME_FAILS.load(Ordering::SeqCst) }
+
+pub fn presented() -> u64 { PRESENTED.load(Ordering::Relaxed) }
+
+pub fn frame_presented() { PRESENTED.fetch_add(1, Ordering::Relaxed); }
+
+pub fn paused_seen() -> bool { PAUSED_SEEN.load(Ordering::SeqCst) }
+
+pub fn on_suspend(gs: &mut GlobalState) {
+    if SUSPENDED.swap(true, Ordering::SeqCst) {
+        return;
+    }
+    let n = SUSPENDS.fetch_add(1, Ordering::SeqCst) + 1;
+    gs.window.renderer_mut().android_suspend();
+    gs.audio.set_master_volume(0.0);
+    gs.settings.save_to_file_warn(&gs.config_dir);
+    gs.profile.save_to_file_warn(&gs.config_dir);
+    #[cfg(feature = "singleplayer")]
+    let server = if let Some(sp) = gs.singleplayer.as_running() {
+        crate::singleplayer::request_persistence();
+        let was_paused = sp.is_paused();
+        if !was_paused {
+            sp.pause(true);
+        }
+        WE_PAUSED.store(!was_paused, Ordering::SeqCst);
+        PAUSED_SEEN.store(sp.is_paused(), Ordering::SeqCst);
+        "persist requested + paused"
+    } else {
+        "no singleplayer server"
+    };
+    #[cfg(not(feature = "singleplayer"))]
+    let server = "no singleplayer";
+    crate::android::alog(
+        4,
+        &format!("VEL-LIFE suspend #{n}: surface dropped, audio muted, settings saved, {server}"),
+    );
+}
+
+pub fn on_resume(gs: &mut GlobalState) {
+    if !SUSPENDED.load(Ordering::SeqCst) {
+        return;
+    }
+    let n = RESUMES.load(Ordering::SeqCst) + 1;
+    match gs.window.renderer_mut().android_resume() {
+        Ok(dims) => {
+            SUSPENDED.store(false, Ordering::SeqCst);
+            RESUMES.store(n, Ordering::SeqCst);
+            let vol = gs.settings.audio.master_volume.get_checked();
+            gs.audio.set_master_volume(vol);
+            #[cfg(feature = "singleplayer")]
+            if WE_PAUSED.swap(false, Ordering::SeqCst) {
+                gs.unpause();
+            }
+            crate::android::alog(
+                4,
+                &format!("VEL-LIFE resume #{n}: new surface {}x{}, audio restored", dims.x, dims.y),
+            );
+        },
+        Err(e) => {
+            // Stay suspended; the next `Resumed` retries.
+            RESUME_FAILS.fetch_add(1, Ordering::SeqCst);
+            crate::android::alog(6, &format!("VEL-LIFE resume #{n} FAILED: {e}"));
+        },
+    }
+}
