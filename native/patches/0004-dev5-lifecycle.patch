diff --git a/voxygen/src/scene/terrain/occlusion.rs b/voxygen/src/scene/terrain/occlusion.rs
new file mode 100644
index 000000000..92ff2aab6
--- /dev/null
+++ b/voxygen/src/scene/terrain/occlusion.rs
@@ -0,0 +1,243 @@
+//! dev.5 (5.6): terrain occlusion culling for the camera passes.
+//!
+//! Veloren terrain chunks are full-height 32x32 columns, so the Minecraft PE
+//! "cave culling" (connectivity between 16^3 sections) does not map directly.
+//! Instead this is a CPU horizon test against a conservative ground model:
+//!
+//! * The mesh worker stores, for each 8x8 cell of a chunk, the *lowest* top
+//!   of natural terrain (rock/earth/grass/snow/sand) in that cell. Trees,
+//!   buildings, water and sprites never count as occluders.
+//! * Every frame, for each chunk in the frustum, a "cone" from the camera to
+//!   the chunk's top face is marched. At fraction `t` the cone's footprint is
+//!   a square of side `t * 32` around the centre ray; every ray from the
+//!   camera to any point of the chunk (at or below its top) passes through
+//!   that square no higher than `cam.z + t * (top - cam.z)`. If the ground in
+//!   the whole footprint is above that height, every such ray is underground
+//!   there and the chunk is hidden.
+//! * Shadows still use the frustum test only, so hidden hills keep casting
+//!   shadows into view.
+//!
+//! Known approximation: caves/overhangs are treated as solid (a ray through
+//! a tunnel that pierces a whole hill is not considered). The culling is
+//! disabled while the camera is at/below the ground of its own cell
+//! (underground, caves, under an overhang).
+
+use super::TerrainChunkData;
+use common::{
+    terrain::{BlockKind, TerrainChunk},
+    vol::ReadVol,
+};
+use hashbrown::HashMap;
+use std::sync::atomic::{AtomicBool, AtomicU32, Ordering};
+use vek::*;
+
+/// Cell size in blocks (a chunk is `CELLS` x `CELLS` cells).
+const CELL: i32 = 8;
+const CELLS: usize = 4;
+pub type Heights = [f32; CELLS * CELLS];
+
+/// Chunks closer than this (in chunks, Chebyshev) are never culled.
+const NEAR_CHUNKS: i32 = 2;
+/// Safety margin (blocks) subtracted from the ground model.
+const GROUND_MARGIN: f32 = 1.0;
+/// Sprites (grass, flowers, ...) are not part of the mesh z bounds.
+const SPRITE_MARGIN: f32 = 4.0;
+
+pub static OCCLUSION_CULLING: AtomicBool = AtomicBool::new(true);
+static TESTED: AtomicU32 = AtomicU32::new(0);
+static CULLED: AtomicU32 = AtomicU32::new(0);
+static MICROS: AtomicU32 = AtomicU32::new(0);
+static UNDERGROUND: AtomicBool = AtomicBool::new(false);
+
+/// Last frame: (chunks tested, chunks culled, cost in µs, skipped because the
+/// camera is underground).
+pub fn occlusion_stats() -> (u32, u32, u32, bool) {
+    (
+        TESTED.load(Ordering::Relaxed),
+        CULLED.load(Ordering::Relaxed),
+        MICROS.load(Ordering::Relaxed),
+        UNDERGROUND.load(Ordering::Relaxed),
+    )
+}
+
+fn is_occluder(kind: BlockKind) -> bool {
+    matches!(
+        kind,
+        BlockKind::Rock
+            | BlockKind::WeakRock
+            | BlockKind::GlowingRock
+            | BlockKind::GlowingWeakRock
+            | BlockKind::Grass
+            | BlockKind::Snow
+            | BlockKind::ArtSnow
+            | BlockKind::Earth
+            | BlockKind::Sand
+    )
+}
+
+/// Conservative ground height (world z of the top face) per 8x8 cell: the
+/// minimum over the cell's columns of the highest natural-terrain block.
+/// A cell with any column lacking terrain gets `-inf` (never occludes).
+pub fn ground_heights(chunk: &TerrainChunk) -> Heights {
+    let (min_z, max_z) = (chunk.get_min_z(), chunk.get_max_z());
+    let mut out = [f32::NEG_INFINITY; CELLS * CELLS];
+    for cy in 0..CELLS as i32 {
+        for cx in 0..CELLS as i32 {
+            let mut cell_min = f32::INFINITY;
+            'cell: for y in 0..CELL {
+                for x in 0..CELL {
+                    let (px, py) = (cx * CELL + x, cy * CELL + y);
+                    let mut z = max_z - 1;
+                    let mut top = None;
+                    while z >= min_z {
+                        if chunk
+                            .get(Vec3::new(px, py, z))
+                            .is_ok_and(|b| is_occluder(b.kind()))
+                        {
+                            top = Some(z);
+                            break;
+                        }
+                        z -= 1;
+                    }
+                    match top {
+                        Some(z) => cell_min = cell_min.min(z as f32 + 1.0),
+                        None => {
+                            cell_min = f32::NEG_INFINITY;
+                            break 'cell;
+                        },
+                    }
+                }
+            }
+            out[(cy as usize) * CELLS + cx as usize] = cell_min;
+        }
+    }
+    out
+}
+
+struct Grid {
+    heights: Vec<f32>,
+    side: i32,
+    /// World xy of cell (0, 0).
+    origin: Vec2<f32>,
+}
+
+impl Grid {
+    #[inline]
+    fn cell(&self, x: i32, y: i32) -> f32 {
+        if x < 0 || y < 0 || x >= self.side || y >= self.side {
+            f32::NEG_INFINITY
+        } else {
+            self.heights[(y * self.side + x) as usize]
+        }
+    }
+
+    #[inline]
+    fn to_cell(&self, p: f32, o: f32) -> i32 { ((p - o) / CELL as f32).floor() as i32 }
+
+    fn at(&self, p: Vec2<f32>) -> f32 {
+        self.cell(self.to_cell(p.x, self.origin.x), self.to_cell(p.y, self.origin.y))
+    }
+
+    /// Is the ground above `z` everywhere in the square `[c - hw, c + hw]`?
+    fn all_above(&self, c: Vec2<f32>, hw: f32, z: f32) -> bool {
+        let (x0, x1) = (
+            self.to_cell(c.x - hw, self.origin.x),
+            self.to_cell(c.x + hw, self.origin.x),
+        );
+        let (y0, y1) = (
+            self.to_cell(c.y - hw, self.origin.y),
+            self.to_cell(c.y + hw, self.origin.y),
+        );
+        for y in y0..=y1 {
+            for x in x0..=x1 {
+                if self.cell(x, y) - GROUND_MARGIN <= z {
+                    return false;
+                }
+            }
+        }
+        true
+    }
+}
+
+fn chunk_hidden(grid: &Grid, cam: Vec3<f32>, center: Vec2<f32>, top: f32, chunk_sz: f32) -> bool {
+    let d = center - Vec2::from(cam);
+    let len = d.magnitude();
+    if len < 1.0 {
+        return false;
+    }
+    let steps = (len / CELL as f32).ceil() as i32;
+    for i in 1..steps {
+        let t = i as f32 / steps as f32;
+        let p = Vec2::from(cam) + d * t;
+        let hw = t * chunk_sz * 0.5;
+        let ray_z = cam.z + t * (top - cam.z);
+        if grid.all_above(p, hw, ray_z) {
+            return true;
+        }
+    }
+    false
+}
+
+pub(super) fn cull(
+    chunks: &mut HashMap<Vec2<i32>, TerrainChunkData>,
+    cam: Vec3<f32>,
+    loaded_distance: f32,
+    chunk_sz: f32,
+) {
+    let start = std::time::Instant::now();
+    for c in chunks.values_mut() {
+        c.visible.occluded = false;
+    }
+    let (mut tested, mut culled) = (0u32, 0u32);
+    UNDERGROUND.store(false, Ordering::Relaxed);
+    if OCCLUSION_CULLING.load(Ordering::Relaxed) {
+        let csz = chunk_sz as i32;
+        let cam_chunk = Vec2::<f32>::from(cam).map(|e| (e / chunk_sz).floor() as i32);
+        let r = (loaded_distance / chunk_sz).ceil() as i32 + 1;
+        let side_chunks = 2 * r + 1;
+        let side = side_chunks * CELLS as i32;
+        let mut grid = Grid {
+            heights: vec![f32::NEG_INFINITY; (side * side) as usize],
+            side,
+            origin: ((cam_chunk - r) * csz).as_::<f32>(),
+        };
+        for (pos, c) in chunks.iter() {
+            let Some(h) = &c.occluder else { continue };
+            let d = *pos - cam_chunk + r;
+            if d.x < 0 || d.y < 0 || d.x >= side_chunks || d.y >= side_chunks {
+                continue;
+            }
+            for cy in 0..CELLS {
+                for cx in 0..CELLS {
+                    let gx = d.x as usize * CELLS + cx;
+                    let gy = d.y as usize * CELLS + cy;
+                    grid.heights[gy * side as usize + gx] = h[cy * CELLS + cx];
+                }
+            }
+        }
+
+        if cam.z < grid.at(Vec2::from(cam)) + 2.0 {
+            UNDERGROUND.store(true, Ordering::Relaxed);
+        } else {
+            for (pos, c) in chunks.iter_mut() {
+                if !c.visible.in_frustum {
+                    continue;
+                }
+                let rel = *pos - cam_chunk;
+                if rel.x.abs().max(rel.y.abs()) < NEAR_CHUNKS {
+                    continue;
+                }
+                tested += 1;
+                let top = c.z_bounds.1.max(c.sun_occluder_z_bounds.1) + SPRITE_MARGIN;
+                let center = pos.as_::<f32>() * chunk_sz + chunk_sz * 0.5;
+                if chunk_hidden(&grid, cam, center, top, chunk_sz) {
+                    c.visible.occluded = true;
+                    culled += 1;
+                }
+            }
+        }
+    }
+    TESTED.store(tested, Ordering::Relaxed);
+    CULLED.store(culled, Ordering::Relaxed);
+    MICROS.store(start.elapsed().as_micros() as u32, Ordering::Relaxed);
+}
