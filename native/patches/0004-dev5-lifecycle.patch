+/// Version of the asset tarball inside the APK (`assets/assets.version`).
+fn apk_asset_version(app: &AndroidApp) -> String {
+    let name = std::ffi::CString::new("assets.version").unwrap();
+    app.asset_manager()
+        .open(&name)
+        .and_then(|mut a| {
+            let mut s = String::new();
+            a.read_to_string(&mut s).ok().map(|_| s.trim().to_owned())
